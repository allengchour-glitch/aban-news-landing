        var tx=document.createElement('div');var b=document.createElement('b');b.textContent=p.title;var s=document.createElement('span');s.textContent=preis(p);tx.appendChild(b);tx.appendChild(s);a.appendChild(tx);wrap.appendChild(a);
      });
