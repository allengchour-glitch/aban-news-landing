    var t=thema(q);
    if(t){ask(q,t);return}
    var s=suchwort(q);
    msg(esc(q),'me');
    if(!s){verzoegert(function(){msg('Dazu brauche ich ein Stichwort. Such dir ein Thema aus oder schreib, was du suchst.','bot');setChips(basisChips())},300);return}
    suche(s);
