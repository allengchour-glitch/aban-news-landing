  function hideNudge(merken){nudge.hidden=true;if(merken){try{sessionStorage.setItem('luxas.n','1')}catch(e){}}}
  $('luxas-nudge-x').addEventListener('click',function(){hideNudge(true)});
  function nudgeZeigen(){
    try{if(sessionStorage.getItem('luxas.n')==='1')return}catch(e){}
    if(!panel.hidden||root.hasAttribute('data-hold'))return;
    nudge.hidden=false;try{sessionStorage.setItem('luxas.n','1')}catch(e){}
    setTimeout(function(){nudge.hidden=true},9000);
  }

  /* Der Knopf darf Cookie-Banner, Shopify-Banner und E-Mail-Popup nicht überdecken: solange eines sichtbar ist, bleibt er weg. */
  var HALT=['lx-cookie-banner','lx-pop','shopify-pc__banner'];
  function halten(){
    var h=false;HALT.forEach(function(i){var e=document.getElementById(i);if(e&&getComputedStyle(e).display!=='none'&&e.getClientRects().length)h=true});
    if(h)root.setAttribute('data-hold','');else root.removeAttribute('data-hold');
  }
  function zeigen(){
    root.hidden=false;halten();setInterval(halten,3000);
    HALT.forEach(function(i){var e=document.getElementById(i);if(e&&'MutationObserver' in window)new MutationObserver(halten).observe(e,{attributes:true,attributeFilter:['style','class','hidden']})});
    setTimeout(nudgeZeigen,9000);
  }
  /* Erst nach dem Laden und einer kurzen Ruhe einblenden (kein Einfluss auf die Ladezeit der Seite). */
  var spaet=function(){setTimeout(zeigen,2500)};
  if(document.readyState==='complete')spaet();else window.addEventListener('load',spaet);
})();
</script>
