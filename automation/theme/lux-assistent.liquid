  function kacheln(){
    var g=document.createElement('div');g.className='luxas-tiles';
    [['versand','Versand & Kosten','versand'],['lieferzeit','Lieferzeit','lieferzeit'],['tracking','Lieferstatus','tracking'],['rueckgabe','Rückgabe','rueckgabe'],['zahlung','Zahlung','zahlung'],['kontakt','Kontakt','kontakt'],['geschenk','Geschenke','*g'],['entdecken','Entdecken','*k'],['suchen','Produkt suchen','*s']].forEach(function(x){
