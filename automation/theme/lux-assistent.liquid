    if(/^(hallo|hi|hoi|hey|gruezi|grezi|servus|moin|guten (tag|morgen|abend)|hilfe|help)[ !.?]*$/.test(n)){msg(esc(q),'me');verzoegert(function(){msg('Hallo! Wobei kann ich helfen? Such dir ein Thema aus oder schreib dein Stichwort.','bot');setChips(basisChips())},300);return}
    if(/^(danke|merci|vielen dank|danke schon|super|perfekt|ok|okay)[ !.?]*$/.test(n)){msg(esc(q),'me');verzoegert(function(){msg('Sehr gerne! Wenn noch etwas offen ist – ich bin da. 🙂','bot');setChips(basisChips())},300);return}
