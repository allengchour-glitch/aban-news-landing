      b.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">'+ICON[x[0]]+'</svg>'+esc(x[1]);
      b.addEventListener('click',function(ev){var tast=ev.detail===0;
        if(x[2]==='*g')geschenk();else if(x[2]==='*k')entdecken();else if(x[2]==='*s')suchStart();else ask(NAMEN[x[2]],x[2],tast)});
