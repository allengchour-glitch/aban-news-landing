{%- comment -%}
  LuxeStyle Assistent v4 (21.10.2026, Betreiber: «smartbot auf shopify ist zu teuer — machst du es gratis und besser», dann «optisch viel besser
  und wie ein richtiger Top-Roboter, auch die Features und alles»). v4 = v3 + Befunde dreier unabhängiger Prüfer (Optik, Code, Fakten).
  Kostenlos, ohne App, ohne KI-Dienst, ohne Server: beantwortet Fragen zu Versand, Lieferzeit, Zoll, Rückgabe, Garantie, Zahlung,
  Sendungsverfolgung und Kontakt aus FESTEN Antworten, die den Shop-Richtlinien und Seiten entsprechen (kein Erfinden), führt durch einen
  Geschenkfinder, kennt die Kategorien und sucht Produkte über die Shopify-Suchvorschlags-Schnittstelle (/search/suggest.json, gleiche Domain).
  Verlauf nur im Tab (sessionStorage); Eingaben mit Mail-Adresse, Telefon-/Bestellnummer-Muster werden nie gesucht oder gespeichert (Namen und
  Adressen kann kein Muster erkennen — darum die Bitte «keine persönlichen Daten»); Suchbegriffe gehen wie bei der normalen Shop-Suche an die
  eigene Shopify-Domain. Zählt nur anonyme Ereignisnamen (Clarity, kein Text); der Inhalt des Fensters ist für Sitzungsaufzeichnungen maskiert.
  Nur deutsche Sprachversion, nicht im Warenkorb. Die Zahlen/Fristen der Antworten prüft automation/lux_assistent.py täglich gegen Richtlinien und Seiten.
  Rückbau: python3 automation/lux_assistent.py --zurueck --ja (entfernt Eintrag in sections UND order der footer-group.json, danach die Datei).
{%- endcomment -%}
{%- if request.locale.iso_code == 'de' and request.page_type != 'cart' -%}
<div id="luxas" data-state="idle" data-clarity-mask="True" hidden>
  <div class="luxas-nudge" id="luxas-nudge" role="status" hidden>
    <button type="button" class="luxas-nudge-x" id="luxas-nudge-x" aria-label="Hinweis schliessen">×</button>
    <span>Automatischer Assistent: Fragen zu Versand, Rückgabe oder Produkten?</span>
  </div>
  <button type="button" class="luxas-btn" id="luxas-open" aria-haspopup="dialog" aria-expanded="false" aria-controls="luxas-panel" aria-label="Hilfe – Shop-Assistent öffnen">
    <span class="luxas-btn-bot" id="luxas-btn-bot" aria-hidden="true"></span>
    <span class="luxas-btn-t" aria-hidden="true">Hilfe</span>
  </button>
  <section id="luxas-panel" class="luxas-panel" role="dialog" aria-labelledby="luxas-titel" hidden>
    <header class="luxas-head">
      <span class="luxas-head-bot" id="luxas-head-bot" aria-hidden="true"></span>
      <div class="luxas-head-t"><h2 id="luxas-titel">LuxeStyle Assistent</h2><small><i class="luxas-on" aria-hidden="true"></i>automatisch, keine Person</small></div>
      <button type="button" class="luxas-ico" id="luxas-reset" aria-label="Gespräch neu starten" title="Neu starten">↺</button>
      <button type="button" class="luxas-ico" id="luxas-close" aria-label="Schliessen">×</button>
    </header>
    <div class="luxas-log" id="luxas-log" role="log" aria-live="polite" tabindex="0"></div>
    <div class="luxas-chips" id="luxas-chips"></div>
    <form class="luxas-form" id="luxas-form" autocomplete="off">
      <input type="text" id="luxas-in" name="frage" maxlength="120" placeholder="Frage oder Stichwort …" aria-label="Deine Frage oder dein Suchwort" enterkeyhint="send">
      <button type="submit" aria-label="Senden"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg></button>
    </form>
    <p class="luxas-foot">Keine persönlichen Daten eingeben. Ohne Gewähr – massgebend: <a href="/policies/terms-of-service">AGB</a>, <a href="/policies/shipping-policy">Versand</a>, <a href="/policies/refund-policy">Rückgabe</a>.</p>
  </section>
</div>
{% raw %}
<style>
#luxas{--lg:#d4b896;--lgd:#b8935a;--ld:#2c2c2c;--lc:#faf7f2;--lb:#7a5a2c;position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:5;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:15px;line-height:1.45;color:var(--ld);transition:bottom .2s ease}
#luxas[hidden],#luxas [hidden]{display:none!important}
#luxas[data-hold]{display:none!important}
#luxas.luxas-up{bottom:calc(92px + env(safe-area-inset-bottom,0px))}
/* Roboter */
.luxas-robot{display:block;width:100%;height:100%;overflow:visible}
.luxas-robot .e-h,.luxas-robot .m-d{display:none}
.luxas-robot .e-n,.luxas-robot .luxas-led{transform-box:fill-box;transform-origin:center}
@media (prefers-reduced-motion:no-preference){
  .luxas-live .luxas-robot{animation:luxas-float 4.2s ease-in-out infinite}
  .luxas-live .e-n{animation:luxas-blink 5.5s infinite}
  .luxas-live .luxas-led{animation:luxas-led 2.2s ease-in-out infinite}
  #luxas[data-state="denkt"] .luxas-live .e-n{animation:luxas-scan 1.1s ease-in-out infinite}
  #luxas[data-state="denkt"] .luxas-live .luxas-led{animation:luxas-led .45s ease-in-out infinite}
  .luxas-m,.luxas-cards,.luxas-tiles,.luxas-wait{animation:luxas-pop .22s ease-out}
  .luxas-panel{animation:luxas-in .2s ease-out}
  .luxas-nudge{animation:luxas-pop .3s ease-out}
  .luxas-log{scroll-behavior:smooth}
  .luxas-wait i{animation:luxas-dot 1s infinite}
  .luxas-wait i:nth-child(2){animation-delay:.15s}.luxas-wait i:nth-child(3){animation-delay:.3s}
}
@media (hover:hover){
  .luxas-btn:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(0,0,0,.36),0 0 0 5px rgba(212,184,150,.28)}
  .luxas-btn:hover .luxas-robot{animation-duration:1.6s}
  .luxas-tile:hover{transform:translateY(-2px);border-color:var(--lgd);box-shadow:0 6px 14px rgba(0,0,0,.1)}
  .luxas-card:hover{transform:translateY(-1px);border-color:var(--lgd);box-shadow:0 6px 16px rgba(0,0,0,.1)}
  .luxas-chip:hover{background:#f3ebdd}
  .luxas-ico:hover{background:rgba(250,247,242,.12)}
}
@keyframes luxas-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
@keyframes luxas-blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}
@keyframes luxas-led{0%,100%{opacity:.55;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}
@keyframes luxas-scan{0%,100%{transform:translateX(-2.2px)}50%{transform:translateX(2.2px)}}
@keyframes luxas-pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes luxas-in{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
@keyframes luxas-dot{0%,80%,100%{transform:translateY(0);opacity:.45}40%{transform:translateY(-4px);opacity:1}}
#luxas[data-state="froh"] .luxas-live .e-n,#luxas[data-state="froh"] .luxas-live .m-n{display:none}
#luxas[data-state="froh"] .luxas-live .e-h{display:inline}
#luxas[data-state="denkt"] .luxas-live .m-n{display:none}
#luxas[data-state="denkt"] .luxas-live .m-d{display:inline}
/* Knopf */
.luxas-btn{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:58px;padding:0 20px 0 8px;border-radius:999px;border:1px solid var(--lg);background:linear-gradient(150deg,#3b3733 0%,#1f1d1b 100%);color:var(--lc);font-family:inherit;font-weight:600;font-size:15px;line-height:1;cursor:pointer;box-shadow:0 10px 28px rgba(0,0,0,.32),0 0 0 4px rgba(212,184,150,.2);transition:transform .15s ease,box-shadow .15s ease}
.luxas-btn-bot{width:44px;height:44px;flex:none}
.luxas-btn:focus-visible,.luxas-chip:focus-visible,.luxas-tile:focus-visible,.luxas-form button:focus-visible,.luxas-form input:focus-visible,.luxas-fb button:focus-visible,.luxas-log:focus-visible,#luxas a:focus-visible{outline:3px solid #8a6a35;outline-offset:2px}
.luxas-ico:focus-visible,.luxas-btn:focus-visible{outline-color:#f2c96b}
.luxas-log:focus-visible{outline-offset:-3px}
.luxas-nudge{position:absolute;right:4px;bottom:calc(100% + 12px);width:min(250px,calc(100vw - 40px));padding:11px 36px 11px 14px;border-radius:16px 16px 4px 16px;background:#fff;color:var(--ld);border:1px solid #e8dfd2;box-shadow:0 10px 28px rgba(0,0,0,.2);font-size:14px}
.luxas-nudge-x{position:absolute;top:-4px;right:-4px;min-width:44px;min-height:44px;border:0;background:transparent;color:#5a5a5a;font-size:20px;line-height:1;cursor:pointer}
/* Fenster */
.luxas-panel{position:fixed;right:14px;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:12;width:min(392px,calc(100vw - 28px));height:min(600px,calc(100vh - 200px));height:min(600px,calc(100dvh - 200px));display:flex;flex-direction:column;background:#f6f1e9;border:1px solid rgba(212,184,150,.55);border-radius:20px;box-shadow:0 18px 56px rgba(0,0,0,.32);overflow:hidden}
#luxas.luxas-up .luxas-panel{bottom:calc(162px + env(safe-area-inset-bottom,0px));height:min(600px,calc(100vh - 260px));height:min(600px,calc(100dvh - 260px))}
.luxas-head{display:flex;align-items:center;gap:10px;padding:11px 6px 11px 12px;background:linear-gradient(150deg,#3b3733 0%,#1f1d1b 100%);color:var(--lc);border-bottom:2px solid var(--lg)}
.luxas-head-bot{width:46px;height:46px;flex:none;border-radius:50%;background:rgba(250,247,242,.08);padding:3px;box-shadow:0 0 0 2px rgba(212,184,150,.55)}
.luxas-head-t{flex:1;min-width:0}
.luxas-head-t h2{display:block;margin:0;padding:0;font-family:inherit;font-size:15.5px;font-weight:700;line-height:1.3;letter-spacing:.1px;color:inherit;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.luxas-head-t small{display:flex;align-items:center;gap:6px;font-size:12px;opacity:.9;white-space:nowrap}
.luxas-on{width:8px;height:8px;border-radius:50%;background:var(--lgd);box-shadow:0 0 0 3px rgba(184,147,90,.3);flex:none}
.luxas-ico{min-width:44px;min-height:44px;border:0;background:transparent;color:inherit;font-size:26px;line-height:1;cursor:pointer;border-radius:12px}
#luxas-reset{font-size:22px}
/* Gespräch */
.luxas-log{flex:1;min-height:96px;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:10px;overscroll-behavior:contain}
.luxas-row{display:flex;align-items:flex-start;gap:8px}
.luxas-rme{justify-content:flex-end}
.luxas-ava{width:28px;height:28px;flex:none;border-radius:50%;background:var(--ld);padding:2px;box-shadow:0 0 0 1.5px rgba(212,184,150,.7)}
.luxas-m{max-width:calc(100% - 40px);padding:10px 13px;border-radius:16px;word-wrap:break-word;overflow-wrap:anywhere;box-shadow:0 1px 2px rgba(0,0,0,.06)}
.luxas-m:focus{outline:none}
.luxas-m a{color:var(--lb);font-weight:600;text-decoration:underline}
.luxas-li{display:block;padding-left:14px;text-indent:-14px;margin-top:4px}
.luxas-bot{background:#fff;border:1px solid #ebe3d6;border-bottom-left-radius:5px}
.luxas-me{background:linear-gradient(150deg,#e2c9a6,#d4b896);color:var(--ld);border-bottom-right-radius:5px;max-width:86%}
.luxas-wait{display:flex;gap:5px;padding:13px 15px}
.luxas-wait i{width:7px;height:7px;border-radius:50%;background:var(--lgd);opacity:.8}
.luxas-tiles{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1fr;gap:8px;align-self:stretch}
.luxas-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:62px;padding:8px 4px;border-radius:14px;border:1px solid #c9b99f;background:#fff;color:var(--ld);font-family:inherit;font-size:12.5px;font-weight:600;line-height:1.2;text-align:center;cursor:pointer;transition:transform .12s ease,border-color .12s ease,box-shadow .12s ease}
.luxas-tile svg{width:24px;height:24px;flex:none;stroke:var(--lb);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.luxas-cards{display:flex;flex-direction:column;gap:8px;align-self:stretch}
.luxas-card{display:flex;gap:11px;align-items:center;padding:8px;background:#fff;border:1px solid #ebe3d6;border-radius:14px;text-decoration:none!important;color:inherit!important;min-height:72px;transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease}
.luxas-card>div{min-width:0}
.luxas-card img{width:60px;height:60px;object-fit:cover;border-radius:10px;flex:none;background:#f1ece4}
.luxas-card b{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere;font-size:14px;font-weight:600;line-height:1.3}
.luxas-card span{display:inline-block;margin-top:2px;font-size:13.5px;color:var(--lb);font-weight:700}
.luxas-more{display:inline-flex;align-items:center;min-height:44px;align-self:flex-start;font-size:14px;color:var(--lb);font-weight:700;text-decoration:underline;padding:2px 4px}
.luxas-fb{display:flex;align-items:center;gap:6px;margin:-4px 0 0 36px;font-size:12px;color:#5a5a5a}
.luxas-fb button{min-width:44px;min-height:44px;border-radius:999px;border:1px solid #d9ccb8;background:#fff;font-size:15px;cursor:pointer}
/* Schnellantworten */
.luxas-chips{display:flex;flex-wrap:nowrap;gap:6px;padding:6px 12px 10px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.luxas-chips::-webkit-scrollbar{display:none}
.luxas-chips:empty{display:none}
.luxas-chip{flex:none;min-height:44px;padding:0 15px;border-radius:999px;border:1px solid #8a7350;background:#fff;color:var(--ld);font-family:inherit;font-weight:500;font-size:14px;line-height:1;cursor:pointer;white-space:nowrap;transition:background .12s ease}
.luxas-form{display:flex;gap:8px;padding:10px 12px 6px;border-top:1px solid #e8dfd2;background:#fff}
.luxas-form input{flex:1;min-width:0;min-height:48px;padding:0 14px;border:1px solid #9b8561;border-radius:24px;font-family:inherit;font-size:16px;line-height:1;background:#fff;color:var(--ld)}
.luxas-form button{width:48px;min-height:48px;border:0;border-radius:50%;background:linear-gradient(150deg,#3b3733,#1f1d1b);color:var(--lg);cursor:pointer;display:flex;align-items:center;justify-content:center}
.luxas-foot{margin:0;padding:0 14px calc(8px + env(safe-area-inset-bottom,0px));background:#fff;font-size:12px;line-height:1.35;color:#5a5a5a}
.luxas-foot a{color:var(--lb);text-decoration:underline}
@media (hover:hover){.luxas-chips{scrollbar-width:thin;scrollbar-color:#b9a07a transparent;padding-bottom:6px}.luxas-chips::-webkit-scrollbar{display:block;height:6px}.luxas-chips::-webkit-scrollbar-thumb{background:#b9a07a;border-radius:3px}}
@media (max-width:600px){.luxas-panel{right:8px;left:8px;width:auto;bottom:calc(78px + env(safe-area-inset-bottom,0px));border-radius:18px}}
@media (max-width:340px){.luxas-head-t small{display:none}}
/* niedrige Fenster (Querformat, 200 % Zoom): Fenster füllt die Höhe, der Knopf tritt zurück */
@media (max-height:520px){
  #luxas:has(.luxas-panel:not([hidden])){z-index:10}
  #luxas:has(.luxas-panel:not([hidden])) .luxas-btn{display:none}
  .luxas-panel,#luxas.luxas-up .luxas-panel{top:8px;bottom:calc(8px + env(safe-area-inset-bottom,0px));height:auto;max-height:none}
  .luxas-log{min-height:0}
  .luxas-foot{display:none}
  .luxas-chips{display:none}
  .luxas-head{padding:6px 6px 6px 12px}
  .luxas-head-bot{width:36px;height:36px}
}
</style>
<script>
(function(){
  'use strict';
  var root=document.getElementById('luxas'); if(!root) return;
  var $=function(i){return document.getElementById(i)};
  var btn=$('luxas-open'),panel=$('luxas-panel'),log=$('luxas-log'),chips=$('luxas-chips'),form=$('luxas-form'),inp=$('luxas-in'),nudge=$('luxas-nudge');
  var R=(window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/';
  var started=false,suchmodus=false,hist=[],stTimer=0,gen=0,ctl=null,botNr=0,nudgeGezeigt=false;
  var REDUCED=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches);
  var COARSE=!!(window.matchMedia&&matchMedia('(pointer:coarse)').matches);

  /* ---------- Roboter (Inline-SVG, je Instanz eigene Verlaufs-ID) ---------- */
  function bot(live){
    var g='luxg'+(++botNr);
    return '<span class="'+(live?'luxas-live':'')+'" style="display:block;width:100%;height:100%"><svg class="luxas-robot" viewBox="0 0 64 64" aria-hidden="true" focusable="false">'
    +'<defs><linearGradient id="'+g+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#46413c"/><stop offset="1" stop-color="#232120"/></linearGradient></defs>'
    +'<line x1="32" y1="5" x2="32" y2="14" stroke="#d4b896" stroke-width="3" stroke-linecap="round"/><circle class="luxas-led" cx="32" cy="4.5" r="3.4" fill="#f2c96b"/>'
    +'<rect x="2" y="27" width="8" height="14" rx="4" fill="#d4b896"/><rect x="54" y="27" width="8" height="14" rx="4" fill="#d4b896"/>'
    +'<rect x="8" y="13" width="48" height="41" rx="16" fill="url(#'+g+')"/><path d="M12 24c0-6 4-9 10-9h20c6 0 10 3 10 9" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="2" stroke-linecap="round"/>'
    +'<rect x="14" y="20" width="36" height="27" rx="11" fill="#faf7f2"/>'
    +'<g class="e-n"><rect x="22" y="27" width="6.5" height="11" rx="3.2" fill="#2c2c2c"/><rect x="35.5" y="27" width="6.5" height="11" rx="3.2" fill="#2c2c2c"/><circle cx="24.4" cy="30" r="1.3" fill="#fff"/><circle cx="37.9" cy="30" r="1.3" fill="#fff"/></g>'
    +'<g class="e-h"><path d="M21.5 36q3.7-8 7.4 0M35.1 36q3.7-8 7.4 0" fill="none" stroke="#2c2c2c" stroke-width="2.8" stroke-linecap="round"/></g>'
    +'<path class="m-n" d="M27 41.5q5 4.2 10 0" fill="none" stroke="#b8935a" stroke-width="2.4" stroke-linecap="round"/><path class="m-d" d="M29.5 42h5" fill="none" stroke="#b8935a" stroke-width="2.4" stroke-linecap="round"/>'
    +'<circle cx="18.5" cy="40" r="2.4" fill="#f0cfc0" opacity=".85"/><circle cx="45.5" cy="40" r="2.4" fill="#f0cfc0" opacity=".85"/>'
    +'<rect x="24" y="54" width="16" height="5" rx="2" fill="#d4b896"/></svg></span>';
  }
  $('luxas-btn-bot').innerHTML=bot(true);$('luxas-head-bot').innerHTML=bot(true);
  function state(s,ms){root.setAttribute('data-state',s);clearTimeout(stTimer);if(s!=='idle')stTimer=setTimeout(function(){root.setAttribute('data-state','idle')},ms||2200)}
  function trk(n){try{if(typeof window.clarity==='function')window.clarity('event',n)}catch(e){}}

  /* ---------- Wissen: feste Antworten nach den Shop-Richtlinien und Seiten (Stand 21.10.2026) ----------
     k = starke Stichwörter (3 Punkte), w = schwache (1 Punkt). Ein Thema wird bei mind. 3 Punkten beantwortet — oder bei 1–2 Punkten, wenn
     JEDES Inhaltswort der Eingabe zu diesem Thema gehört («Versand», «Zahlung», «Paket»). Sonst sucht der Assistent Produkte.
     Stichwort mit «$» am Ende = nur als ganzes Wort; Stichwort mit Leerzeichen = ganze Wortfolge; sonst Wortanfang (versandkosten → «Versandkosten»). */
  var L=function(h,t){return '<a href="'+h+'">'+t+'</a>'};
  var MAIL=L('mailto:info@luxestyle.ch','info@luxestyle.ch');
  var LI=function(t){return '<span class="luxas-li">• '+t+'</span>'};
  var T={
    versand:{k:['versandkosten','gratisversand','gratis versand','versandart','liefergebiet','liechtenstein','osterreich','oesterreich','porto$','ins ausland','lieferung ins ausland','liefert ihr','versendet ihr','versand kostet','kostet der versand','kostet versand','versandkostenfrei','ab wann gratis','ab wann kostenlos','nach deutschland','nach osterreich','nach oesterreich','nach frankreich','nach italien'],w:['versand','kostenlos','gratis','lieferung$','liefern','ausland','deutschland','schweiz$'],
      a:'Wir liefern in die <b>Schweiz</b> und nach <b>Liechtenstein</b>. In der Schweiz ist der Standardversand <b>ab CHF 50 nach Rabatt gratis</b>; darunter siehst du die Kosten im Warenkorb, bevor du bestellst. Liechtenstein: CHF 14.90 pro Bestellung. Andere Länder (z. B. EU oder USA) sind derzeit nicht möglich.<br>'+L(R+'pages/versand-lieferung','Versand &amp; Lieferung')+' · '+L(R+'policies/shipping-policy','Versandbedingungen'),
      c:['lieferzeit','zoll']},
    lieferzeit:{k:['lieferzeit','lieferdauer','lieferfrist','liefertermin','lieferdatum','wie lange dauert','wie lange braucht','wie lange liefert','wann kommt meine','wann kommt mein','wann kommt die','wann kommt das','wann bekomme ich','wann erhalte ich','ankunft'],w:['wie lange','wann kommt','dauert','dauer$','lieferung$','unterwegs','schnell','express'],
