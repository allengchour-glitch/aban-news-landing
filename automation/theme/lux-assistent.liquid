  function geschenk(){
    suchmodus=false;msg('Geschenkfinder','me');trk('assistent_geschenk');
    verzoegert(function(){
      msg('Gern! <b>Für wen</b> suchst du ein Geschenk?','bot');
      setChips(Object.keys(WEM).map(function(k){return {t:WEM[k].t,f:function(){geschenkBudget(k)}}}).concat([{t:'☰ Menü',f:menu}]));
    },300);
  }
  function geschenkBudget(k){
    msg(esc(WEM[k].t),'me');
    verzoegert(function(){
      msg('Und dein <b>Budget</b>?','bot');
      var l=Object.keys(BUD).map(function(b){return {t:BUD[b].t,f:function(){geschenkErgebnis(k,b)}}});
      l.push({t:'Egal',f:function(){geschenkErgebnis(k,'')}});l.push({t:'☰ Menü',f:menu});setChips(l);
    },300);
  }
  function geschenkErgebnis(k,b){
    msg(b?esc(BUD[b].t):'Egal','me');
    verzoegert(function(){
      var h=L(WEM[k].h,WEM[k].n);
      if(b)h+='<br>'+L(BUD[b].h,'Geschenkideen '+BUD[b].t);
      msg('Hier findest du passende Geschenke:<br>'+h+'<br>Das Budget gilt für alle Empfänger – auf der Seite kannst du nach Preis filtern. Die Lieferzeit steht bei jedem Artikel auf der Produktseite.','bot');
      setChips([{t:'Nochmal',f:geschenk},{t:'Produkt suchen',f:suchStart},{t:'☰ Menü',f:menu}]);
    },350);
  }
  function feedback(row){
    var f=document.createElement('div');f.className='luxas-fb';f.innerHTML='<span>Hilfreich?</span>';
    [['👍','ja'],['👎','nein']].forEach(function(x){var b=document.createElement('button');b.type='button';b.textContent=x[0];b.setAttribute('aria-label',x[1]==='ja'?'Ja, hilfreich':'Nein, nicht hilfreich');b.addEventListener('click',function(){
      trk('assistent_hilfreich_'+x[1]);f.innerHTML=x[1]==='ja'?'<span>Danke! 🙌</span>':'<span>Schade. Schreib uns gern: '+MAIL+'</span>';
    });f.appendChild(b)});
    row.parentNode.insertBefore(f,row.nextSibling);
  }
  function ask(frage,t,tast){
    suchmodus=false;msg(esc(frage),'me');trk('assistent_thema_'+t);
    verzoegert(function(){
      var row=msg(T[t].a,'bot');feedback(row);scrollen(row);
      if(tast){var m=row.querySelector('.luxas-m');if(m){m.tabIndex=-1;try{m.focus({preventScroll:true})}catch(e){}}}
      setChips(T[t].c.map(function(x){return {t:NAMEN[x],f:function(){ask(NAMEN[x],x)}}}).concat(basisChips().slice(0,2)));
    },420);
  }
  function preis(p){
    var lo=parseFloat(p.price_min!=null?p.price_min:p.price),hi=parseFloat(p.price_max!=null?p.price_max:p.price);
    if(!isFinite(lo))return '';
    return (isFinite(hi)&&hi>lo?'ab ':'')+'CHF '+lo.toFixed(2);
  }
  function sicherPfad(u){
    u=String(u||'');if(!/^\/(?![\/\\])/.test(u))return '';
    try{var x=new URL(u,location.origin);return x.origin===location.origin?x.pathname:''}catch(e){return ''}
  }
  function kontaktAntwort(vorspann){
    verzoegert(function(){msgFl(vorspann+'<br>'+T.kontakt.a,'bot');setChips(basisChips())},300);
  }
  function suche(q){
    trk('assistent_suche');
    var g=gen;if(ctl){try{ctl.abort()}catch(e){}}
    var wait=tippen();
    var url=R+'search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product&resources[limit]=4&resources[options][unavailable_products]=hide';
    ctl=('AbortController' in window)?new AbortController():null;var mine=ctl,tm=setTimeout(function(){mine&&mine.abort()},9000);
    fetch(url,{headers:{'Accept':'application/json'},signal:mine?mine.signal:undefined}).then(function(r){if(!r.ok)throw new Error(r.status);return r.json()}).then(function(j){
      clearTimeout(tm);wait.remove();if(g!==gen)return;
      var ps=((((j||{}).resources||{}).results||{}).products)||[];
      ps=ps.filter(function(p){return p&&p.title&&sicherPfad(p.url)});
      if(!ps.length){
        state('idle');msg('Zu „'+esc(q)+'“ habe ich nichts gefunden. Versuch ein anderes Wort – oder schreib uns, wir helfen gern: '+MAIL+'.','bot');
        setChips([{t:'Anderes Wort',f:suchStart},{t:'Kontakt',f:function(){ask('Kontakt','kontakt')}},{t:'☰ Menü',f:menu}]);return;
      }
      state('froh',2500);
      var intro=msg('Das könnte passen zu „'+esc(q)+'“:','bot');
      var h=ps.map(function(p){
        var img=(p.featured_image&&p.featured_image.url)||p.image||'';
        var im=img?'<img src="'+esc(img+(img.indexOf('?')>-1?'&':'?')+'width=130')+'" alt="" loading="lazy" width="60" height="60">':'';
        return '<a class="luxas-card" href="'+esc(sicherPfad(p.url)+'?ref=assistent')+'">'+im+'<div><b>'+esc(p.title)+'</b><span>'+esc(preis(p))+'</span></div></a>';
      }).join('');
      var cards=roh(h,'luxas-cards',true);
      Array.prototype.forEach.call(cards.querySelectorAll('a'),function(a){a.addEventListener('click',function(){trk('assistent_karte')})});
      roh('<a class="luxas-more" href="'+esc(R+'search?type=product&q='+encodeURIComponent(q))+'">Alle Treffer ansehen →</a>','',true);
      scrollen(intro);
      setChips([{t:'Neue Suche',f:suchStart},{t:'Kontakt',f:function(){ask('Kontakt','kontakt')}},{t:'☰ Menü',f:menu}]);
    }).catch(function(){
      clearTimeout(tm);wait.remove();if(g!==gen)return;state('idle');
      msg('Die Suche ist gerade nicht erreichbar. Du findest alles auch über die Suche oben auf der Seite – oder schreib uns an '+MAIL+'.','bot');
      setChips([{t:'Kontakt',f:function(){ask('Kontakt','kontakt')}},{t:'☰ Menü',f:menu}]);
    });
  }
  function verarbeite(q){
    q=q.trim().slice(0,120);if(!q)return;
    var n=norm(q);
    if(persoenlich(q)){msgFl('(Eingabe nicht verarbeitet)','me');kontaktAntwort('Bitte gib hier keine persönlichen Daten oder Bestellnummern ein – dafür ist unser E-Mail-Kontakt der richtige Weg.');return}
    if(/^(hallo|hi|hoi|hey|gruezi|grezi|servus|moin|guten (tag|morgen|abend)|hilfe|help)[ !.?]*$/.test(n)){msg(esc(q),'me');verzoegert(function(){msg('Hallo! Wobei kann ich helfen? Such dir ein Thema aus oder schreib dein Stichwort.','bot');setChips(basisChips())},300);return}
    if(/^(danke|merci|vielen dank|danke schon|super|perfekt|ok|okay)[ !.?]*$/.test(n)){msg(esc(q),'me');verzoegert(function(){msg('Sehr gerne! Wenn noch etwas offen ist – ich bin da. 🙂','bot');setChips(basisChips())},300);return}
    if(/^(menu|menue|start|anfang)$/.test(n)){menu();return}
    if(/^(geschenk(e|idee|ideen|finder)?|geschenkfinder)$/.test(n)){geschenk();return}
    if(suchmodus){suchmodus=false;var s0=suchwort(q);msg(esc(q),'me');if(ALTER.test(q)){altersAntwort();return}if(s0)suche(s0);else{msg('Magst du ein Stichwort schreiben, z. B. „Handyhülle“?','bot');suchmodus=true}return}
    var t=thema(q);
    if(t){ask(q,t);return}
    var s=suchwort(q);
    msg(esc(q),'me');
    if(ALTER.test(q)){altersAntwort();return}
    if(!s){verzoegert(function(){msg('Dazu brauche ich ein Stichwort. Such dir ein Thema aus oder schreib, was du suchst.','bot');setChips(basisChips())},300);return}
    suche(s);
  }
  function altersAntwort(){
    verzoegert(function(){msg('Altersbeschränkte Artikel (z. B. Raucherzubehör) geben wir ausschliesslich an volljährige Personen ab.<br>'+L(R+'pages/faq','Häufige Fragen'),'bot');setChips(basisChips())},300);
  }
  function start(){
    if(started)return;started=true;
    var alt=laden();
    if(alt.length){
      hist=alt;log.setAttribute('aria-live','off');
      alt.forEach(function(x){if(x.w==='raw'){var d=document.createElement('div');d.innerHTML=x.h;while(d.firstChild)log.appendChild(d.firstChild)}else zeile(x.h,x.w,false)});
      var d2=document.createElement('div');d2.style.cssText='align-self:center;color:#5a5a5a;font-size:12px';d2.textContent='— weiter geht’s —';log.appendChild(d2);
      log.scrollTop=log.scrollHeight;setChips(basisChips());setTimeout(function(){log.setAttribute('aria-live','polite')},50);
      return;
    }
    zeile('Hallo 👋 Ich bin der <b>automatische</b> Shop-Assistent (keine Person). Wobei kann ich helfen? Für alles Weitere: '+MAIL+'.','bot',true);
    state('froh',2600);log.appendChild(kacheln());log.scrollTop=0;var ac=aehnlichChip();setChips(ac?[ac]:[]);
  }
  function neuStart(){gen++;if(ctl){try{ctl.abort()}catch(e){}}hist=[];sichern();log.innerHTML='';started=false;suchmodus=false;state('idle');start()}
  function oeffnen(){hideNudge(true);panel.hidden=false;btn.setAttribute('aria-expanded','true');trk('assistent_offen');start();if(window.matchMedia&&matchMedia('(pointer:fine)').matches)setTimeout(function(){try{inp.focus({preventScroll:true})}catch(e){}},30)}
  function schliessen(){panel.hidden=true;btn.setAttribute('aria-expanded','false');btn.focus()}
  btn.addEventListener('click',function(){panel.hidden?oeffnen():schliessen()});
  $('luxas-close').addEventListener('click',schliessen);
  $('luxas-reset').addEventListener('click',neuStart);
  document.addEventListener('keydown',function(e){
    if(e.key!=='Escape'||panel.hidden)return;
    var a=document.activeElement;
    if(panel.contains(a)||a===btn||a===document.body)schliessen();
  });
  form.addEventListener('submit',function(e){e.preventDefault();var v=inp.value;inp.value='';if(COARSE)inp.blur();verarbeite(v)});

  /* Hinweisblase: höchstens einmal je Sitzung, nach 9 s Ruhe, nie bei offenen Bannern/Fenstern. */
  function hideNudge(merken){nudge.hidden=true;if(merken){nudgeGezeigt=true;try{sessionStorage.setItem('luxas.n','1')}catch(e){}}}
  $('luxas-nudge-x').addEventListener('click',function(){hideNudge(true)});
  function nudgeZeigen(){
    if(nudgeGezeigt)return;
    try{if(sessionStorage.getItem('luxas.n')==='1')return}catch(e){}
    if(!panel.hidden||root.hasAttribute('data-hold'))return;
    if(document.querySelector('#lux-wish-toast.show')){setTimeout(nudgeZeigen,7000);return;}   /* Merkliste-Hinweis steht gerade: Blase später */
    nudgeGezeigt=true;nudge.hidden=false;try{sessionStorage.setItem('luxas.n','1')}catch(e){}
    setTimeout(function(){nudge.hidden=true},9000);
  }

  /* Der Knopf darf Cookie-Banner, Shopify-Banner, E-Mail-Popup, offene Fenster/Schubladen und die Sticky-Kaufleiste nicht stören
     (rein per JS, ohne :has(), damit es auch in älteren Browsern greift). */
  var HALT=['lx-cookie-banner','lx-pop','shopify-pc__banner'];
  function halten(){
    var h=false;HALT.forEach(function(i){var e=document.getElementById(i);if(e&&getComputedStyle(e).display!=='none'&&e.getClientRects().length)h=true});
    if(document.querySelector('dialog[open],.menu-drawer-container[open],.cart-drawer[open]'))h=true;
    if(h)root.setAttribute('data-hold','');else root.removeAttribute('data-hold');
    var up=!!document.querySelector('.sticky-add-to-cart__bar[data-stuck="true"]');
    if(up!==root.classList.contains('luxas-up'))root.classList.toggle('luxas-up',up);
  }
  function zeigen(){
    root.hidden=false;halten();setInterval(halten,1500);
    HALT.forEach(function(i){var e=document.getElementById(i);if(e&&'MutationObserver' in window)new MutationObserver(halten).observe(e,{attributes:true,attributeFilter:['style','class','hidden']})});
    setTimeout(nudgeZeigen,9000);
  }
  /* Erst nach dem Laden und einer kurzen Ruhe einblenden (kein Einfluss auf die Ladezeit der Seite). */
  var spaet=function(){setTimeout(zeigen,2500)};
  if(document.readyState==='complete')spaet();else window.addEventListener('load',spaet);
})();
</script>
