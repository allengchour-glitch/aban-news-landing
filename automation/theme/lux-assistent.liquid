  function norm(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/ß/g,'ss').replace(/ae/g,'a').replace(/oe/g,'o').replace(/ue/g,'u').replace(/[^a-z0-9$@ -]+/g,' ').replace(/\s+/g,' ').trim()}
  var KW={};Object.keys(T).forEach(function(t){KW[t]={k:T[t].k.map(norm),w:T[t].w.map(norm)}});
  function trefferWort(n,toks,kw){
    if(kw.indexOf(' ')>-1) return (' '+n+' ').indexOf(' '+kw+' ')>-1 || (' '+n+' ').indexOf(' '+kw)>-1;
    var exakt=kw.charAt(kw.length-1)==='$',w=exakt?kw.slice(0,-1):kw;
    for(var i=0;i<toks.length;i++){ if(exakt?toks[i]===w:(w.length<5?toks[i]===w:toks[i].indexOf(w)===0)) return true }
    return false;
  }
  var STOP={};norm('habt ihr gibt es ich suche suchen brauche brauchen moechte will wuerde gern gerne kann kannst koennt man wie was wo wann wer welche welcher welches hat haben bei euch fuer von mit nach und oder in im am auf zu zum zur ist sind mein meine meinen bitte ein eine einen einem der die das den dem des mir mich dir uns noch auch nur mal sowas etwas lange').split(' ').forEach(function(w){STOP[w]=1});
  function inhaltsWoerter(n){return n.split(' ').filter(function(w){return w.length>1&&!STOP[w]})}
  function thema(q){
    var n=norm(q),toks=n.split(' ').filter(Boolean),best='',bs=0;
    var zeitFrage=trefferWort(n,toks,'wie lange')||trefferWort(n,toks,'wann'),liefWort=toks.some(function(x){return /^(lieferung|liefer|versand|bestellung|paket|sendung)/.test(x)});
    PRIO.forEach(function(t){var s=0;KW[t].k.forEach(function(k){if(trefferWort(n,toks,k))s+=3});KW[t].w.forEach(function(k){if(trefferWort(n,toks,k))s+=1});
      if(t==='lieferzeit'&&zeitFrage&&liefWort)s+=3; /* «Wie lange … Lieferung/Bestellung» */
      if(s>bs){bs=s;best=t}});
    if(bs>=3)return best;
    if(bs>=1){ /* nur Themenwörter: «Versand», «Zahlung», «Paket» */
      var cw=inhaltsWoerter(n);
      if(cw.length&&cw.length<=2&&cw.every(function(w){return KW[best].k.concat(KW[best].w).some(function(kw){return trefferWort(w,[w],kw)})}))return best;
    }
    return '';
  }
  function suchwort(q){return String(q||'').toLowerCase().replace(/[^\p{L}\p{N} -]+/gu,' ').split(/\s+/).filter(function(w){return w.length>1&&!STOP[norm(w)]}).slice(0,5).join(' ')}
  /* Muster für Personendaten: Mail (auch umschrieben), Telefon, Bestellnummer, IBAN. Namen/Adressen erkennt kein Muster – darum der Hinweis im Fenster. */
  function persoenlich(q){
    var s=String(q||''),k=s.replace(/[\s.\-\/(),_]/g,''),gruppen=(s.match(/\d+(?:[\s.\-\/]\d+){2,}/g)||[]).some(function(g){return g.replace(/\D/g,'').length>=9});
    return /@|＠/.test(s)||/(^|[\s(\[])(at|ät)([\s)\]]|$)/i.test(s)||/\[at\]|\(at\)/i.test(s)||/\d{9,}/.test(s)||gruppen||/(\+|00)\d{8,}/.test(k)||/\b(iban|ch\d\d)\b/i.test(s)
      ||/(bestell\w*|auftrag|rechnung|nr\.?|nummer|lx|#)\s?-?\d{3,}/i.test(s)||/#\s?\d{3,}/.test(s);
  }
  var ALTER=/tabak|grinder|shisha|vape|zigarette|feuerzeug|aschenbecher|\bbong\b|joint|rauchzubeh/i;
  function esc(s){var d=document.createElement('div');d.textContent=String(s);return d.innerHTML}

  /* ---------- Verlauf nur im Tab ---------- */
  function sichern(){try{sessionStorage.setItem('luxas.h',JSON.stringify(hist.slice(-24)))}catch(e){}}
  function laden(){
    try{var j=JSON.parse(sessionStorage.getItem('luxas.h')||'[]');if(!Array.isArray(j))return [];
      return j.filter(function(x){return x&&typeof x.h==='string'&&x.h.length<6000&&(x.w==='me'||x.w==='bot'||x.w==='raw')})}catch(e){return []}
  }
  function scrollen(zeile){log.scrollTop=zeile?Math.max(0,zeile.offsetTop-log.offsetTop-8):log.scrollHeight}
  function zeile(html,who,merken){
    var row=document.createElement('div');row.className='luxas-row'+(who==='me'?' luxas-rme':'');
    if(who!=='me'){var a=document.createElement('span');a.className='luxas-ava';a.innerHTML=bot(false);row.appendChild(a)}
    var m=document.createElement('div');m.className='luxas-m luxas-'+who;m.innerHTML=html;row.appendChild(m);log.appendChild(row);
    scrollen(who==='bot'?row:null);
    if(merken){hist.push({w:who,h:html});sichern()}
    return row;
  }
  function roh(html,klasse,merken){
    var d=document.createElement('div');d.className=klasse;d.innerHTML=html;log.appendChild(d);log.scrollTop=log.scrollHeight;
    if(merken){hist.push({w:'raw',h:'<div class="'+klasse+'">'+html+'</div>'});sichern()}
    return d;
  }
  function msg(html,who){return zeile(html,who,true)}
  function msgFl(html,who){return zeile(html,who,false)}
  function tippen(){
    var row=document.createElement('div');row.className='luxas-row';
    var a=document.createElement('span');a.className='luxas-ava';a.innerHTML=bot(false);row.appendChild(a);
    var m=document.createElement('div');m.className='luxas-m luxas-bot luxas-wait';m.innerHTML='<i></i><i></i><i></i>';row.appendChild(m);
    log.appendChild(row);log.scrollTop=log.scrollHeight;state('denkt',9000);return row;
  }
  function verzoegert(fn,ms){ var g=gen; if(REDUCED){fn();return} var t=tippen();setTimeout(function(){t.remove();if(g!==gen)return;fn();state('froh',1800)},ms||420) }

  function setChips(list){
    var hatte=chips.contains(document.activeElement);
    chips.innerHTML='';
    list.forEach(function(c){var b=document.createElement('button');b.type='button';b.className='luxas-chip';b.textContent=c.t;b.addEventListener('click',function(){
      Array.prototype.forEach.call(chips.querySelectorAll('button'),function(x){x.disabled=true});c.f()});chips.appendChild(b)});
    chips.scrollLeft=0;
    if(hatte&&chips.firstChild){try{chips.firstChild.focus({preventScroll:true})}catch(e){}}
  }
  chips.addEventListener('wheel',function(e){if(chips.scrollWidth>chips.clientWidth&&Math.abs(e.deltaY)>Math.abs(e.deltaX)){chips.scrollLeft+=e.deltaY;e.preventDefault()}},{passive:false});
  function produktTitel(){
    try{
      var og=document.querySelector('meta[property="og:type"]');
      if(!og||og.content!=='product')return '';
      var t=(document.querySelector('meta[property="og:title"]')||{}).content||'';
      var w=suchwort(t.split('|')[0]).split(' ').slice(0,3).join(' ');
      return w.length>2?w:'';
    }catch(e){return ''}
  }
  function aehnlichChip(){
