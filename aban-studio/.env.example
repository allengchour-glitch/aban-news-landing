# Aban Studio — environment template. Copy to .env and fill in. Never commit .env.

# --- Supabase (EU region eu-central-1) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only; bypasses RLS

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE29=              # price ID for the €29/mo base plan

# --- AI providers (US providers require DPA + SCCs + TIA; see compliance/) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FLUX_API_KEY=                     # Black Forest Labs (EU) — image
ELEVENLABS_API_KEY=               # TTS

# --- Orchestrator ---
ACTIVE_TEXT_PROVIDER=openai       # openai | anthropic
ACTIVE_IMAGE_PROVIDER=flux
ACTIVE_AUDIO_PROVIDER=elevenlabs
SENTRY_DSN=
