{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/kontext.mjs\"", "timeout": 10, "statusMessage": "luxe-codex: Projektregeln laden" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/schreibzaehler.mjs\" start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/kontext.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/leitplanken.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/schreibzaehler.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
