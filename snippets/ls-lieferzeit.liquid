{%- comment -%}
  LuxeStyle — ls-lieferzeit.liquid
  Zeigt die Lieferzeit fürs Land des Kunden (Phase 2). Liest Produkt-Metafeld custom.lieferzeit (json: {ch_eu, us, tier}),
  das delivery_block.mjs setzt. Sprache & Land kommen aus localization → einsprachige, landesabhängige Anzeige.
  Self-contained (4 Sprachen inline) — robust ohne Locale-Keys. Einbindung: {% render 'ls-lieferzeit', product: product %}
{%- endcomment -%}
{%- assign lz = product.metafields.custom.lieferzeit.value -%}
{%- if lz -%}
  {%- assign ch_eu = lz.ch_eu -%}
  {%- assign us = lz.us -%}
  {%- assign lang = localization.language.iso_code | slice: 0, 2 | downcase -%}
  {%- assign cc = localization.country.iso_code | upcase -%}
  {%- comment -%} Label je Sprache {%- endcomment -%}
  {%- case lang -%}
    {%- when 'fr' -%}{%- assign lbl = 'Délai de livraison' -%}{%- assign dys = 'jours ouvrés' -%}
    {%- when 'it' -%}{%- assign lbl = 'Tempi di consegna' -%}{%- assign dys = 'giorni lavorativi' -%}
    {%- when 'en' -%}{%- assign lbl = 'Delivery time' -%}{%- assign dys = 'business days' -%}
    {%- else -%}{%- assign lbl = 'Lieferzeit' -%}{%- assign dys = 'Werktage' -%}
  {%- endcase -%}
  {%- comment -%} Land → passende Spanne wählen {%- endcomment -%}
  {%- assign overseas = 'US,CA,AU,NZ,JP,SG,AE,BR,MX' | split: ',' -%}
  {%- assign show_us = false -%}
  {%- if us != blank and overseas contains cc -%}{%- assign show_us = true -%}{%- endif -%}
  <p class="ls-lieferzeit" style="background:#f4f6fb;border:1px solid #dde3ef;border-radius:10px;padding:10px 14px;font-size:13px;margin:14px 0;">
    📦 <strong>{{ lbl }}:</strong>
    {%- if show_us -%}
      {{ us }} {{ dys }}
    {%- else -%}
      {{ ch_eu }} {{ dys }}
    {%- endif -%}
  </p>
{%- endif -%}
