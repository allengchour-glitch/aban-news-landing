+/**
+ * ENTWURF 2026-10-26: zusätzlicher reiner Evidenz-Review im bestehenden Modul.
+ * Bestehende Label-Filter bleiben unverändert. Keine I/O, keine Schreibentscheidung.
+ * evidenceComplete bedeutet nur: dieser begrenzte Nachweissatz ist ausgefüllt.
+ * Es ist weder approved noch eine Rechts-/Sicherheits- oder Lieferfreigabe.
+ */
+export function stromversorgungsReview(record) {
+  const result = (status, reason, scope = 'swiss-power-evidence') => ({ status, reason, scope });
+  const text = x => typeof x === 'string' && x.trim().length > 0;
+  const date = x => text(x) && /^\d{4}-\d{2}-\d{2}T/.test(x) && Number.isFinite(Date.parse(x));
+  if (!record || record.schemaVersion !== 1 ||
+      !/^gid:\/\/shopify\/ProductVariant\/\d+$/.test(record.shopifyVariantID ?? '') ||
+      !text(record.supplierVariantID)) return result('unknown', 'Exakte Shopify-/Supplier-Variantenbindung fehlt');
+  const evidence = record.evidence ?? {};
+  if (typeof evidence !== 'object' || Array.isArray(evidence))
+    return result('unknown', 'Belegsammlung fehlt oder hat ein ungültiges Format');
+  const bound = ref => ref && ref.shopifyVariantID === record.shopifyVariantID && ref.supplierVariantID === record.supplierVariantID;
+  const valid = ref => bound(ref) && text(ref.source) && date(ref.capturedAt) && /^[a-f0-9]{64}$/i.test(ref.sha256 ?? '');
+  if (Object.values(evidence).some(ref => ref &&
+      (ref.shopifyVariantID !== record.shopifyVariantID || ref.supplierVariantID !== record.supplierVariantID)))
+    return result('needsReview', 'Belege sind nicht derselben exakten Variantenpaarung zugeordnet');
+  if (record.configuration === 'mixed') return result('needsReview', 'Gemischte oder widersprüchliche Ausführungen');
+  if (record.configuration !== 'single' || !valid(evidence.identity) || !valid(evidence.contents))
+    return result('unknown', 'Eindeutige Ausführung, Variantenmapping oder Lieferumfang unbelegt');
+  const mains = record.power === 'mains' || record.power === 'includedAdapter';
+  if (mains) {
+    if (!valid(evidence.plug) || !['CH', 'Europlug', 'foreign'].includes(record.suppliedPlug))
+      return result('unknown', 'Tatsächlich mitgelieferter Netzstecker unbelegt');
+    if (!['none', 'fixedAdapter', 'travelAdapter', 'unknown'].includes(record.adapterSolution))
+      return result('unknown', 'Mitgelieferte Adapterlösung nicht dokumentiert');
+    if (record.suppliedPlug === 'foreign' && record.adapterSolution === 'none')
+      return result('reject', 'Bestätigter Fremdstecker ohne belegte mitgelieferte Lösung');
+    if (record.adapterSolution === 'unknown')
+      return result('unknown', 'Mitgelieferte Adapterlösung ist unbekannt');
+    if (record.adapterSolution !== 'none')
+      return result('needsReview', 'Adapterfall: fachliche Prüfung der konkreten Lieferung erforderlich');
+    const range = x => x && Number.isFinite(x.min) && Number.isFinite(x.max) && x.min > 0 && x.min <= x.max;
+    const electrical = record.electrical ?? {};
+    if (!valid(evidence.ratings) || electrical.input !== 'AC' ||
+        !range(electrical.voltageV) || !range(electrical.frequencyHz))
+      return result('unknown', 'Abgelesene AC-Eingangsspannung/Frequenz unbelegt');
+    if (!(electrical.voltageV.min <= 230 && electrical.voltageV.max >= 230 &&
+          electrical.frequencyHz.min <= 50 && electrical.frequencyHz.max >= 50))
+      return result('reject', 'Belegte AC-Eingangsangaben decken 230 V / 50 Hz nicht ab');
+    if (!valid(evidence.protection) || record.checks?.plugRatingAndProtection !== true ||
+        !valid(evidence.conformity) || record.checks?.supplyConformityEvidence !== true)
+      return result('unknown', 'Steckerbelastbarkeit/Schutzkonzept oder zugehörige Konformitätsunterlagen ungeprüft');
+    if (record.power === 'includedAdapter' &&
+        (!valid(evidence.deviceInput) || !valid(evidence.adapterOutput) ||
+         !text(record.deviceInputMarking) || !text(record.adapterOutputMarking) ||
+         record.checks?.outputMatchesDevice !== true))
+      return result('unknown', 'Netzteil-Ausgang und Geräteeingang nicht belegt abgeglichen');
+  } else if (record.power === 'usbOnly') {
+    if (!record.suppliedPlug || !record.adapterSolution)
+      return result('unknown', 'USB-Lieferumfang ist nicht vollständig dokumentiert');
+    if (record.suppliedPlug !== 'none' || record.adapterSolution !== 'none')
+      return result('needsReview', 'USB-only widerspricht dokumentiertem Netzstecker/Adapter');
+    if (!valid(evidence.deviceInput) || !valid(evidence.usbRequirements) ||
+        !text(record.deviceInputMarking) || !text(record.usbConnector) ||
+        !text(record.usbSourceRequirements) || record.checks?.usbRequirementsReviewed !== true)
+      return result('unknown', 'USB-Lieferumfang oder erforderliche Stromquelle unvollständig belegt');
+  } else return result('unknown', 'Versorgungsart fehlt oder liegt ausserhalb dieses begrenzten Entwurfs');
+  if (!text(record.reviewedBy) || !date(record.reviewedAt))
+    return result('unknown', 'Nachvollziehbarer manueller Review fehlt');
+  return result('evidenceComplete', 'Begrenzter Nachweissatz dokumentiert; keine Gesamtfreigabe',
+    record.power === 'usbOnly' ? 'usb-package-and-source-requirements-only' : 'swiss-power-evidence');
+}
