@@ -0,0 +1,56 @@
+"""Synthetic ffprobe-response fixtures; no generated video, rights or approval."""
+import copy
+import hashlib
+import json
+import subprocess
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+from probe_originals import probe_media
+
+results = []
+with tempfile.TemporaryDirectory() as tmp:
+    p = Path(tmp) / 'explicit-synthetic-probe-fixture.bin'
+    p.write_bytes(b'SYNTHETIC PROBE RESPONSE TEST; NOT VIDEO')
+    meta = {'streams': [{'width': 1080, 'height': 1920, 'avg_frame_rate': '30/1',
+                        'r_frame_rate': '30/1', 'time_base': '1/30000', 'duration': '.1'}]}
+    frames = {'frames': [{'best_effort_timestamp': n} for n in [0, 1000, 2000]]}
+    with patch('probe_originals._run', side_effect=[meta, frames]):
+        observed = probe_media(p)
+    assert observed['constantFrameRate'] is True and observed['frameCountInspected'] == 3
+    assert observed['fileSha256'] == hashlib.sha256(p.read_bytes()).hexdigest()
+    results.append({'case': 'complete_30fps_timestamps_and_actual_file_hash', 'passed': True})
+    with patch('probe_originals._run', side_effect=[meta, {'frames': frames['frames'][:2]}]):
+        observed = probe_media(p)
+    assert observed['constantFrameRate'] is False and observed['cadenceState'] == 'incomplete_timing_coverage'
+    results.append({'case': 'partial_timing_coverage_does_not_prove_cfr', 'passed': True})
+    with patch('probe_originals._run', side_effect=[meta, {'frames': [{'best_effort_timestamp': n} for n in [0, 500, 2000]]}]):
+        observed = probe_media(p)
+    assert observed['constantFrameRate'] is False
+    results.append({'case': 'average_30fps_does_not_hide_variable_timestamps', 'passed': True})
+    rounded = copy.deepcopy(meta)
+    rounded['streams'][0]['avg_frame_rate'] = '29999999/1000000'
+    with patch('probe_originals._run', side_effect=[rounded, frames]):
+        observed = probe_media(p)
+    assert observed['fps'] == 30 and observed['constantFrameRate'] is True
+    results.append({'case': 'container_duration_rounding_does_not_reject_real_30fps_timestamps', 'passed': True})
+    rotation = copy.deepcopy(meta)
+    rotation['streams'][0].update(width=1920, height=1080, side_data_list=[{'rotation': 90}])
+    with patch('probe_originals._run', side_effect=[rotation, frames]):
+        observed = probe_media(p)
+    assert observed['width'] == 1080 and observed['height'] == 1920 and observed['rotation'] == 90
+    results.append({'case': 'camera_rotation_retains_actual_portrait_dimensions', 'passed': True})
+    large = copy.deepcopy(meta)
+    large['streams'][0]['duration'] = '121'
+    with patch('probe_originals._run', return_value=large) as reader:
+        observed = probe_media(p)
+    assert not observed['constantFrameRate'] and reader.call_count == 1
+    results.append({'case': 'oversized_take_blocks_without_unbounded_frame_scan', 'passed': True})
+    with patch('probe_originals._run', side_effect=subprocess.TimeoutExpired('ffprobe', 20)):
+        observed = probe_media(p)
+    assert observed['readable'] is False
+    results.append({'case': 'probe_timeout_is_unknown_not_empty_video', 'passed': True})
+    invalid = probe_media(None)
+    assert invalid['readable'] is False
+    results.append({'case': 'invalid_explicit_path_has_no_file_discovery', 'passed': True})
+print(json.dumps({'classification': 'SYNTHETIC ffprobe responses only', 'passed': len(results), 'cases': results}, indent=2))
