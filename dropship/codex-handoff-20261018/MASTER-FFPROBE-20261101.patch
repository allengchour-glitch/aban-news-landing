@@ -0,0 +1,88 @@
+"""Read only explicitly supplied local originals; no render or publication approval."""
+import hashlib
+import json
+import subprocess
+from fractions import Fraction
+from pathlib import Path
+
+MAX_SECONDS = 120
+MAX_PACKETS = 3601
+
+
+def hash_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as source:
+        for chunk in iter(lambda: source.read(1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _run(location, entries, frames=False):
+    args = ['ffprobe', '-v', 'error', '-protocol_whitelist', 'file,pipe',
+            '-select_streams', 'v:0']
+    if frames:
+        args += ['-read_intervals', '%+#' + str(MAX_PACKETS), '-show_frames']
+    args += ['-show_entries', entries, '-of', 'json', str(location)]
+    out = subprocess.run(args, capture_output=True, timeout=20, check=False)
+    if out.returncode or len(out.stdout) > 1_500_000:
+        raise ValueError('media_probe_failed_or_exceeded_output_bound')
+    return json.loads(out.stdout)
+
+
+def probe_media(location):
+    """Inspect actual file bytes and timestamps. Attestations remain unverified."""
+    if not isinstance(location, (str, Path)):
+        return {'readable': False, 'reason': 'explicit_local_original_unreadable'}
+    path = Path(location)
+    if not path.is_absolute() or not path.is_file():
+        return {'readable': False, 'reason': 'explicit_local_original_unreadable'}
+    try:
+        sha_before = hash_file(path)
+        raw = _run(path, 'stream=width,height,avg_frame_rate,r_frame_rate,duration,time_base:stream_side_data=rotation:stream_disposition=attached_pic:format=duration,format_name')
+        streams = raw.get('streams', [])
+        if len(streams) != 1 or streams[0].get('disposition', {}).get('attached_pic'):
+            raise ValueError('single_video_stream_not_documented')
+        stream = streams[0]
+        duration = Fraction(str(stream.get('duration') or raw.get('format', {}).get('duration')))
+        width, height = int(stream['width']), int(stream['height'])
+        rotations = [int(v['rotation']) % 360 for v in stream.get('side_data_list', []) if 'rotation' in v]
+        rotation = rotations[0] if rotations else 0
+        if rotation not in (0, 90, 180, 270) or len(set(rotations)) > 1:
+            raise ValueError('unsupported_or_conflicting_rotation')
+        display_width, display_height = (height, width) if rotation in (90, 270) else (width, height)
+        observed = {'readable': True, 'fileSha256': sha_before,
+                    'codedWidth': width, 'codedHeight': height, 'rotation': rotation,
+                    'width': display_width, 'height': display_height,
+                    'durationSeconds': float(duration),
+                    'fps': float(Fraction(stream['r_frame_rate'])),
+                    'averageFps': float(Fraction(stream['avg_frame_rate'])),
+                    'nominalFps': float(Fraction(stream['r_frame_rate'])),
+                    'constantFrameRate': False, 'cadenceState': 'not_checked'}
+        if not 0 < duration <= MAX_SECONDS:
+            observed['cadenceState'] = 'outside_bounded_take_duration'
+            return observed
+        if observed['fps'] != 30 or abs(observed['averageFps'] - 30) > .01:
+            observed['cadenceState'] = 'not_30fps'
+            return observed
+        tick = Fraction(stream['time_base'])
+        frames = _run(path, 'frame=best_effort_timestamp', frames=True).get('frames', [])
+        if not 2 <= len(frames) < MAX_PACKETS:
+            observed['cadenceState'] = 'incomplete_or_exceeded_frame_bound'
+            return observed
+        stamps = [int(frame['best_effort_timestamp']) * tick for frame in frames]
+        step = Fraction(1, 30)
+        gaps = [b - a for a, b in zip(stamps, stamps[1:])]
+        complete = (len(frames) == round(duration * 30) and
+                    abs(stamps[-1] - stamps[0] + step - duration) <= tick + Fraction(1, 1_000_000))
+        constant = (all(gap > 0 and abs(gap - step) <= tick + Fraction(1, 1_000_000) for gap in gaps) and
+                    all(abs(stamp - stamps[0] - index * step) <= tick + Fraction(1, 1_000_000)
+                        for index, stamp in enumerate(stamps)))
+        observed.update(frameCountInspected=len(frames),
+                        constantFrameRate=complete and constant,
+                        cadenceState='measured_full_take' if complete else 'incomplete_timing_coverage')
+        sha_after = hash_file(path)
+        if sha_before != sha_after:
+            raise ValueError('original_changed_during_probe')
+        return observed
+    except (OSError, ValueError, KeyError, TypeError, ZeroDivisionError, subprocess.TimeoutExpired) as error:
+        return {'readable': False, 'reason': 'probe_unavailable_or_invalid:' + type(error).__name__}
