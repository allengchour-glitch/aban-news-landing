 <div id="lux-spezi" style="margin:20px 0 6px;">
 <h3 style="font-size:1.05rem;font-weight:600;margin:0 0 8px;">Spezifikationen &amp; Details</h3>
 <table style="width:100%;border-collapse:collapse;font-size:.92rem;line-height:1.5">{{ rows }}</table>
+{%- if product.handle == 'keramik-tasse-selbst-gestalten' and v.weight > 0 and hat_gewicht == false -%}
+<script type="application/json" data-lux-variant-weight-map="{{ product.id }}">{
+{%- assign lx_weight_first = true -%}
+{%- for lxv in product.variants -%}{%- if lxv.weight > 0 -%}{%- unless lx_weight_first -%},{%- endunless -%}"{{ lxv.id }}":{{ lxv.weight | round | json }}{%- assign lx_weight_first = false -%}{%- endif -%}{%- endfor -%}
+}</script>
+<script>
+(function () {
+  var mapNode = document.querySelector('script[data-lux-variant-weight-map]');
+  var cell = document.querySelector('[data-lux-variant-weight]');
+  if (!mapNode || !cell) return;
+
+  var weights;
+  try {
+    weights = JSON.parse(mapNode.textContent || '{}');
+  } catch (_error) {
+    return;
+  }
+
+  function render(variantId) {
+    var grams = weights[String(variantId || '')];
+    if (!Number.isFinite(grams) || grams <= 0) return;
+    cell.textContent = Math.round(grams) + ' g';
+  }
+
+  function selectedVariantId() {
+    var selected = document.querySelector('variant-picker input[type="radio"][data-variant-id]:checked');
+    if (selected) return selected.getAttribute('data-variant-id');
+    var hidden = document.querySelector('form[action*="/cart/add"] input[name="id"]');
+    return hidden && hidden.value;
+  }
+
+  document.addEventListener('change', function (event) {
+    var target = event.target;
+    if (!target || !target.matches || !target.matches('variant-picker input[type="radio"][data-variant-id]')) return;
+    render(target.getAttribute('data-variant-id'));
+  });
+
+  document.addEventListener('variant:update', function () {
+    window.setTimeout(function () { render(selectedVariantId()); }, 0);
+  });
+
+  render(selectedVariantId());
+})();
+</script>
+{%- endif -%}
