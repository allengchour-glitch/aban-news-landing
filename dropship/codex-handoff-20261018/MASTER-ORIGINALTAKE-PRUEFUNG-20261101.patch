+"""Synthetic offline tests; fixtures are not videos, rights or approval evidence."""
+import copy
+import hashlib
+import json
+import tempfile
+from pathlib import Path
+from check_originals import audit, MASTER, PRODUCT, VARIANT, REQUIRED, CHANNELS, LEGACY_HASH
+
+results = []
+with tempfile.TemporaryDirectory() as tmp:
+    original = Path(tmp) / 'synthetic-not-video.bin'
+    original.write_bytes(b'SYNTHETIC TEST DATA - NOT AN APPROVED ORIGINAL')
+    sha = hashlib.sha256(original.read_bytes()).hexdigest()
+    valid = {'masterId': MASTER, 'productId': PRODUCT, 'variantId': VARIANT, 'originals': []}
+    for take in REQUIRED:
+        valid['originals'].append({
+            'takeId': take, 'localFile': str(original), 'sha256': sha,
+            'productId': PRODUCT, 'variantId': VARIANT,
+            'probe': {'width': 1080, 'height': 1920, 'fps': 30, 'constantFrameRate': True, 'durationSeconds': 10},
+            'nativeMotionReviewed': True, 'nativeMotionReviewRef': 'SYNTHETIC-motion',
+            'unitMotifProofRef': 'SYNTHETIC-unit', 'powerSupplyProofRef': 'SYNTHETIC-power',
+            'visualReviewRef': 'SYNTHETIC-review',
+            'rights': {'assetSha256': sha, 'evidenceRef': 'SYNTHETIC-not-a-licence',
+                       'commercialAdvertising': True, 'editing': True, 'channels': sorted(CHANNELS)}})
+    cases = []
+    cases.append(('complete_synthetic_documentation_never_approves_publication', valid, True))
+    bad = copy.deepcopy(valid); bad['originals'] = []; cases.append(('missing_originals', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['variantId'] = 'other'; cases.append(('wrong_variant', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['sha256'] = 'a'*64; cases.append(('changed_file_hash', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['rights'] = {}; cases.append(('missing_rights', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['rights']['channels'] = ['instagram']; cases.append(('partial_channel_rights', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['probe']['width'] = 960; cases.append(('low_resolution', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['probe']['fps'] = 25; cases.append(('historical_cadence', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['sha256'] = LEGACY_HASH; cases.append(('legacy_hash', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['nativeMotionReviewRef'] = ''; cases.append(('metadata_not_motion_approval', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'].append(copy.deepcopy(bad['originals'][0])); cases.append(('duplicate_take', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['probe']['durationSeconds'] = 5.6; cases.append(('handles_missing', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['takeId'] = {}; cases.append(('object_take_id', bad, False))
+    bad = copy.deepcopy(valid); bad['originals'][0]['takeId'] = []; cases.append(('list_take_id', bad, False))
+    for name, data, expected in cases:
+        out = audit(data)
+        assert out['documentationConsistent'] is expected, (name, out)
+        assert out['publicationReady'] is False and out['renderApproved'] is False
+        results.append({'name': name, 'passed': True, 'issueCount': len(out['issues'])})
+print(json.dumps({'classification': 'SYNTHETIC OFFLINE ONLY', 'passed': len(results), 'cases': results}, indent=2))
