--- /dev/null
+++ b/automation/lib/cj_varianten_schutz.mjs
@@ -0,0 +1,67 @@
+// Schutz für den Auswahl-Lauf. Keine API-Aufrufe beim Import und keine Schreiboperation.
+import { preisFuer } from './cj_varianten.mjs';
+
+export const PREISPLAN_VERSION = 2;
+// Bestehende Bestell-Zuordnung: Grossschreibung und genau ein optionales «CJ-» vor der Lieferanten-SKU.
+export const skuSchluessel = sku => typeof sku === 'string' ? sku.trim().toUpperCase().replace(/^CJ-/, '') : '';
+const text = x => typeof x === 'string' && x.trim() !== '';
+const zu = grund => ({ ok: false, grund });
+
+/** Shop-Preis und unitCost gehören zur bisherigen SKU, nie zur ersten gefilterten CJ-Zeile. */
+export function preisBasis(shopSku, roh) {
+  const ziel = skuSchluessel(shopSku);
+  if (!ziel || !Array.isArray(roh)) return zu('Preisbasis unbekannt: Shop-SKU oder CJ-Varianten fehlen');
+  const treffer = roh.filter(v => skuSchluessel(v.sku) === ziel);
+  if (treffer.length !== 1 || !text(treffer[0]?.vid)) return zu('Preisbasis unbekannt: bisherige Shop-SKU nicht eindeutig einer CJ-Variante zugeordnet');
+  const v = treffer[0];
+  if (roh.filter(x => x.vid === v.vid).length !== 1) return zu('Preisbasis unbekannt: CJ-Variantennummer mehrfach vorhanden');
+  return { ok: true, vid: v.vid, sku: v.sku, ek: v.ek };
+}
+
+/** Alte/unvollständige Pläne dürfen die neue Quellbindung und Preisprüfung nicht umgehen. */
+export function preisplanProblem(plan) {
+  const b = plan?.basis;
+  if (plan?.preisplanVersion !== PREISPLAN_VERSION || !b || !text(b.varianteId) || !text(b.cjVid) || !text(b.cjSku)
+    || !skuSchluessel(b.sku) || skuSchluessel(b.sku) !== skuSchluessel(b.cjSku)) return 'Preisbasis unbekannt: alter oder ungebundener Plan';
+  if (b.kostenWaehrung !== 'CHF' || typeof b.usdChf !== 'number' || !Number.isFinite(b.usdChf) || b.usdChf <= 0) return 'Preisbasis unbekannt: CHF-Kosten oder Kurs nicht belegt';
+  if (!text(plan.updatedAt) || !text(plan.produktId) || !Array.isArray(plan.varianten) || plan.varianten.length < 2) return 'Preisbasis unbekannt: Plan unvollständig';
+  for (const v of plan.varianten) {
+    const p = preisFuer({ basisPreis: b.preis, basisKostenChf: b.kosten, ekBasisUsd: b.ekUsd, ekUsd: v.ekUsd, usdChf: b.usdChf });
+    if (!p.ok) return p.grund;
+    if (!text(v.vid) || !text(v.sku) || v.preis !== p.preis || v.kosten !== p.kostenChf || v.einheitspreis !== false) return 'Preisbasis unbekannt: Variantenpreis passt nicht zur belegten Basis';
+  }
+  return '';
+}
+
+export const PREIS_BASIS_LESEN = `query($id:ID!){product(id:$id){id updatedAt variantsCount{count} variants(first:2){nodes{id sku price inventoryItem{unitCost{amount currencyCode}}}}}}`;
+
+export function preisBasisVeraendert(plan, frisch) {
+  const b = plan.basis, vs = frisch?.variants?.nodes;
+  if (!frisch || frisch.id !== plan.produktId || frisch.variantsCount?.count !== 1 || !Array.isArray(vs) || vs.length !== 1) return 'Preisbasis nicht mehr eindeutig oder Gegenprobe unbekannt';
+  const v = vs[0], kosten = v.inventoryItem?.unitCost?.amount;
+  if (!text(frisch.updatedAt) || frisch.updatedAt !== plan.updatedAt || v.id !== b.varianteId || v.sku !== b.sku
+    || v.inventoryItem?.unitCost?.currencyCode !== 'CHF' || v.price == null || kosten == null || Number(v.price) !== b.preis || Number(kosten) !== b.kosten) return 'Preisbasis seit dem Plan verändert oder Gegenprobe unbekannt';
+  return '';
+}
+
+export const VARIANTEN_SKU_DOPPELT = `query($q:String!){productVariants(first:5,query:$q){nodes{id sku product{id handle}} pageInfo{hasNextPage}}}`;
+
+/** Begrenzte SKU-Gegenprobe: abgeschnittene/fehlende Suchantwort ist unbekannt, nie «frei». */
+export async function pruefeVariantenSkus(q, plan, gesetzt = new Set()) {
+  const ziele = plan.varianten.map(v => skuSchluessel(v.sku));
+  if (ziele.some(s => !s) || new Set(ziele).size !== ziele.length) return zu('SKU mehrdeutig: leere oder doppelte Ziel-SKU im Plan');
+  if (ziele.some(s => gesetzt.has(s))) return zu('SKU schon vergeben oder Schreibstatus unbekannt (in diesem Lauf)');
+  for (const ziel of ziele) {
+    const suche = `sku:${JSON.stringify(ziel)} OR sku:${JSON.stringify('CJ-' + ziel)}`;
+    const antwort = await q(VARIANTEN_SKU_DOPPELT, { q: suche });
+    const c = antwort?.productVariants;
+    if (antwort?.errors?.length || !Array.isArray(c?.nodes) || c.pageInfo?.hasNextPage !== false) return zu('SKU-Gegenprobe unbekannt oder unvollständig');
+    for (const v of c.nodes) {
+      if (!text(v?.id) || typeof v.sku !== 'string') return zu('SKU-Gegenprobe unbekannt: unvollständiger Treffer');
+      if (skuSchluessel(v.sku) !== ziel) continue; // Shopify-Suche kann weitere, ähnliche SKUs liefern.
+      if (!text(v.product?.id)) return zu('SKU-Gegenprobe unbekannt: Produktzuordnung fehlt');
+      if (v.product.id !== plan.produktId) return zu(`SKU schon vergeben (${v.product.handle || v.product.id})`);
+    }
+  }
+  return { ok: true, ziele };
+}
