+import json
+import unittest
+from pathlib import Path
+
+from root_document_audit import audit
+
+
+class RootDocumentSourceTests(unittest.TestCase):
+    def test_actual_page_roots_exclude_embedded_error_documents(self):
+        folder = Path(__file__).parent
+        for key, expected_h1 in [
+            ('pyjama-landing', 'Weihnachtspyjamas für die ganze Familie'),
+            ('pyjama-product', 'Weihnachts-Pyjama im Partnerlook'),
+            ('projector-product', 'Sternenlicht-Projektor für Schlafzimmer'),
+        ]:
+            with self.subTest(page=key):
+                source = json.loads((folder / f'firecrawl-{key}.json').read_text())['structuredContent']
+                result = audit(source['rawHtml'])
+                self.assertEqual(source['metadata']['statusCode'], 200)
+                self.assertEqual(result['h1'], [expected_h1])
+                self.assertEqual(len(result['titles']), 1)
+                self.assertEqual(result['canonical'], [source['metadata']['url']])
+                self.assertEqual(result['viewports'], ['width=device-width,initial-scale=1'])
+                self.assertGreater(result['excludedEmbeddedDocuments'], 0)
+                self.assertEqual(result['jsonLdErrors'], [])
+
+
+if __name__ == '__main__':
+    unittest.main()
