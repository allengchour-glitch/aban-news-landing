+mkdirSync(testBasis,{recursive:true});
+let ok=0,fehler=0;
+
+function lauf({anzahl=2,arten=['ok'],vorbelegt=false,fehlerFeld=['metafields','0','value'],lesenFehlt=[],lesenFalsch=[],live=true,limit}={}) {
+  const dir=mkdtempSync(join(testBasis,'fall-'));
+  try {
+    mkdirSync(join(dir,'automation/lib'),{recursive:true}); mkdirSync(join(dir,'dropship')); mkdirSync(join(dir,'cache'));
+    copyFileSync(runner,join(dir,'automation/material_nachtragen.mjs'));
+    for(const file of ['material.mjs','shopify_gql.mjs','shopify_host.mjs']) copyFileSync(join(basis,'lib',file),join(dir,'automation/lib',file));
+    writeFileSync(join(dir,'automation/lib/shopify_secret.mjs'),'export const shopifyClientSecret=()=>"fixture-secret";\n');
+    const produkte=Array.from({length:anzahl},(_,i)=>({id:`gid://shopify/Product/${1000+i}`,handle:`fixture-${i}`,title:'Musterbecher',descriptionHtml:'',options:[],m:{value:'Ceramic'}}));
+    writeFileSync(join(dir,'roh.jsonl'),produkte.map(p=>JSON.stringify(p)).join('\n')+'\n');
+    writeFileSync(join(dir,'config.json'),JSON.stringify({arten,fehlerFeld,lesenFehlt,lesenFalsch}));
+    writeFileSync(join(dir,'state.json'),JSON.stringify(vorbelegt?Object.fromEntries(produkte.map(p=>[p.id,'Keramik'])):{}));
+    writeFileSync(join(dir,'netz-attrappe.mjs'),`
+import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';
+const c=JSON.parse(readFileSync(process.env.TEST_CONFIG,'utf8'));
+const timer=globalThis.setTimeout;
+globalThis.setTimeout=(fn,ms,...args)=>timer(fn,0,...args);
+let mutationen=0;
+globalThis.fetch=async(url,options)=>{
+  if(String(url)==='https://fixture.myshopify.com/admin/oauth/access_token' && options?.method==='POST') return {status:200,json:async()=>({access_token:'fixture-token'})};
+  if(String(url)!=='https://fixture.myshopify.com/admin/api/2025-01/graphql.json' || options?.method!=='POST') throw new Error('Testnetz gesperrt');
+  const {query,variables}=JSON.parse(options.body);
+  appendFileSync(process.env.TEST_CALLS,JSON.stringify({query,variables})+'\\n');
+  const state=JSON.parse(readFileSync(process.env.TEST_STATE,'utf8'));
+  if(query.includes('metafieldsSet(')) {
+    const art=c.arten[Math.min(mutationen++,c.arten.length-1)];
+    if(art==='netzfehler') throw new Error('synthetische Verbindungsunterbrechung');
+    if(art==='http500') return {status:500,json:async()=>({})};
+    if(art==='userErrors') return {status:200,json:async()=>({data:{metafieldsSet:{metafields:null,userErrors:[{field:c.fehlerFeld,message:'synthetisch abgelehnt',code:'INVALID_VALUE'}]}}})};
+    if(art==='null') return {status:200,json:async()=>({data:{metafieldsSet:null}})};
