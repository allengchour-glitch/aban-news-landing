+    let result={metafields:variables.m.map(()=>({key:'material'})),userErrors:[]};
+    if(art==='ohne-fehlerliste') delete result.userErrors;
+    if(art==='ohne-metafields') result.metafields=null;
+    if(art==='zu-kurz') result.metafields.pop();
+    if(art==='falscher-key') result.metafields[0].key='color';
+    return {status:200,json:async()=>({data:{metafieldsSet:result}})};
+  }
+  if(query.startsWith('query($id:ID!)')) {
+    if(c.lesenFehlt.includes(variables.id)) throw new Error('synthetischer Lesefehler');
+    const value=c.lesenFalsch.includes(variables.id)?'abweichend':state[variables.id];
+    return {status:200,json:async()=>({data:{product:{m:value===undefined?null:{value}}}})};
+  }
+  throw new Error('Unerwartete GraphQL-Operation');
+};
