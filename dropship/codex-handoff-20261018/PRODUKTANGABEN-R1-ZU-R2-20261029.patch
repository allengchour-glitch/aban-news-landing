+test('Vorher bestätigter Stapel bleibt bei späterem Fehler korrekt gezählt',()=>{const r=lauf({anzahl:26,arten:['ok','userErrors']});assert.notEqual(r.status,0);assert.equal(beleg(r).geschrieben,25);assert.equal(r.result.fehler,1);assert.equal(lesungen(r).length,25);assert.match(r.ledger,/25 Produkte/);assert.match(r.ledger,/"uebersetzt":25/);});
