+{% doc %}
+  Returns current review evidence as JSON for one actual Shopify product.
+  The client validates raw numeric strings before rendering any rating.
+  @param {product} product - The exact Shopify product whose reviews are shown.
+  @example
+  {% render 'luxe-product-review-data', product: product %}
+{% enddoc %}
+{%- liquid
+  assign review_status = 'unknown'
+  assign review_source = nil
+  assign review_count_raw = nil
+  assign review_rating_raw = nil
+  assign review_min_raw = nil
+  assign review_max_raw = nil
+  assign review_rating = product.metafields.reviews.rating
+  assign review_count = product.metafields.reviews.rating_count
+  if review_rating.type == 'rating' and review_count.type == 'number_integer'
+    if review_count.value >= 0 and review_rating.value.scale_max > review_rating.value.scale_min
+      if review_rating.value.rating >= review_rating.value.scale_min and review_rating.value.rating <= review_rating.value.scale_max
+        assign review_count_raw = review_count.value | append: ''
+        assign review_rating_raw = review_rating.value.rating | append: ''
+        assign review_min_raw = review_rating.value.scale_min | append: ''
+        assign review_max_raw = review_rating.value.scale_max | append: ''
+        assign review_source = 'reviews'
+        assign review_status = 'known'
+      endif
+    endif
+  endif
+  if review_status == 'unknown'
+    assign review_badge = product.metafields.judgeme.badge.value
+    if review_badge != blank and review_badge contains 'jdgm-prev-badge'
+      assign review_count_marker = "data-number-of-reviews='"
+      assign review_count_quote = "'"
+      unless review_badge contains review_count_marker
+        assign review_count_marker = 'data-number-of-reviews="'
+        assign review_count_quote = '"'
+      endunless
+      assign review_count_parts = review_badge | split: review_count_marker
+      if review_count_parts.size == 2
+        assign review_count_tail = review_count_parts | last
+        if review_count_tail contains review_count_quote
+          assign review_count_raw = review_count_tail | split: review_count_quote | first | strip
