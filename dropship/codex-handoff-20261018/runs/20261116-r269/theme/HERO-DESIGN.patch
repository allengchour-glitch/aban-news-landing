+{% stylesheet %}
+  /* One still campaign image. The modifier also outranks the older hero asset rules. */
+  .lx-home .lx-background-hero.lx-campaign-hero {
+    min-block-size: clamp(600px, 73svh, 820px);
+    background: var(--lx-ink);
+    color: var(--lx-cream);
+  }
+  .lx-home .lx-campaign-hero__media {
+    --lx-campaign-object-position: var(--lx-campaign-focus, 50% 40%);
+    position: absolute;
+    inset: 0;
+    z-index: 0;
+    overflow: hidden;
+  }
+  .lx-home .lx-campaign-hero__media img {
+    inline-size: 100%;
+    block-size: 100%;
+    object-fit: cover;
+    object-position: var(--lx-campaign-object-position);
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: 1;
+    pointer-events: none;
+    background: linear-gradient(90deg, rgb(18 15 11 / .84) 0%, rgb(18 15 11 / .67) 31%, rgb(18 15 11 / .28) 62%, rgb(18 15 11 / .06) 100%);
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy {
+    position: relative;
+    z-index: 2;
+    inline-size: min(76%, 960px);
+    min-inline-size: 0;
+    min-block-size: inherit;
+    justify-content: center;
+    padding: clamp(40px, 5.5vw, 88px);
+    background: transparent;
+    color: var(--lx-cream);
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow {
+    color: var(--lx-cream);
+    font-size: 11px;
+    letter-spacing: .19em;
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero h1 {
+    max-inline-size: 100%;
+    margin: 24px 0;
+    color: var(--lx-cream);
+    font-size: clamp(64px, 7.4vw, 116px);
+    line-height: 1;
+    letter-spacing: -.045em;
+    text-wrap: balance;
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero h1 em { color: #e9d7ba; }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description {
+    max-inline-size: 38ch;
+    color: var(--lx-cream);
+    font-size: 16px;
+    line-height: 1.65;
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-actions { margin-block-start: 30px; gap: 14px 22px; }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-button {
+    min-block-size: 54px;
+    padding: 16px 22px;
+    border-color: var(--lx-cream);
+    border-radius: 12px;
+    background: var(--lx-cream);
+    color: var(--lx-ink) !important;
+    font-size: 13px;
+  }
+  .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { color: var(--lx-cream); font-size: 13px; }
+  .lx-home .lx-background-hero.lx-campaign-hero a:focus-visible {
+    outline: 3px solid var(--lx-cream);
+    outline-offset: 5px;
+    box-shadow: 0 0 0 7px var(--lx-ink);
+  }
+  @media (min-width: 761px) and (max-width: 1050px) {
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy { inline-size: 86%; padding: 48px; }
+    .lx-home .lx-background-hero.lx-campaign-hero h1 { font-size: clamp(58px, 7.2vw, 76px); }
+  }
+  @media (max-width: 760px) {
+    .lx-home .lx-background-hero.lx-campaign-hero { min-block-size: clamp(490px, calc(100svh - 330px), 600px); }
+    .lx-home .lx-campaign-hero__media { --lx-campaign-object-position: var(--lx-campaign-mobile-x, 65%) 40%; }
+    .lx-home .lx-background-hero.lx-campaign-hero::before {
+      background: linear-gradient(180deg, rgb(18 15 11 / .02) 0%, rgb(18 15 11 / .08) 25%, rgb(18 15 11 / .42) 44%, rgb(18 15 11 / .9) 70%, rgb(18 15 11 / .98) 100%);
+    }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy {
+      inline-size: 100%;
+      justify-content: flex-end;
+      padding: 180px 24px 28px;
+    }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow { font-size: 9px; letter-spacing: .16em; }
+    .lx-home .lx-background-hero.lx-campaign-hero h1 { margin: 14px 0 16px; font-size: clamp(35px, 10vw, 54px); letter-spacing: -.04em; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description { font-size: 14px; line-height: 1.6; max-inline-size: 37ch; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-actions { gap: 10px 14px; margin-block-start: 22px; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-button { min-block-size: 50px; padding: 14px 16px; gap: 16px; font-size: 12px; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { min-block-size: 48px; gap: 8px; font-size: 12px; }
+  }
+  @media (max-width: 359px) {
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy { padding-inline: 18px; }
+    .lx-home .lx-background-hero.lx-campaign-hero h1 { font-size: 33px; }
+  }
+  @media (forced-colors: active) {
+    .lx-home .lx-background-hero.lx-campaign-hero { background: Canvas; color: CanvasText; }
+    .lx-home .lx-background-hero.lx-campaign-hero::before { display: none; }
+    .lx-home .lx-campaign-hero__media { display: none; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy,
+    .lx-home .lx-background-hero.lx-campaign-hero h1,
+    .lx-home .lx-background-hero.lx-campaign-hero h1 em,
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow,
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description,
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { color: CanvasText; }
+    .lx-home .lx-background-hero.lx-campaign-hero .lx-button { background: ButtonFace; border-color: ButtonText; color: ButtonText !important; }
+  }
+{% endstylesheet %}
