+  for menu_link in menu.links
+    assign link_path = menu_link.url | split: '?' | first | split: '#' | first | remove_first: request.origin
+    if menu_link.object.id == design_collection.id or link_path == design_path or link_path == design_collection.url
+      assign has_design_link = true
+      break
+    endif
+    for child_link in menu_link.links
+      assign link_path = child_link.url | split: '?' | first | split: '#' | first | remove_first: request.origin
+      if child_link.object.id == design_collection.id or link_path == design_path or link_path == design_collection.url
+        assign has_design_link = true
+        break
+      endif
+      for grandchild_link in child_link.links
+        assign link_path = grandchild_link.url | split: '?' | first | split: '#' | first | remove_first: request.origin
+        if grandchild_link.object.id == design_collection.id or link_path == design_path or link_path == design_collection.url
+          assign has_design_link = true
+          break
+        endif
+      endfor
+      if has_design_link
+        break
+      endif
+    endfor
+    if has_design_link
+      break
+    endif
+  endfor
+-%}
+
+{%- if design_collection.id == 688427434369 and has_design_link == false -%}
+  {%- case variant -%}
