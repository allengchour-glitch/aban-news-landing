+{% javascript %}
+  function initializeLuxeCategory(root) {
+    if (root.dataset.ready) return;
+    root.dataset.ready = 'true';
+    const previewTheme = new URL(location.href).searchParams.get('preview_theme_id');
+    if (previewTheme && /^\d+$/.test(previewTheme)) root.querySelectorAll('a[href]').forEach(link => {
+      const target = new URL(link.href, location.href);
+      if (target.origin === location.origin && target.searchParams.has('view')) {
+        target.searchParams.set('preview_theme_id', previewTheme);
+        link.href = target.href;
+      }
+    });
+    const cards = Array.from(root.querySelectorAll('[data-lxc-card]'));
+    const pagination = root.querySelector('[data-lxc-pagination]');
+    const previous = root.querySelector('[data-lxc-prev]');
+    const next = root.querySelector('[data-lxc-next]');
+    const status = root.querySelector('[data-lxc-page]');
+    const labels = JSON.parse(root.querySelector('[data-lxc-labels]').textContent);
+    const pages = Math.ceil(cards.length / 12);
+    let page = 1;
+    const update = (moveFocus) => {
+      cards.forEach((card, index) => { card.hidden = index < (page - 1) * 12 || index >= page * 12; });
+      previous.disabled = page <= 1;
+      next.disabled = page >= pages;
+      status.textContent = labels.page.replace('[page]', String(page)).replace('[pages]', String(pages));
+      if (moveFocus) {
+        const heading = root.querySelector('.lxc-products');
+        heading.focus({preventScroll:true});
+        heading.scrollIntoView({block:'start', behavior:'auto'});
+      }
+    };
+    previous.addEventListener('click', () => { if (page > 1) { page--; update(true); } });
+    next.addEventListener('click', () => { if (page < pages) { page++; update(true); } });
+    pagination.hidden = pages <= 1;
+    update(false);
+    cards.forEach(card => {
+      const data = card.querySelector('[data-lxc-color-data]');
+      let colors = [];
+      try { colors = JSON.parse(data.textContent); } catch { return; }
+      const row = card.querySelector('[data-lxc-colors]');
+      colors.forEach(color => {
+        if (typeof color.name !== 'string' || !/^#[\da-f]{6}$/i.test(color.hex || '')) return;
+        const chip = document.createElement('span');
+        chip.className = 'lxc-color';
+        chip.title = color.name;
+        chip.setAttribute('aria-label', color.name);
+        chip.style.backgroundColor = color.hex;
+        row.append(chip);
+      });
+    });
+  }
+  document.querySelectorAll('[data-luxe-category]').forEach(initializeLuxeCategory);
+  document.addEventListener('shopify:section:load', event => event.target.querySelectorAll('[data-luxe-category]').forEach(initializeLuxeCategory));
+{% endjavascript %}
