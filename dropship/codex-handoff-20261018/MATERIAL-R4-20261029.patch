+// Nur Testdaten unter dem expliziten Fixture-Verzeichnis; keine Produktionsfreigabe.
+import {readFileSync,writeFileSync,existsSync,copyFileSync} from 'node:fs';
+import {join,dirname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {createHash} from 'node:crypto';
+import {initializeMaterialLedger} from './material_write_ledger.mjs';
+
+export function materialFixtureBelege(dir) {
+  copyFileSync(join(dirname(fileURLToPath(import.meta.url)),'material_write_ledger.mjs'),join(dir,'automation/lib/material_write_ledger.mjs'));
+  const lines=readFileSync(join(dir,'roh.jsonl'),'utf8').split('\n').filter(Boolean);
+  const rows=lines.map(JSON.parse),manualPath=join(dir,'dropship/material_belege.json');
+  const manual=existsSync(manualPath)?readFileSync(manualPath,'utf8'):null,belege=manual?JSON.parse(manual):{};
+  const date=join(dir,'fixture-source-time.txt');
+  if(!existsSync(date))writeFileSync(date,new Date().toISOString());
+  const checkedAt=readFileSync(date,'utf8');
+  const sources=rows.map((p,i)=>{
+    const cjPath=join(dir,'cache',p.handle+'.json'),cj=existsSync(cjPath)?readFileSync(cjPath,'utf8'):null;
+    const bytes=JSON.stringify({productJsonl:lines[i],cjJson:cj,manualEvidenceJson:belege[p.handle]?manual:null});
+    return {ownerId:p.id,sha256:createHash('sha256').update(bytes).digest('hex'),reference:'synthetische-fixture:'+p.id,checkedAt};
+  });
+  const ledgerPath=join(dir,'fixture-ledger.json'),evidencePath=join(dir,'fixture-evidence.json');
+  if(!existsSync(ledgerPath))initializeMaterialLedger({ledgerPath,shopDomain:'luxestyle.ch',ownerIds:rows.map(p=>p.id),baselineEvidenceReference:'synthetischer begrenzter Testbestand',persistenceEvidenceReference:'lokales Testverzeichnis, keine Dauerhaftigkeitsbehauptung',initializationConfirmed:true});
+  writeFileSync(evidencePath,JSON.stringify({sources,sourceAgePolicy:{id:'fixture-only-1h',reference:'explizite synthetische Testregel, keine Projekteinstellung',maxAgeMs:3600000}}));
+  return {MATERIAL_WRITE_LEDGER:ledgerPath,MATERIAL_WRITE_EVIDENCE:evidencePath};
+}
