+    assert(sameKeys(s, ['ok', 'ownerId', 'sourceSha256', 'sourceReference', 'checkedAt', 'policyId', 'policyReference', 'maxAgeMs']) && s.ok === true && s.sourceSha256 === proof.sha256 && s.sourceReference === proof.reference && s.checkedAt === proof.checkedAt && nonempty(s.policyId) && nonempty(s.policyReference) && Number.isSafeInteger(s.maxAgeMs) && s.maxAgeMs > 0, 'Quelle ist nicht an die Planzeile gebunden');
