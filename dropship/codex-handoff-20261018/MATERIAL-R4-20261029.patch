+#!/usr/bin/env node
+// Echte Runner-/HTTP-Hilfe, ausschliesslich synthetische Antworten und eigene Testpfade.
+import assert from 'node:assert/strict';
+import {materialFixtureBelege} from './lib/material_test_fixture.mjs';
+import {copyFileSync,existsSync,mkdirSync,mkdtempSync,readFileSync,rmSync,writeFileSync} from 'node:fs';
+import {dirname,join,resolve} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawnSync} from 'node:child_process';
+
+const hier=dirname(fileURLToPath(import.meta.url));
+const runner=resolve(process.argv[2]||join(hier,'material_nachtragen.mjs'));
+const scratch=resolve(process.env.MATERIAL_TEST_TMP||join(hier,'.material-abschluss-fixtures'));
+mkdirSync(scratch,{recursive:true});
+let ok=0,fehler=0;
+
+function lauf({anzahl=2,typ='single_line_text_field',bulk=false,startFehler,startAntwort='ok',fremderJob=false,pollAntwort='ok',live=true,shop='https://luxestyle.ch',currency='CHF',productStatus='ACTIVE',evidenceCase,ledgerCase,repeat=false,writeOutcome='ok'}={}) {
+  const dir=mkdtempSync(join(scratch,'abschluss-'));
+  try {
+    mkdirSync(join(dir,'automation/lib'),{recursive:true});mkdirSync(join(dir,'dropship'));mkdirSync(join(dir,'cache'));
+    copyFileSync(runner,join(dir,'automation/material_nachtragen.mjs'));
+    for(const f of ['material.mjs','shopify_gql.mjs','shopify_host.mjs']) copyFileSync(join(dirname(runner),'lib',f),join(dir,'automation/lib',f));
+    writeFileSync(join(dir,'automation/lib/shopify_secret.mjs'),'export const shopifyClientSecret=()=>"fixture-secret";\n');
+    const produkte=Array.from({length:anzahl},(_,i)=>({id:`gid://shopify/Product/${8001+i}`,handle:`abschluss-${i}`,title:'Becher',descriptionHtml:'',options:[],m:{value:'Ceramic',type:'single_line_text_field'}}));
+    writeFileSync(join(dir,'roh.jsonl'),produkte.map(p=>JSON.stringify(p)).join('\n')+'\n');
+    writeFileSync(join(dir,'state.json'),JSON.stringify(Object.fromEntries(produkte.map(p=>[p.id,p.m]))));
+    writeFileSync(join(dir,'config.json'),JSON.stringify({typ,startFehler,startAntwort,fremderJob,pollAntwort,shop,currency,productStatus,writeOutcome}));
+    writeFileSync(join(dir,'attrappe.mjs'),`
+import {readFileSync,writeFileSync,appendFileSync} from 'node:fs';
+const c=JSON.parse(readFileSync(process.env.CLOSE_CONFIG,'utf8'));const timer=globalThis.setTimeout;
+globalThis.setTimeout=(fn,ms,...args)=>timer(fn,0,...args);
+let gestartet=false;
+globalThis.fetch=async(url,opt)=>{
+  url=String(url);
+  if(url==='https://fixture.myshopify.com/admin/oauth/access_token'&&opt?.method==='POST') return {status:200,json:async()=>({access_token:'fixture-token'})};
+  if(url==='https://bulk.fixture.invalid/eigene.jsonl') return {status:200,text:async()=>readFileSync(process.env.CLOSE_ROH,'utf8')};
+  if(url==='https://bulk.fixture.invalid/fremde.jsonl') return {status:200,text:async()=>JSON.stringify({id:'gid://shopify/Product/9999',handle:'fremder-job',title:'Fremd',descriptionHtml:'',options:[],m:{value:'Ceramic',type:'single_line_text_field'}})+'\\n'};
+  const version=['2025-01','2026-10'].find(v=>url==='https://fixture.myshopify.com/admin/api/'+v+'/graphql.json');
+  if(!version||opt?.method!=='POST') throw new Error('Testnetz gesperrt');
+  const {query,variables}=JSON.parse(opt.body);appendFileSync(process.env.CLOSE_CALLS,JSON.stringify({version,query,variables})+'\\n');
+  const reply=data=>({status:200,headers:{get:n=>n.toLowerCase()==='x-shopify-api-version'?version:null},json:async()=>({data})});
+  const state=JSON.parse(readFileSync(process.env.CLOSE_STATE,'utf8'));
+  if(query.includes('MaterialApiVersion')) return reply({shop:{url:c.shop,currencyCode:c.currency}});
+  if(query.includes('currentBulkOperation')) return reply({currentBulkOperation:gestartet?{id:c.fremderJob?'gid://shopify/BulkOperation/999':'gid://shopify/BulkOperation/801',status:'COMPLETED',url:c.fremderJob?'https://bulk.fixture.invalid/fremde.jsonl':'https://bulk.fixture.invalid/eigene.jsonl'}:null});
+  if(query.includes('bulkOperationRunQuery')) {
+    gestartet=true;
+    if(c.startFehler==='netz'||c.startFehler==='antwort-verloren') throw new Error('synthetischer unklarer Start');
+    if(c.startFehler==='429'||c.startFehler==='503') return {status:Number(c.startFehler),json:async()=>({})};
+    if(c.startFehler==='throttled') return {status:200,headers:{get:()=>version},json:async()=>({errors:[{message:'Throttled'}]})};
+    if(c.startAntwort==='keine-fehlerliste') return reply({bulkOperationRunQuery:{bulkOperation:{id:'gid://shopify/BulkOperation/801'}}});
+    if(c.startAntwort==='keine-id') return reply({bulkOperationRunQuery:{bulkOperation:null,userErrors:[]}});
+    if(c.startAntwort==='fehler') return reply({bulkOperationRunQuery:{bulkOperation:null,userErrors:[{message:'synthetisch abgelehnt'}]}});
+    return reply({bulkOperationRunQuery:{bulkOperation:{id:'gid://shopify/BulkOperation/801'},userErrors:[]}});
+  }
+  if(query.includes('bulkOperation(')) {
+    if(variables.id!=='gid://shopify/BulkOperation/801') throw new Error('Fremde Bulk-ID');
+    if(c.pollAntwort==='fehlend') return reply({bulkOperation:null});
+    if(c.pollAntwort==='fremde-id') return reply({bulkOperation:{id:'gid://shopify/BulkOperation/999',status:'COMPLETED',url:'https://bulk.fixture.invalid/fremde.jsonl'}});
+    if(c.pollAntwort==='ohne-status') return reply({bulkOperation:{id:variables.id}});
+    if(c.pollAntwort==='ohne-url') return reply({bulkOperation:{id:variables.id,status:'COMPLETED',url:null}});
+    return reply({bulkOperation:{id:variables.id,status:'COMPLETED',errorCode:null,objectCount:'2',url:'https://bulk.fixture.invalid/eigene.jsonl'}});
+  }
+  if(query.includes('MaterialVorher')) return reply({shop:{url:c.shop,currencyCode:c.currency},nodes:variables.ids.map(id=>({id,status:c.productStatus,m:state[id]?{...state[id],compareDigest:'vorher-'+id}:null}))});
+  if(query.includes('metafieldsSet(')) {
+    const ledger=JSON.parse(readFileSync(process.env.MATERIAL_WRITE_LEDGER,'utf8'));
+    const claim=Object.values(ledger.payload.entries).find(e=>variables.m.every(m=>e.ownerIds.includes(m.ownerId)));
+    if(!claim||claim.state!=='inflight') throw new Error('Kein gespeicherter Inflight-Beleg vor dem Senden');
+    if(c.writeOutcome==='netz-vor-schreiben') throw new Error('synthetisch keine Schreibantwort');
+    for(const m of variables.m) state[m.ownerId]={value:m.value,type:m.type};writeFileSync(process.env.CLOSE_STATE,JSON.stringify(state));
+    return reply({metafieldsSet:{metafields:variables.m.map(()=>({key:'material'})),userErrors:[]}});
+  }
+  if(query.startsWith('query($id:ID!)')) {
+    const m=state[variables.id]?{...state[variables.id]}:null;
+    if(variables.id==='gid://shopify/Product/8001'&&m) {if(c.typ==='fehlend') delete m.type;else m.type=c.typ;}
+    return reply({product:{m}});
+  }
+  throw new Error('Unerwartete Operation');
+};
+`);
+    const env={...materialFixtureBelege(dir),SHOPIFY_SHOP:'fixture.myshopify.com',SHOPIFY_CLIENT_ID:'fixture-client',SHOPIFY_CLIENT_SECRET:'fixture-secret',PLAN:join(dir,'plan.jsonl'),CJ_FAKTEN_CACHE:join(dir,'cache'),CLOSE_ROH:join(dir,'roh.jsonl'),CLOSE_CONFIG:join(dir,'config.json'),CLOSE_CALLS:join(dir,'calls.jsonl'),CLOSE_STATE:join(dir,'state.json')};
+    if(!bulk) env.ROH=env.CLOSE_ROH;if(live) env.LIVE='1';
+    const evidence=JSON.parse(readFileSync(env.MATERIAL_WRITE_EVIDENCE,'utf8'));
+    if(evidenceCase==='keine-policy') delete evidence.sourceAgePolicy;
+    if(evidenceCase==='alt') evidence.sources[0].checkedAt=new Date(Date.now()-7200000).toISOString();
+    if(evidenceCase==='zukunft') evidence.sources[0].checkedAt=new Date(Date.now()+3600000).toISOString();
+    if(evidenceCase==='falscher-hash') evidence.sources[0].sha256='0'.repeat(64);
+    if(evidenceCase==='produkt-fehlt') evidence.sources.shift();
+    if(evidenceCase==='cj-geaendert') writeFileSync(join(dir,'cache',produkte[0].handle+'.json'),JSON.stringify({description:'Material: Ceramic'}));
+    writeFileSync(env.MATERIAL_WRITE_EVIDENCE,JSON.stringify(evidence));
+    if(evidenceCase==='ohne-manifest') delete env.MATERIAL_WRITE_EVIDENCE;
+    if(ledgerCase==='fehlend') rmSync(env.MATERIAL_WRITE_LEDGER);
+    if(ledgerCase==='kaputt') writeFileSync(env.MATERIAL_WRITE_LEDGER,'{"payload":{}}');
+    if(ledgerCase==='gesperrt') writeFileSync(env.MATERIAL_WRITE_LEDGER+'.lock','synthetisch belegte Sperre');
+    const run=()=>spawnSync(process.execPath,['--import',join(dir,'attrappe.mjs'),join(dir,'automation/material_nachtragen.mjs')],{cwd:dir,env,encoding:'utf8',timeout:15000});
+    const first=run(),p=repeat?run():first;
+    assert.equal(p.error,undefined,p.error?.message);
+    const calls=existsSync(env.CLOSE_CALLS)?readFileSync(env.CLOSE_CALLS,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse):[];
+    const ledger=existsSync(env.MATERIAL_WRITE_LEDGER)?JSON.parse(readFileSync(env.MATERIAL_WRITE_LEDGER,'utf8')):null;
+    const plan=existsSync(env.PLAN)?readFileSync(env.PLAN,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse):[];
+    return {status:p.status,stdout:p.stdout,stderr:p.stderr,calls,result:p.stdout.split('\n').filter(l=>l.startsWith('{')).map(JSON.parse).find(o=>Object.hasOwn(o,'geschrieben')),ledger:ledger?.payload,plan,firstStatus:first.status};
+  }finally{rmSync(dir,{recursive:true,force:true});}
+}
+const mut=r=>r.calls.filter(c=>c.query.includes('metafieldsSet('));
+const start=r=>r.calls.filter(c=>c.query.includes('bulkOperationRunQuery'));
+const nach=r=>r.calls.filter(c=>c.query.startsWith('query($id:ID!)'));
+function test(name,fn){try{fn();ok++;console.log('OK '+name);}catch(e){fehler++;console.error('FEHLER '+name+': '+e.message);}}
+
+test('Unterstützte API 2026-10 wird explizit angefordert',()=>{const r=lauf();assert.equal(r.status,0,r.stderr);assert.ok(r.calls.length>0);assert.ok(r.calls.every(c=>c.version==='2026-10'));});
+test('Rücklesung fordert Wert und Typ an und bestätigt beide',()=>{const r=lauf();assert.equal(r.status,0,r.stderr);assert.equal(r.result.geschrieben,2);assert.equal(nach(r).length,2);assert.ok(nach(r).every(c=>/\{value\s+type\}/.test(c.query)));});
+test('Passender Wert mit falschem Typ ist eine Abweichung',()=>{const r=lauf({typ:'multi_line_text_field'});assert.equal(r.status,3,r.stdout);assert.equal(r.result.geschrieben,1);assert.equal(r.result.abweichungen,1);assert.equal(nach(r).length,2);});
+for(const typ of ['fehlend',null])test('Fehlender oder ungültiger Nachher-Typ bleibt unbekannt: '+typ,()=>{const r=lauf({typ});assert.equal(r.status,1,r.stdout);assert.equal(r.result.geschrieben,1);assert.equal(r.result.unbekannt,1);assert.equal(nach(r).length,2);});
