+        return { ownerId: i.ownerId, value: r.value, type: r.type, checkedAt };
+      });
+    } else if (state === 'rejected') {
+      assert(e.state === 'inflight' && Array.isArray(userErrors) && userErrors.length > 0 && userErrors.every(x => nonempty(x?.message)), 'Definitive atomare metafieldsSet-userErrors erforderlich');
+      observation = userErrors.map(x => ({ message: x.message, ...(nonempty(x.code) ? { code: x.code } : {}) }));
+    } else {
+      assert(nonempty(reason), 'Grund für unbekanntes Ergebnis oder Konflikt erforderlich'); observation = { reason };
+    }
+    e.state = state; e.revision++; e.updatedAt = at; e.observation = observation;
+    e.history.push({ state, at, observation: structuredClone(observation) }); checkpoint(ledgerPath, d);
+    return { decision: 'checkpointed', key, entry: structuredClone(e) };
+  });
+}
+
+export function readMaterialLedger({ ledgerPath }) { return structuredClone(read(ledgerPath)); }
