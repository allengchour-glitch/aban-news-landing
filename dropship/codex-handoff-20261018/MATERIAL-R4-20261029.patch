+  nowISO(d.scope.establishedAt);
+  assert(Array.isArray(d.scope.ownerIds) && d.scope.ownerIds.length > 0 && d.scope.ownerIds.every(product) && new Set(d.scope.ownerIds).size === d.scope.ownerIds.length, 'Ungültige IDs im Geltungsbereich');
+  assert(nonempty(d.scope.baselineEvidenceReference) && nonempty(d.scope.persistenceEvidenceReference), 'Beleg für Ledger-Abdeckung oder Persistenz fehlt');
+  assert(d.entries && typeof d.entries === 'object' && !Array.isArray(d.entries), 'Ungültige Ledger-Einträge');
+  const seen = new Set();
+  for (const [key, e] of Object.entries(d.entries)) {
+    checkEntry(key, e);
+    for (const id of e.ownerIds) { assert(d.scope.ownerIds.includes(id) && !seen.has(id), 'Doppelter Anspruch oder ausserhalb des Geltungsbereichs'); seen.add(id); }
