+// Begrenzter ausdrücklich abgeglichener Scope; begin/read initialisieren nichts.
+// Belegreferenzen kommen vom Aufrufer und sind kein Befugnisnachweis.
+export function initializeMaterialLedger({ ledgerPath, shopDomain, ownerIds, baselineEvidenceReference, persistenceEvidenceReference, initializationConfirmed, now }) {
+  assert(initializationConfirmed === true && shopDomain === 'luxestyle.ch', 'Ausdrückliche LuxeStyle-Initialisierung erforderlich');
+  assert(Array.isArray(ownerIds) && ownerIds.length > 0 && ownerIds.every(product) && new Set(ownerIds).size === ownerIds.length, 'Ausdrücklicher eindeutiger Produkt-Geltungsbereich erforderlich');
