+// Lokaler Prüfbaustein. Kein HTTP, Tokenzugriff, automatischer Retry, Reset oder Undo.
+// Vorhandene Exklusivlock-/fsync-/Checkpoint-Prinzipien auf Materialstapel übertragen.
+// Ein belegter dauerhafter kanonischer Pfad bleibt externe Voraussetzung.
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash, randomUUID } from 'node:crypto';
+
+const VERSION = 1;
+const FIELD = { namespace: 'mm-google-shopping', key: 'material', type: 'single_line_text_field' };
+const STATES = new Set(['inflight', 'unknown', 'conflict', 'confirmed', 'rejected']);
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const assert = (ok, message) => { if (!ok) throw new Error(message); };
+const nonempty = x => typeof x === 'string' && x.trim().length > 0;
+const product = x => typeof x === 'string' && /^gid:\/\/shopify\/Product\/[1-9]\d*$/.test(x);
+const digest = x => typeof x === 'string' && /^[a-f0-9]{64}$/.test(x);
+const nowISO = now => {
+  const s = now ?? new Date().toISOString();
+  assert(typeof s === 'string' && /^\d{4}-\d{2}-\d{2}T.*(?:Z|[+-]\d{2}:\d{2})$/.test(s) && Number.isFinite(Date.parse(s)), 'Ausdrücklicher gültiger Zeitstempel erforderlich');
+  return new Date(s).toISOString();
+};
+const exactKeys = (x, keys) => x && typeof x === 'object' && !Array.isArray(x) && Object.keys(x).sort().join('|') === [...keys].sort().join('|');
+const jsonHash = x => hash(JSON.stringify(x));
+const sameKeys = (x, keys) => exactKeys(x, keys);
+function sourceProof(x, ownerId) {
+  assert(sameKeys(x, ['ownerId', 'sha256', 'reference', 'checkedAt']) && x.ownerId === ownerId && digest(x.sha256) && nonempty(x.reference) && nonempty(x.checkedAt), 'Vollständiger an die Planzeile gebundener Quellenbeleg erforderlich');
+  return { ownerId, sha256: x.sha256, reference: x.reference, checkedAt: nowISO(x.checkedAt) };
+}
+function checkObservation(state, observation, items, since, at) {
+  if (state === 'confirmed') {
+    assert(Array.isArray(observation) && observation.length === items.length && new Set(observation.map(x => x.ownerId)).size === items.length, 'Vollständige eindeutige Rücklesungen mit Typ erforderlich');
