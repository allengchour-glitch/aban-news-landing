+      const r = observation.find(x => x.ownerId === i.ownerId);
+      assert(sameKeys(r, ['ownerId', 'value', 'type', 'checkedAt']) && r.value === i.value && r.type === i.type && nonempty(r.checkedAt), 'Wert, Typ oder Produkt stimmt nicht überein');
+      const checked = nowISO(r.checkedAt);
+      assert(Date.parse(checked) >= Date.parse(since) && Date.parse(checked) <= Date.parse(at), 'Frischer Rücklesezeitpunkt erforderlich');
+    }
+  } else if (state === 'rejected') {
+    assert(Array.isArray(observation) && observation.length > 0 && observation.every(x => (sameKeys(x, ['message']) || sameKeys(x, ['message', 'code'])) && nonempty(x.message) && (!Object.hasOwn(x, 'code') || nonempty(x.code))), 'Definitive atomare metafieldsSet-userErrors erforderlich');
+  } else assert(sameKeys(observation, ['reason']) && nonempty(observation.reason), 'Grund für unbekanntes Ergebnis oder Konflikt erforderlich');
+}
+
+function checkPath(file) {
+  assert(path.isAbsolute(file), 'Ausdrücklicher absoluter Pfad zum dauerhaften Ledger erforderlich');
+  assert(fs.lstatSync(path.dirname(file)).isDirectory(), 'Vorhandenes Ledger-Verzeichnis erforderlich');
+  assert(fs.realpathSync(path.dirname(file)) === path.resolve(path.dirname(file)), 'Kanonisches Verzeichnis ohne Symlink-Aliase erforderlich');
+  try { assert(fs.lstatSync(file).isFile(), 'Ledger muss eine reguläre Datei sein; Symlink ausgeschlossen'); }
+  catch (e) { if (e.code !== 'ENOENT') throw e; }
+}
+function checkEntry(key, e) {
+  const base = ['planSha256', 'items', 'ownerIds', 'runId', 'claimToken', 'state', 'revision', 'sources', 'startedAt', 'updatedAt', 'history'];
+  assert(sameKeys(e, e.state === 'inflight' ? base : [...base, 'observation']), 'Unerwartete oder fehlende Anspruchsfelder');
+  assert(digest(key) && key === jsonHash([e.planSha256, e.ownerIds]), 'Beschädigter Stapelschlüssel');
+  assert(digest(e.planSha256) && nonempty(e.runId) && nonempty(e.claimToken) && STATES.has(e.state), 'Beschädigte Stapelidentität oder Zustand');
+  assert(Number.isSafeInteger(e.revision) && e.revision >= 0 && Array.isArray(e.history), 'Beschädigte Stapelrevision');
+  assert(Array.isArray(e.items) && e.items.length > 0 && e.items.length <= 25 && Array.isArray(e.ownerIds), 'Beschädigte Stapeleinträge');
+  assert(e.ownerIds.every(product) && new Set(e.ownerIds).size === e.ownerIds.length && e.ownerIds.length === e.items.length, 'Beschädigte Stapel-IDs');
+  assert(e.items.every((i, n) => sameKeys(i, ['ownerId', 'value', 'type', 'before', 'rowSha256', 'sourceEvidence']) && i.ownerId === e.ownerIds[n] && nonempty(i.value) && i.type === FIELD.type && digest(i.rowSha256) && (i.before === null || (sameKeys(i.before, ['value', 'type']) && typeof i.before.value === 'string' && i.before.type === FIELD.type))), 'Beschädigte Stapel-Zielwerte');
