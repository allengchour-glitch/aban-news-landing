+.lx-directory{--lxd-cream:#faf7f2;--lxd-taupe:#8b7355;--lxd-ink:#292722;--lxd-muted:#665f56;--lxd-line:#ded5c9;--lxd-serif:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif;max-width:1400px;margin:0 auto;padding:54px clamp(16px,4vw,60px) 72px;background:var(--lxd-cream);color:var(--lxd-ink)}
+.lx-directory *{box-sizing:border-box}
+.lx-directory [hidden]{display:none!important}
+.lx-directory :focus-visible{outline:3px solid #845a34;outline-offset:5px}
+.lx-directory-header{max-width:700px;margin:0 0 30px}
+.lx-directory-eyebrow{font-size:10px;line-height:1.5;letter-spacing:.16em;text-transform:uppercase;margin:0 0 14px;color:var(--lxd-muted)}
+.lx-directory-header h1{font:400 clamp(38px,4.5vw,64px)/1.05 var(--lxd-serif);letter-spacing:-1.5px;margin:0 0 18px}
+.lx-directory-header>p:last-child{font-size:14px;line-height:1.7;color:var(--lxd-muted);margin:0}
+.lx-directory-search{max-width:620px;margin:0 0 36px}
+.lx-directory-search label{display:block;margin:0 0 9px;font-size:12px;font-weight:600}
+.lx-directory-search-field{display:flex;align-items:center;gap:12px;min-height:54px;padding:0 14px;background:#fff;border:1px solid #cfc3b2;border-radius:14px}
+.lx-directory-search-field>svg{width:21px;height:21px;flex:0 0 21px;fill:none;stroke:currentColor;stroke-width:1.5}
+.lx-directory-search-field>input{min-width:0;flex:1;width:100%;min-height:52px;border:0;background:transparent;font:inherit;color:inherit;outline-offset:0}
+.lx-directory-search-field>button{flex:0 0 auto;min-height:44px;padding:8px;border:0;background:transparent;color:#665f56;font:inherit;font-size:11px;text-decoration:underline;cursor:pointer}
+.lx-directory-search [role=status]{font-size:11px;line-height:1.5;color:var(--lxd-muted);margin:10px 0 0;min-height:17px}
+.lx-directory .lux-kat-lead{display:none}
+.lx-directory.is-enhanced .lux-kat{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;align-items:start}
+.lx-directory .lx-directory-group{min-width:0;border:1px solid var(--lxd-line);border-radius:20px;overflow:hidden;background:#fffdf9;scroll-margin-top:20px}
+.lx-directory .lx-directory-group>summary{list-style:none;cursor:pointer}
+.lx-directory .lx-directory-group>summary::-webkit-details-marker{display:none}
+.lx-directory .lx-directory-group .lux-kat-h{margin:0;padding:0;border:0;position:relative;font:inherit}
+.lx-directory-image{display:flex;align-items:center;justify-content:center;aspect-ratio:1.5;overflow:hidden;background:#eae2d6}
+.lx-directory-image img{display:block;width:100%;height:100%;object-fit:contain}
+.lx-directory-card-copy{position:relative;display:flex;flex-direction:column;gap:9px;padding:22px 56px 22px 22px;min-height:116px}
+.lx-directory-card-title{display:block;font:400 clamp(24px,2.4vw,32px)/1.1 var(--lxd-serif);letter-spacing:-.5px;overflow-wrap:anywhere}
+.lx-directory-card-count{font-size:11px;line-height:1.4;color:var(--lxd-muted);font-weight:400}
+.lx-directory-card-plus{position:absolute;right:20px;top:calc(50% - 12px);font:400 24px/1 sans-serif;transition:transform .15s}
+.lx-directory-group[open] .lx-directory-card-plus{transform:rotate(45deg)}
+.lx-directory .lx-directory-group:hover{border-color:#9e8a70}
+.lx-directory .lx-directory-group>.lux-kat-l{display:grid;grid-template-columns:minmax(0,1fr);gap:0;list-style:none;padding:0 22px 16px;margin:0}
+.lx-directory .lx-directory-group>.lux-kat-l li{margin:0;min-width:0;border-top:1px solid #eee7dc}
+.lx-directory .lx-directory-group>.lux-kat-l a{display:flex;align-items:center;min-height:44px;padding:10px 0;text-decoration:none;color:var(--lxd-muted);font-size:12px;line-height:1.45;overflow-wrap:anywhere}
+.lx-directory .lx-directory-group>.lux-kat-l a:hover{text-decoration:underline;text-underline-offset:4px;color:var(--lxd-ink)}
