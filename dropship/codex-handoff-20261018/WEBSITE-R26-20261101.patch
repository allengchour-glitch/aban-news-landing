--- /dev/null
+++ b/assets/luxe-category-directory.js
@@ -0,0 +1,84 @@
+(() => {
+  document.querySelectorAll('[data-category-directory]').forEach(root => {
+    if (root.classList.contains('is-enhanced')) return;
+    const source = root.querySelector('[data-directory-source] .lux-kat');
+    if (!source) return;
+    const headings = [...source.children].filter(el => el.matches('h2.lux-kat-h'));
+    const templates = [...root.querySelectorAll('template[data-directory-banner]')];
+    const pairs = headings.map(heading => ({heading, list: heading.nextElementSibling}));
+    if (!pairs.length || pairs.length !== templates.length || pairs.some(({list}) => !list?.matches('ul.lux-kat-l'))) return;
+    if (pairs.some(({heading}, index) => {
+      const template = templates.find(el => Number(el.dataset.directoryBanner) === index);
+      return !template?.dataset.directoryExpected || heading.textContent.trim() !== template.dataset.directoryExpected;
+    })) return;
+    const originalLinks = [...source.querySelectorAll('a')];
+    if (pairs.reduce((n, {list}) => n + list.querySelectorAll('a').length, 0) !== originalLinks.length) return;
+    const clean = value => value.normalize('NFKD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase().replace(/\s+/g, ' ').trim();
+    const groups = pairs.map(({heading, list}, index) => {
+      const template = templates.find(el => Number(el.dataset.directoryBanner) === index);
+      const title = template?.dataset.directoryTitle || heading.textContent.trim();
+      const details = document.createElement('details');
+      details.className = 'lx-directory-group';
+      details.id = `lx-directory-${root.dataset.sectionId}-${index}`;
+      details.dataset.directoryGroup = String(index);
+      const summary = document.createElement('summary');
+      const copy = document.createElement('span');
+      copy.className = 'lx-directory-card-copy';
+      const label = document.createElement('span');
+      label.className = 'lx-directory-card-title';
+      label.textContent = title;
+      const count = document.createElement('span');
+      count.className = 'lx-directory-card-count';
+      const items = [...list.children].filter(el => el.matches('li'));
+      const links = items.map(item => ({item, text: clean(item.textContent)}));
+      count.textContent = `${links.length} ${root.dataset.linkLabel}`;
+      const plus = document.createElement('span');
+      plus.className = 'lx-directory-card-plus';
+      plus.setAttribute('aria-hidden', 'true');
+      plus.textContent = '+';
+      copy.append(label, count, plus);
+      heading.replaceChildren();
+      if (template) heading.append(template.content.cloneNode(true));
+      heading.append(copy);
+      heading.before(details);
+      summary.append(heading);
+      details.append(summary, list);
+      return {details, title: clean(title), links, count, openBeforeSearch: false};
+    });
+    root.classList.add('is-enhanced');
+    const search = root.querySelector('[data-directory-search]');
+    const input = root.querySelector('[data-directory-query]');
+    const clear = root.querySelector('[data-directory-clear]');
+    const status = root.querySelector('[data-directory-status]');
+    if (!search || !input || !clear || !status) return;
+    search.hidden = false;
+    let filtering = false;
+    const update = () => {
+      const term = clean(input.value);
+      if (term && !filtering) groups.forEach(group => { group.openBeforeSearch = group.details.open; });
+      let visibleGroups = 0;
+      let visibleLinks = 0;
+      groups.forEach(group => {
+        const titleMatches = group.title.includes(term);
+        let matches = 0;
+        group.links.forEach(link => {
+          link.item.hidden = Boolean(term && !titleMatches && !link.text.includes(term));
+          if (!link.item.hidden) matches += 1;
+        });
+        group.details.hidden = matches === 0;
+        if (term) group.details.open = matches > 0;
+        else if (filtering) group.details.open = group.openBeforeSearch;
+        group.count.textContent = `${matches} ${root.dataset.linkLabel}`;
+        if (matches) visibleGroups += 1;
+        visibleLinks += matches;
+      });
+      root.classList.toggle('is-filtering', Boolean(term));
+      status.textContent = visibleGroups ? `${visibleGroups} ${root.dataset.groupLabel} · ${visibleLinks} ${root.dataset.linkLabel}` : root.dataset.noResults;
+      clear.hidden = !input.value;
+      filtering = Boolean(term);
+    };
+    input.addEventListener('input', update);
+    clear.addEventListener('click', () => { input.value = ''; update(); input.focus(); });
+    update();
+  });
+})();
