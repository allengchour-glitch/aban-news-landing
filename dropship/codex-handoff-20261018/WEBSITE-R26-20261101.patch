+{% doc %}
+Renders the existing category directory with verified collection banner references.
+@param {page} page - The existing category directory page.
+@param {section} section - The containing page section.
+{% enddoc %}
+{{ 'luxe-category-directory.css' | asset_url | stylesheet_tag }}
+<section class="lx-directory" data-category-directory data-section-id="{{ section.id }}" data-group-label="{{ 'luxe_categories.group_label' | t | escape }}" data-link-label="{{ 'luxe_categories.link_label' | t | escape }}" data-no-results="{{ 'luxe_categories.empty' | t | escape }}">
+  <div class="lx-directory-header"><p class="lx-directory-eyebrow">{{ 'luxe_categories.eyebrow' | t }}</p><h1>{{ 'luxe_categories.heading' | t }}</h1><p>{{ 'luxe_categories.intro' | t }}</p></div>
+  <div class="lx-directory-search" data-directory-search hidden><label for="lx-category-search-{{ section.id }}">{{ 'luxe_categories.search_label' | t }}</label><div class="lx-directory-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="lx-category-search-{{ section.id }}" type="search" placeholder="{{ 'luxe_categories.search_placeholder' | t | escape }}" autocomplete="off" data-directory-query><button type="button" data-directory-clear hidden>{{ 'luxe_categories.clear' | t }}</button></div><p role="status" aria-live="polite" data-directory-status></p></div>
+  <div class="lx-directory-source" data-directory-source>{{ page.content }}</div>
+  <div hidden data-directory-templates>
+    {% assign lx_directory_handles = 'kostueme-fasnacht,premium-geschenke,sub-haustier,sport-outdoor,outdoor-garten,werkzeug-maschinen,fur-ihn,damen-mode,t-shirts-tops,winter-kaelte,schuhe,sub-taschen,schmuck-uhren,beauty-pflege,gaming-zubehor,elektronik-technik,wohnen-dekoration,sub-baby-kids,buro-home-office,neu-eingetroffen,klemmbausteine-bausaetze' | split: ',' %}
+    {% assign lx_directory_label_keys = 'costumes,gifts,pets,sport,outdoor,auto,men,women,fashion,season,shoes,bags,jewellery,beauty,gaming,electronics,home,kids,office,new,more' | split: ',' %}
+    {% assign lx_directory_expected_headings = '🎭 Kostüme & Fasnacht|🎁 Geschenke & Anlässe|🐾 Haustiere|🏋️ Sport & Fitness|🌿 Garten & Outdoor|🚗 Auto & Werkzeug|👔 Herrenmode|👗 Damenmode|👕 Mode & Bekleidung|☀️ Saison|👟 Schuhe|👜 Taschen & Accessoires|💎 Schmuck & Uhren|💄 Beauty & Pflege|🎮 Gaming|📱 Technik & Elektronik|🏠 Wohnen & Küche|🧸 Kinder & Baby|💼 Büro & Schreibwaren|⚡ Neu, Trends & Angebote|🔎 Weitere Kategorien' | split: '|' %}
+    {% for lx_directory_handle in lx_directory_handles %}
+      {% assign lx_directory_collection = collections[lx_directory_handle] %}
+      {% assign lx_directory_label_key = 'luxe_categories.' | append: lx_directory_label_keys[forloop.index0] %}
+      <template data-directory-banner="{{ forloop.index0 }}" data-directory-title="{{ lx_directory_label_key | t | escape }}" data-directory-expected="{{ lx_directory_expected_headings[forloop.index0] | escape }}" data-directory-handle="{{ lx_directory_handle | escape }}">
+        <span class="lx-directory-image">{% if lx_directory_collection != blank and lx_directory_collection.image != blank %}{{ lx_directory_collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640, 800, 1000', sizes: '(max-width: 600px) 43vw, (max-width: 1100px) 44vw, 28vw', alt: '' }}{% endif %}</span>
+      </template>
+    {% endfor %}
+  </div>
+</section>
