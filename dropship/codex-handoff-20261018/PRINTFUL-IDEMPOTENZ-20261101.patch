+    if (record && (record.schemaVersion!==1 || record.shop!==shop || record.storeId!==String(storeId) || record.orderId!==order.id ||
+      record.externalId!==externalId || record.orderSha256!==orderHash || record.intentSha256!==intentHash || !['ready','inflight','linked','uncertain'].includes(record.state))) return blocked('checkpoint_identity_conflict');
+  } catch { return blocked('shopify_state_unknown'); }
+
+  const lookup=async path=>{try{return await pf(path,'GET',null,20000);}catch{return null;}};
+  const externalPath='/orders/@'+encodeURIComponent(externalId);
+  let found=await lookup(externalPath);
+  let existing=exactProviderOrder(found,externalId,payload);
+  const linkedId=state.pfOrderId?.value;
+  if (linkedId!=null && !positiveId(linkedId)) return blocked('shopify_provider_id_invalid');
+  if (existing && linkedId!=null && existing.id!==String(linkedId)) return blocked('shopify_provider_id_conflict');
+  if (!existing && genuineNotFound(found) && linkedId!=null) {
+    found=await lookup('/orders/'+encodeURIComponent(linkedId));
+    existing=exactProviderOrder(found,externalId,payload,linkedId);
+    if (!existing) return blocked('legacy_provider_order_unknown_or_mismatch');
+  }
+  const acknowledge=async (remote,created)=>{
+    if (dry) return {state:'dry_existing',providerId:remote.id,providerStatus:remote.status,created:false};
+    try {
+      const fresh=await loadState();
+      if (fresh?.id!==order.id || bestellBelegHash(fresh)!==orderHash) return {state:'marker_unknown',reason:'source_changed_before_link',providerId:remote.id,providerStatus:remote.status,created};
+      const ack=await link(remote,orderHash);
+      if (ack!==true) return {state:'marker_unknown',providerId:remote.id,providerStatus:remote.status,created};
+      return {state:created?'created_linked':'reconciled',providerId:remote.id,providerStatus:remote.status,review:remote.review,created};
+    } catch {return {state:'marker_unknown',providerId:remote.id,providerStatus:remote.status,created};}
+  };
+  if (existing) return acknowledge(existing,false);
+  if (!genuineNotFound(found)) return blocked('provider_lookup_unknown_or_mismatch');
+  if (!record) return blocked('legacy_reconciliation_evidence_missing');
+  if (record.state!=='ready') return blocked('previous_attempt_requires_reconciliation');
+  if (typeof record.reconciliationRef!=='string' || !record.reconciliationRef.trim()) return blocked('reconciliation_evidence_missing');
+  if (dry) return {state:'dry_ready',created:false};
+  const inflight={...record,state:'inflight',intentSha256:intentHash,attemptId:randomUUID()};
+  try {
+    if (await claim(inflight,state.pfCheckpoint.compareDigest)!==true) return blocked('checkpoint_claim_unconfirmed');
+    const fresh=await loadState();
+    const readback=checkpointValue(fresh?.pfCheckpoint);
+    if (JSON.stringify(readback)!==JSON.stringify(inflight) || bestellBelegHash(fresh)!==orderHash) return blocked('checkpoint_readback_unconfirmed');
+  } catch {return blocked('checkpoint_claim_unknown');}
+  found=await lookup(externalPath);existing=exactProviderOrder(found,externalId,payload);
+  if (existing) return acknowledge(existing,false);
+  if (!genuineNotFound(found)) return blocked('provider_recheck_unknown_or_mismatch');
+  try {
+    const fresh=await loadState();
+    if (fresh?.id!==order.id || bestellBelegHash(fresh)!==orderHash || JSON.stringify(checkpointValue(fresh.pfCheckpoint))!==JSON.stringify(inflight)) return blocked('source_or_claim_changed_before_post');
+  } catch {return blocked('source_or_claim_unknown_before_post');}
+  let post;
+  try {post=await pf('/orders'+(payload.confirm?'?confirm=1':''),'POST',{external_id:externalId,recipient:payload.recipient,items:payload.items},20000);} catch {post=null;}
+  const read=await lookup(externalPath);const remote=exactProviderOrder(read,externalId,payload);
+  if (!remote || (positiveId(post?.j?.result?.id) && String(post.j.result.id)!==remote.id)) return {state:'post_unknown',reason:'provider_readback_unconfirmed',created:false};
+  return acknowledge(remote,post?.ok===true && post.status===200 && post.j?.code===200 && String(post.j?.result?.id)===remote.id);
+}
