+  import fs from 'node:fs';
+  import { syncBuiltinESMExports } from 'node:module';
+  const input = JSON.parse(fs.readFileSync(0, 'utf8'));
+  const quelltext = fs.readFileSync(input.ziel, 'utf8');
+  const ausgaben = {}, logs = [], warnungen = [];
+  fs.existsSync = p => Object.hasOwn(input.dateien, p);
+  fs.readFileSync = p => {
+    const wert = input.dateien[p];
+    if (!Object.hasOwn(input.dateien, p) || typeof wert !== 'string') {
+      const e = new Error('Testquelle nicht lesbar'); e.code = wert?.code || 'ENOENT'; throw e;
+    }
+    return wert;
+  };
+  fs.writeFileSync = (p, inhalt) => { ausgaben[p] = inhalt; };
+  syncBuiltinESMExports();
+  console.log = (...s) => logs.push(s.join(' '));
+  console.error = (...s) => warnungen.push(s.join(' '));
+  process.env.OUT = '/virtuell/fortschritt.json';
+  let fehler = null;
+  try { await import('data:text/javascript;base64,' + Buffer.from(quelltext).toString('base64')); } catch (e) { fehler = e.message; }
+  process.stdout.write(JSON.stringify({ zeilen: ausgaben[process.env.OUT] ? JSON.parse(ausgaben[process.env.OUT]) : null, logs, warnungen, fehler }));
+`;
+const ledger = 'dropship/cj_varianten_ledger.txt';
+const kandidaten = '/tmp/auswahl_kandidaten.csv';
+const bilder = 'dropship/cj_variantenbilder_ledger.txt';
+const kategorien = 'dropship/kategorien_ledger.txt';
+const verengt = 'automation/lib/kategorien_verengt_daten.json';
