+{% doc %}
+  Renders one existing collection navigation destination.
+  @param {string} url - Existing destination URL.
+  @param {string} title - Existing menu or collection title.
+  @param {boolean} [active] - Whether the destination is the current collection.
+  @example
+  {% render 'luxe-collection-area-link', url: collection.url, title: collection.title, active: true %}
+{% enddoc %}
+<li data-area-item><a class="lx-collection-explore__link" href="{{ url | escape }}"{% if active %} aria-current="page"{% endif %}><span>{{ title | escape }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a></li>
diff --git a/snippets/luxe-collection-explore.liquid b/snippets/luxe-collection-explore.liquid
new file mode 100644
index 0000000..97eca25
--- /dev/null
+++ b/snippets/luxe-collection-explore.liquid
@@ -0,0 +1,206 @@
+{% doc %}
+  Adds missing child or sibling collection links without replacing existing navigation.
+  @param {collection} collection - The current collection.
+  @example
+  {% render 'luxe-collection-explore', collection: collection %}
+{% enddoc %}
+{{ 'luxe-collection-explore.css' | asset_url | stylesheet_tag }}
+{%- liquid
+  assign lx_chips = '' | split: ','
+  assign lx_children = '' | split: ','
+  assign lx_root_handle = ''
+  assign lx_match_priority = 0
+  assign lx_group_url = collection.url
+  assign lx_group_title = collection.title
+  for lx_top in linklists.main-menu.links
+    assign lx_top_handle = lx_top.url | split: '/collections/' | last | split: '/' | first | split: '?' | first | url_decode
+    if lx_top.url contains '/collections/'
+      if lx_top_handle == collection.handle
+        if lx_match_priority < 4
+          assign lx_children = '' | split: ','
+          assign lx_chips = '' | split: ','
+        endif
+        assign lx_match_priority = 4
+        assign lx_root_handle = lx_top_handle
+        assign lx_children = lx_children | concat: lx_top.links
+        assign lx_group_url = collection.url
+        assign lx_group_title = collection.title
+      endif
+    endif
+    for lx_child in lx_top.links
+      assign lx_child_handle = lx_child.url | split: '/collections/' | last | split: '/' | first | split: '?' | first | url_decode
+      if lx_child.url contains '/collections/'
+        assign lx_child_priority = 2
+        if lx_child.links.size > 0
+          assign lx_child_priority = 3
+        endif
+        if lx_child_handle == collection.handle and lx_match_priority < 4
+          if lx_match_priority < lx_child_priority
+            assign lx_children = '' | split: ','
+            assign lx_chips = '' | split: ','
+            assign lx_root_handle = lx_top_handle
+            assign lx_match_priority = lx_child_priority
+          endif
+          if lx_root_handle == lx_top_handle and lx_match_priority == lx_child_priority
+            if lx_child.links.size > 0
+              assign lx_children = lx_children | concat: lx_child.links
+              assign lx_group_url = collection.url
+              assign lx_group_title = collection.title
+            elsif lx_children.size == 0
+              assign lx_chips = lx_top.links
+              assign lx_group_url = lx_top.url
+              assign lx_group_title = lx_top.title
+            endif
+          endif
+        endif
+      endif
+      for lx_leaf in lx_child.links
+        assign lx_leaf_handle = lx_leaf.url | split: '/collections/' | last | split: '/' | first | split: '?' | first | url_decode
+        if lx_leaf.url contains '/collections/'
+          if lx_leaf_handle == collection.handle and lx_match_priority < 1
+            assign lx_match_priority = 1
+            assign lx_root_handle = lx_top_handle
+            assign lx_chips = lx_child.links
+            assign lx_group_url = lx_child.url
+            assign lx_group_title = lx_child.title
+          endif
+        endif
+      endfor
+    endfor
+  endfor
+  if lx_children.size > 0
+    assign lx_chips = lx_children
+    assign lx_group_url = collection.url
+    assign lx_group_title = collection.title
+  endif
+  assign lx_ref_parent = collection.metafields.lux.eltern.value
+  assign lx_refs = collection.metafields.lux.unterfilter.value
+  if lx_refs == blank and lx_ref_parent != blank
+    assign lx_refs = lx_ref_parent.metafields.lux.unterfilter.value
+    if lx_chips.size == 0
+      assign lx_group_url = lx_ref_parent.url
+      assign lx_group_title = lx_ref_parent.title
+    endif
+    if lx_root_handle == ''
+      assign lx_root_handle = lx_ref_parent.handle
+    endif
+  endif
+  assign lx_fallback = ''
+  case collection.handle
+    when 'hundewelt'
+      assign lx_fallback = 'haustier-hunde,leinen-halsbaender-geschirre,hunde-katzen-kleidung,tier-transport,haustier-tech'
+      assign lx_root_handle = 'sub-haustier'
+    when 'sport-outdoor'
+      assign lx_fallback = 'fitness-training,sub-yoga-fitness,camping-outdoor,velo-radsport,schwimmen-tauchen-wassersport'
+      assign lx_root_handle = 'fitness-training'
+    when 'sub-kueche'
+      assign lx_fallback = 'kueche-kochen,geschirr-tisch'
+      assign lx_root_handle = 'kueche-kochen'
+  endcase
+  assign lx_fallback_handles = lx_fallback | split: ','
+  assign lx_legacy_chips = lx_chips
+  assign lx_seen = '|' | append: collection.url | append: '|'
+  if lx_legacy_chips != '' and lx_legacy_chips.size > 1
+    for lx_existing_link in lx_legacy_chips
+      assign lx_existing_url = lx_existing_link.url | split: '?' | first
+      assign lx_seen = lx_seen | append: lx_existing_url | append: '|'
+    endfor
+  endif
+  if lx_refs != blank and lx_refs.size > 0
+    for lx_existing_ref in lx_refs
+      assign lx_seen = lx_seen | append: lx_existing_ref.url | append: '|'
+    endfor
+  endif
+  assign lx_count = 0
+  assign lx_first_cards = ''
+  assign lx_more_cards = ''
+  assign lx_shown_titles = '|'
+-%}
+{%- for lx_link in lx_chips -%}
+  {%- if lx_link.url contains '/collections/' -%}
+    {%- liquid
+      assign lx_key = lx_link.url | split: '?' | first | prepend: '|' | append: '|'
+      assign lx_active = false
+      assign lx_handle = lx_link.url | split: '/collections/' | last | split: '/' | first | split: '?' | first | url_decode
+      if lx_handle == collection.handle
+        assign lx_active = true
+      endif
+    -%}
+    {%- unless lx_seen contains lx_key -%}
+      {%- capture lx_card -%}{% render 'luxe-collection-area-link', url: lx_link.url, title: lx_link.title, active: lx_active %}{%- endcapture -%}
+      {%- liquid
+        assign lx_seen = lx_seen | append: lx_key
+        assign lx_count = lx_count | plus: 1
+        assign lx_title_lower = lx_link.title | downcase
+        assign lx_shown_titles = lx_shown_titles | append: lx_title_lower | append: '|'
+        if lx_count <= 8 or lx_active
+          assign lx_first_cards = lx_first_cards | append: lx_card
+        else
+          assign lx_more_cards = lx_more_cards | append: lx_card
+        endif
+      -%}
+    {%- endunless -%}
+  {%- endif -%}
+{%- endfor -%}
+{%- for lx_ref in lx_refs -%}
+  {%- if lx_ref != blank and lx_ref.url != blank -%}
+    {%- liquid
+      assign lx_key = lx_ref.url | split: '?' | first | prepend: '|' | append: '|'
+      assign lx_active = false
+      if lx_ref.id == collection.id
+        assign lx_active = true
+      endif
+    -%}
+    {%- unless lx_seen contains lx_key -%}
+      {%- capture lx_card -%}{% render 'luxe-collection-area-link', url: lx_ref.url, title: lx_ref.title, active: lx_active %}{%- endcapture -%}
+      {%- liquid
+        assign lx_seen = lx_seen | append: lx_key
+        assign lx_count = lx_count | plus: 1
+        assign lx_title_lower = lx_ref.title | downcase
+        assign lx_shown_titles = lx_shown_titles | append: lx_title_lower | append: '|'
+        if lx_count <= 8 or lx_active
+          assign lx_first_cards = lx_first_cards | append: lx_card
+        else
+          assign lx_more_cards = lx_more_cards | append: lx_card
+        endif
+      -%}
+    {%- endunless -%}
+  {%- endif -%}
+{%- endfor -%}
+{%- for lx_fallback_handle in lx_fallback_handles -%}
+  {%- assign lx_ref = collections[lx_fallback_handle] -%}
+  {%- if lx_ref != blank and lx_ref.products_count > 0 -%}
+    {%- assign lx_key = lx_ref.url | split: '?' | first | prepend: '|' | append: '|' -%}
+    {%- unless lx_seen contains lx_key -%}
+      {%- capture lx_card -%}{% render 'luxe-collection-area-link', url: lx_ref.url, title: lx_ref.title, active: false %}{%- endcapture -%}
+      {%- liquid
+        assign lx_seen = lx_seen | append: lx_key
+        assign lx_count = lx_count | plus: 1
+        assign lx_title_lower = lx_ref.title | downcase
+        assign lx_shown_titles = lx_shown_titles | append: lx_title_lower | append: '|'
+        if lx_count <= 8
+          assign lx_first_cards = lx_first_cards | append: lx_card
+        else
+          assign lx_more_cards = lx_more_cards | append: lx_card
+        endif
+      -%}
+    {%- endunless -%}
+  {%- endif -%}
+{%- endfor -%}
+{%- if lx_count > 0 -%}
+  <div class="lx-collection-explore" data-collection-explore data-area-count="{{ lx_count }}" data-category-root="{{ lx_root_handle | escape }}">
+    <details class="lx-collection-explore__addition" data-area-addition>
+      <summary id="lx-areas-{{ collection.id }}" class="lx-collection-explore__summary">{{ 'luxe_browse.nav.additional' | t }}<span aria-hidden="true">+</span></summary>
