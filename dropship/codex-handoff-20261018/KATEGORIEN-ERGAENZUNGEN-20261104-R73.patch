le[1] | downcase | remove: '✨ ' | remove: '🎃 ' | remove: '⚡ ' -%}\n    {%- assign tl_pipe = '|' | append: tl -%}\n    {%- assign ok = true -%}\n    {%- if erlaubt != '' -%}{%- assign erl = erlaubt | split: ',' -%}{%- unless erl contains t -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}\n    {%- if menuetitel contains tl_pipe -%}{%- assign ok = false -%}{%- endif -%}\n    {%- if ok and collection.all_tags contains t -%}\n      {%- assign akt = false -%}\n      {%- if current_tags contains t -%}{%- assign akt = true -%}{%- endif -%}\n      {%- comment -%} Mehrfach-Filter (31.08.): native Tag-URLs koennen tag1+tag2 —\n        aktiver Chip entfernt NUR sich selbst, inaktiver haengt sich an die aktiven an. {%- endcomment -%}\n      {%- if akt -%}\n        {%- capture rest -%}{%- for ct in current_tags -%}{%- if ct != t -%}+{{ ct }}{%- endif -%}{%- endfor -%}{%- endcapture -%}\n        {%- assign rest = rest | remove_first: '+' -%}\n        {%- if rest == '' -%}{%- assign ziel = collection.url -%}{%- else -%}{%- assign ziel = collection.url | append: '/' | append: rest -%}{%- endif -%}\n      {%- else -%}\n        {%- capture plus -%}{%- for ct in current_tags -%}{{ ct }}+{%- endfor -%}{{ t }}{%- endcapture -%}\n        {%- assign ziel = collection.url | append: '/' | append: plus -%}\n      {%- endif -%}\n      <a href=\"{{ ziel }}\" rel=\"nofollow\" style=\"white-space:nowrap;font-size:.92rem;padding:.38rem .9rem;border-radius:999px;text-decoration:none;border:1px solid {% if akt %}#2f5a3b{% else %}#9db5a3{% endif %};{% if akt %}background:#2f5a3b;color:#fff;font-weight:700;{% else %}background:#f7faf7;color:#1f3a27;font-weight:600;{% endif %}\">{{ teile[1] }}{% if akt %} ✕{% endif %}</a>\n    {%- endif -%}\n  {%- endfor -%}\n{%- endcapture -%}\n{%- if fchips contains '<a' -%}\n<div class=\"lx-chiprow\" style=\"width:100%;max-width:min(var(--page-width,1200px),100vw);min-width:0;box-sizing:border-box;margin:0 auto;padding:.15rem 1.5rem .3rem;overflow-x:auto;-