+++ b/assets/luxe-collection-explore.css
@@ -0,0 +1,47 @@
+.lx-collection-explore {
+  box-sizing: border-box;
+  width: calc(100% - 48px);
+  max-width: min(var(--page-width, 1200px), calc(100% - 48px));
+  min-width: 0;
+  margin: 0 auto 12px;
+  color: #2f2921;
+}
+.lx-collection-explore[hidden],
+.lx-collection-explore [hidden] { display: none !important; }
+.lx-collection-explore__addition { border-block: 1px solid #e8dfd3; }
+.lx-collection-explore__summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding-block: 4px; color: #6c573e; font-size: 13px; font-weight: 600; cursor: pointer; list-style: none; }
+.lx-collection-explore__summary::marker { content: ''; }
+.lx-collection-explore__summary::-webkit-details-marker { display: none; }
+.lx-collection-explore__summary > span { font-size: 20px; font-weight: 400; }
+.lx-collection-explore__addition[open] > .lx-collection-explore__summary > span { transform: rotate(45deg); }
+.lx-collection-explore__addition > nav { padding-block: 4px 14px; }
+.lx-collection-explore__search { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; width: min(100%, 380px); margin: 0 0 14px; }
+.lx-collection-explore__search label { grid-column: 1 / -1; font-size: 12px; color: #6d6154; }
+.lx-collection-explore__search input { box-sizing: border-box; width: 100%; min-width: 0; min-height: 44px; padding: 10px 14px; border: 1px solid #cfc2b1; border-radius: 10px; background: #fff; color: #2f2921; font: inherit; font-size: 14px; }
+.lx-collection-explore__search button { min-width: 44px; min-height: 44px; padding: 8px 10px; border: 1px solid #cfc2b1; border-radius: 10px; background: #fff; color: #5f4d38; cursor: pointer; font: inherit; font-size: 13px; }
+.lx-collection-explore__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin: 0; padding: 0; list-style: none; }
+.lx-collection-explore__grid li { min-width: 0; margin: 0; }
+.lx-collection-explore__link { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 0; min-height: 54px; height: 100%; padding: 12px 14px; border: 1px solid #ddd2c4; border-radius: 12px; background: #fffdf9; color: #443a2d; text-decoration: none; font-size: 13px; line-height: 1.4; font-weight: 500; transition: border-color .16s ease, background-color .16s ease; }
+.lx-collection-explore__link span { min-width: 0; overflow-wrap: anywhere; }
+.lx-collection-explore__link svg { flex: 0 0 13px; width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.5; }
+.lx-collection-explore__link:hover { border-color: #9e8668; background: #f4ede3; }
+.lx-collection-explore__link[aria-current='page'] { border-color: #8b7355; background: #eae0d2; color: #352b20; font-weight: 600; }
+.lx-collection-explore__empty { margin: 14px 0; color: #6d6154; font-size: 14px; }
+.lx-collection-explore a:focus-visible,
+.lx-collection-explore input:focus-visible,
+.lx-collection-explore button:focus-visible,
+.lx-collection-explore summary:focus-visible { outline: 2px solid #554128; outline-offset: 3px; }
+@media (min-width: 750px) and (max-width: 1050px) {
+  .lx-collection-explore__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+@media (max-width: 749px) {
+  .lx-collection-explore { width: calc(100% - 32px); max-width: calc(100% - 32px); }
+  .lx-collection-explore__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+  .lx-collection-explore__link { padding: 11px 12px; min-height: 56px; font-size: 12px; }
+}
+@media (max-width: 359px) {
+  .lx-collection-explore__link { padding: 10px; gap: 6px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .lx-collection-explore__link { transition: none; }
+}
diff --git a/assets/luxe-collection-explore.js b/assets/luxe-collection-explore.js
new file mode 100644
index 0000000..3f3abea
--- /dev/null
+++ b/assets/luxe-collection-explore.js
@@ -0,0 +1,66 @@
+(() => {
+  const normalize = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().trim();
+  const destination = href => {
+    try {
+      const url = new URL(href, window.location.href);
+      if (url.origin !== window.location.origin) return null;
+      const path = decodeURI(url.pathname).replace(/\/+$/, '');
+      const collectionPath = path.match(/\/collections\/[^/]+$/);
+      return collectionPath ? collectionPath[0] + url.search : null;
+    } catch { return null; }
+  };
+  const initialize = root => {
+    if (root.dataset.exploreReady === 'true') return;
+    root.dataset.exploreReady = 'true';
+    const seen = new Set();
+    document.querySelectorAll('.lx-tabs a[href], .lx-uf a[href]').forEach(link => {
+      if (root.contains(link)) return;
+      const key = destination(link.getAttribute('href'));
+      if (key) seen.add(key);
+    });
+    const cards = [...root.querySelectorAll('[data-area-item]')];
+    const available = cards.filter(card => {
+      const key = destination(card.querySelector('a[href]')?.getAttribute('href'));
+      const duplicate = key !== null && seen.has(key);
+      card.hidden = duplicate;
+      if (duplicate) card.dataset.areaDuplicate = 'true';
+      else if (key) seen.add(key);
+      return !duplicate;
+    });
+    root.hidden = available.length === 0;
+    if (root.hidden) return;
+    const search = root.querySelector('[data-area-search]');
+    const input = search?.querySelector('input');
+    const reset = search?.querySelector('button');
+    const empty = root.querySelector('[data-area-empty]');
+    if (!search || !input || !reset || !empty || available.length <= 4) return;
+    search.hidden = false;
+    const filter = () => {
+      const query = normalize(input.value);
+      let matches = 0;
+      for (const card of available) {
+        const show = !query || normalize(card.textContent).includes(query);
+        card.hidden = !show;
+        if (show) matches++;
+      }
+      empty.hidden = matches !== 0;
+      reset.hidden = !query;
+    };
+    input.addEventListener('input', filter);
+    input.addEventListener('keydown', event => {
+      if (event.key === 'Escape') {
+        input.value = '';
+        filter();
+      }
+    });
+    reset.addEventListener('click', () => {
+      input.value = '';
+      filter();
+      input.focus();
+    });
+    filter();
+  };
+  const scan = scope => scope.querySelectorAll('[data-collection-explore]').forEach(initialize);
+  scan(document);
+  document.addEventListener('shopify:section:load', event => scan(event.target));
+})();
