+{{ 'luxe-studio.css' | asset_url | stylesheet_tag }}
+{{ 'luxe-studio-catalog.css' | asset_url | stylesheet_tag }}
+<script src="{{ 'luxe-studio.js' | asset_url }}" defer></script>
+<script src="{{ 'luxe-studio-catalog.js' | asset_url }}" defer></script>
+{% liquid
+  assign studio_allowed = false
+  if product.tags contains 'wunschdesign' or product.tags contains 'printful_personalized_product'
+    assign studio_allowed = true
+  endif
+  assign studio_variant = product.selected_or_first_available_variant
+  assign studio_image = studio_variant.featured_image | default: product.featured_image
+  assign studio_count = 0
+%}
+{% capture studio_variants %}
+[
+  {% for variant in product.variants %}
+    {% assign studio_count = studio_count | plus: 1 %}
+    {
+      "id": {{ variant.id | append: '' | json }},
+      "title": {{ variant.title | json }},
+      "price": {{ variant.price | json }},
+      "available": {{ variant.available | json }},
+      "options": {{ variant.options | json }}
+      {% if variant.featured_image %},
+        "image": {"src": {{ variant.featured_image | image_url: width: 1200 | json }}, "alt": {{ variant.featured_image.alt | default: product.title | json }}, "width": {{ variant.featured_image.width | json }}, "height": {{ variant.featured_image.height | json }}}
+      {% endif %}
+    }{% unless forloop.last %},{% endunless %}
+  {% endfor %}
+]
+{% endcapture %}
+{% liquid
+  assign studio_complete = false
+  if studio_count == product.variants_count and studio_allowed
+    assign studio_complete = true
+  endif
+%}
+{% capture studio_data %}
+{
+  "previewOnly": true,
+  "complete": {{ studio_complete | json }},
+  "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
+  "locale": {{ request.locale.iso_code | json }},
+  "catalogUrl": "/collections/sg-alle",
+  "catalogSearchUrl": "/search",
+  "catalogCollections": [
+    {"url":"/collections/sg-alle", "title": {{ 'luxe_studio.catalog_all' | t | json }}},
+    {"url":"/collections/sg-bekleidung", "title": {{ 'luxe_studio.catalog_clothing' | t | json }}},
+    {"url":"/collections/sg-taschen", "title": {{ 'luxe_studio.catalog_bags' | t | json }}},
+    {"url":"/collections/sg-wohnen", "title": {{ 'luxe_studio.catalog_home' | t | json }}},
+    {"url":"/collections/sg-trinken", "title": {{ 'luxe_studio.catalog_drinkware' | t | json }}},
+    {"url":"/collections/sg-accessoires", "title": {{ 'luxe_studio.catalog_accessories' | t | json }}}
+  ],
+  "product": {
+    "id": {{ product.id | append: '' | json }},
+    "title": {{ product.title | json }},
+    "url": {{ product.url | json }},
+    "selectedVariantId": {{ studio_variant.id | append: '' | json }},
+    "variantCount": {{ product.variants_count | json }},
+    "options": [
+      {% for option in product.options_with_values %}
