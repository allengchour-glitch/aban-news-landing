+      <button type="button" class="lx-studio-entry__launch" data-luxe-studio-launch>{{ 'luxe_studio.intro_launch' | t }}</button>
+    {% else %}
+      <p>{{ 'luxe_studio.intro_unavailable' | t }}</p>
+    {% endif %}
+    <p class="lx-studio-entry__note">{{ 'luxe_studio.intro_preview' | t }}</p>
+    <a class="lx-studio-entry__back" href="{{ product.url }}">{{ 'luxe_studio.intro_back' | t }}</a>
+  </div>
+</div>
+
+{% stylesheet %}
+.lx-studio-entry { max-width: 1240px; margin: 32px auto 72px; padding: 0 28px; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(24px, 6vw, 80px); align-items: center; color: #242321; }
+.lx-studio-entry__visual { background: #f5f3ee; border-radius: 24px; overflow: hidden; }
+.lx-studio-entry__visual img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
+.lx-studio-entry__kicker { font: 600 12px/1.4 sans-serif; text-transform: uppercase; letter-spacing: .16em; color: #736659; }
+.lx-studio-entry h1 { margin: 16px 0; font-size: clamp(28px, 3.2vw, 46px); line-height: 1.12; letter-spacing: -.035em; }
+.lx-studio-entry__lead { max-width: 420px; line-height: 1.65; color: #605b56; }
+.lx-studio-entry__steps { list-style: none; padding: 0; margin: 26px 0; counter-reset: studio-step; }
+.lx-studio-entry__steps li { display: flex; align-items: center; gap: 12px; margin: 12px 0; font-size: 14px; }
+.lx-studio-entry__steps li::before { counter-increment: studio-step; content: counter(studio-step); display: grid; place-items: center; border: 1px solid #d3ccc3; width: 28px; height: 28px; border-radius: 50%; font-size: 12px; }
+.lx-studio-entry__launch { border: 0; border-radius: 12px; padding: 17px 28px; background: #252420; color: #fff; font-family: inherit; font-size: 15px; font-weight: 600; line-height: 1.2; cursor: pointer; min-height: 52px; }
+.lx-studio-entry__launch:focus-visible, .lx-studio-entry__back:focus-visible { outline: 3px solid #776452; outline-offset: 4px; }
+.lx-studio-entry__note { max-width: 440px; font-size: 12px; line-height: 1.6; color: #746e67; }
+.lx-studio-entry__back { display: inline-block; padding: 8px 0; font-size: 13px; text-decoration: underline; color: #514b45; }
+@media (max-width: 760px) { .lx-studio-entry { grid-template-columns: 1fr; gap: 22px; padding: 0 20px; margin: 16px auto 40px; } .lx-studio-entry__visual { max-height: 34vh; } .lx-studio-entry__visual img { height: 34vh; } .lx-studio-entry h1 { font-size: 28px; } .lx-studio-entry__launch { width: 100%; } }
+{% endstylesheet %}
