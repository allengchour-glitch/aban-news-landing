+          "priceVaries": {{ item.price_varies | json }},
+          "available": {{ item.available | json }},
+          "variantCount": {{ item.variants_count | json }},
+          "image": {% if item.featured_image %}{"src": {{ item.featured_image | image_url: width: 480 | json }}, "alt": {{ item.featured_image.alt | default: item.title | json }}, "width": {{ item.featured_image.width | json }}, "height": {{ item.featured_image.height | json }}}{% else %}null{% endif %},
+          "options": [{% for option in item.options_with_values %}{"name": {{ option.name | json }}, "values": [{% for value in option.values %}{{ value.name | default: value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}{% endfor %}]
+        }
+        {% assign studio_count = studio_count | plus: 1 %}
