+      {% endfor %}
+    ],
+    "variants": {{ studio_variants }},
+    "images": [{% if studio_image %}{"src": {{ studio_image | image_url: width: 1200 | json }}, "alt": {{ studio_image.alt | default: product.title | json }}, "width": {{ studio_image.width | json }}, "height": {{ studio_image.height | json }}}{% endif %}]
+  },
+  "labels": {"eyebrow": {{ 'luxe_studio.eyebrow' | t | json }},
