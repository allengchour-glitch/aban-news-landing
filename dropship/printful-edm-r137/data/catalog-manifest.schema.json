{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxestyle.ch/schemas/printful-edm-audit-catalog-v1.json",
  "title": "LuxeStyle Printful EDM audit catalog",
  "type": "object",
  "required": [
    "schema",
    "schemaId",
    "schemaVersion",
    "shop",
    "scope",
    "policy",
    "coverage",
    "sources",
    "products"
  ],
  "properties": {
    "schema": { "const": 1 },
    "schemaId": { "const": "luxestyle-printful-edm-audit-catalog/1" },
    "schemaVersion": { "const": 1 },
    "shop": {
      "type": "object",
      "required": ["domain", "currency"],
      "properties": {
        "domain": { "const": "luxestyle.ch" },
        "currency": { "const": "CHF" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["mode", "auditCatalogOnly", "runtimeAllowlist"],
      "properties": {
        "mode": { "const": "fail_closed" },
        "auditCatalogOnly": { "const": true },
        "runtimeAllowlist": { "const": false }
      }
    },
    "products": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nullablePositiveInteger": {
      "anyOf": [
        { "$ref": "#/$defs/positiveInteger" },
        { "type": "null" }
      ]
    },
    "placement": {
      "type": "object",
      "required": ["id", "printfileId", "width", "height", "dpi"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "printfileId": { "$ref": "#/$defs/positiveInteger" },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "dpi": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "shopifyVariantId",
        "shopifyVariantGid",
        "printfulVariantId",
        "printfulProductId",
        "mappingStatus",
        "eligible",
        "edmEligible",
        "mockupEligible",
        "placements",
        "blockers"
      ],
      "properties": {
        "shopifyVariantId": { "$ref": "#/$defs/positiveInteger" },
        "shopifyVariantGid": {
          "type": "string",
          "pattern": "^gid://shopify/ProductVariant/[1-9][0-9]*$"
        },
        "printfulVariantId": { "$ref": "#/$defs/nullablePositiveInteger" },
        "printfulProductId": { "$ref": "#/$defs/nullablePositiveInteger" },
        "eligible": { "const": false },
        "edmEligible": { "const": false },
        "mockupEligible": { "type": "boolean" },
        "placements": {
          "type": "array",
          "items": { "$ref": "#/$defs/placement" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "handle",
        "shopifyProductId",
        "shopifyProductGid",
        "shopifyStatus",
        "provider",
        "expectedVariantCount",
        "listedVariantCount",
        "mappingStatus",
        "eligible",
        "edmEligible",
        "mockupEligible",
        "blockers",
        "variants"
      ],
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "shopifyProductId": { "$ref": "#/$defs/positiveInteger" },
        "shopifyProductGid": {
          "type": "string",
          "pattern": "^gid://shopify/Product/[1-9][0-9]*$"
        },
        "shopifyStatus": { "enum": ["ACTIVE", "DRAFT"] },
        "provider": { "enum": ["printful", "mister-dtf", "unknown"] },
        "expectedVariantCount": { "$ref": "#/$defs/positiveInteger" },
        "listedVariantCount": { "$ref": "#/$defs/positiveInteger" },
        "printfulProductId": { "$ref": "#/$defs/nullablePositiveInteger" },
        "printfulProductIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/positiveInteger" },
          "uniqueItems": true
        },
        "eligible": { "const": false },
        "edmEligible": { "const": false },
        "mockupEligible": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
