.lcl-catalog{--lcl-ink:#292725;--lcl-muted:#706c65;--lcl-line:#ddd7ce;--lcl-paper:#faf8f4;--lcl-wash:#eee8df;max-width:1800px;margin:auto;padding:clamp(25px,4vw,56px) clamp(16px,5vw,80px) 52px;background:var(--lcl-paper);color:var(--lcl-ink);font-family:var(--font-body--family,Arial,sans-serif)}
.lcl-catalog *,.lcl-dialog *{box-sizing:border-box}.lcl-catalog [hidden],.lcl-dialog [hidden]{display:none!important}:where(.lcl-catalog,.lcl-dialog) :is(button,input,select){font:inherit}.lcl-catalog button,.lcl-dialog button{cursor:pointer}.lcl-catalog :is(button,input,select):focus-visible,.lcl-dialog :is(button,summary):focus-visible{outline:2px solid #63584a;outline-offset:4px}.lcl-header{max-width:950px}.lcl-eyebrow{color:var(--lcl-muted);font-size:11px;line-height:1.5;letter-spacing:.15em;font-weight:600;margin:0 0 13px}.lcl-header h1{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(34px,4vw,58px);font-weight:400;letter-spacing:-.035em;line-height:1.08;margin:0 0 15px}.lcl-intro{font-size:16px;line-height:1.6;color:var(--lcl-muted);max-width:780px;margin:0}.lcl-notice{font-size:12px;line-height:1.6;color:#5f574c;padding:12px 16px;background:#eee7dc;border-left:2px solid #a39279;margin:22px 0 24px;max-width:1080px}.lcl-audience-label{font-size:13px;font-weight:600;margin:0 0 11px}.lcl-audiences{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:9px}.lcl-audience{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--lcl-line);border-radius:5px;padding:16px 17px;min-height:58px;background:#fff;color:var(--lcl-ink);font-size:14px;font-weight:500;text-align:left}.lcl-audience[aria-pressed=true]{background:var(--lcl-ink);border-color:var(--lcl-ink);color:#fff}.lcl-audience-count{font-size:11px;opacity:.7;font-weight:400}.lcl-unisex-hint{margin:6px 0 14px;font-size:12px;color:var(--lcl-muted)}.lcl-filters{display:grid;grid-template-columns:minmax(250px,1.5fr) minmax(200px,1fr) auto;gap:15px;align-items:end;margin:24px 0 22px}.lcl-filter{display:grid;gap:7px;font-size:12px;font-weight:500;min-width:0}.lcl-filter input,.lcl-filter select{width:100%;height:48px;border:1px solid #d3ccc1;border-radius:4px;background:#fff;color:var(--lcl-ink);padding:11px 13px;font-size:14px;min-width:0}.lcl-filter input::placeholder{color:#8c857b}.lcl-reset{background:none;border:0;border-bottom:1px solid #a89d8b;padding:11px 0;margin:0 0 5px;color:var(--lcl-muted);font-size:12px;min-height:40px}.lcl-result-line{display:flex;justify-content:space-between;gap:16px;align-items:center;border-top:1px solid var(--lcl-line);padding:18px 0}.lcl-results{font-size:13px;margin:0;scroll-margin-top:145px}.lcl-partial{font-size:11px;color:var(--lcl-muted);margin:0}.lcl-message{font-size:14px;line-height:1.6;margin:14px 0 24px;color:var(--lcl-muted)}.lcl-button{border:1px solid var(--lcl-ink);border-radius:4px;background:var(--lcl-ink);color:#fff;padding:12px 18px;min-height:44px;font-size:13px}.lcl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px 22px}.lcl-card{min-width:0;display:flex;flex-direction:column;background:#fff;border:1px solid #e5dfd6;border-radius:6px;overflow:hidden}.lcl-card-image{display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:4/4.5;background:#fff;border:0;border-radius:0;padding:12px;overflow:hidden}.lcl-card-image img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .25s ease}.lcl-card-image:hover img{transform:scale(1.025)}.lcl-card-copy{padding:16px;display:flex;flex-direction:column;flex:1;min-width:0}.lcl-brand{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--lcl-muted);margin:0 0 7px;overflow-wrap:anywhere}.lcl-card h3{font-size:15px;font-weight:500;line-height:1.45;margin:0 0 13px;overflow-wrap:anywhere;font-family:inherit;letter-spacing:normal}.lcl-card-colors{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:1px 0 9px}.lcl-card-color{display:inline-flex}.lcl-swatch{display:inline-block;width:19px;height:19px;border:1px solid rgba(75,65,51,.25);border-radius:50%;flex-shrink:0}.lcl-swatch--unknown{background:linear-gradient(135deg,#fff 46%,#b5ac9f 48%,#b5ac9f 52%,#fff 54%)}.lcl-more{font-size:10px;color:var(--lcl-muted);line-height:1.4}.lcl-card-sizes{font-size:11px;line-height:1.6;color:#6b655d;margin:0 0 12px;overflow-wrap:anywhere}.lcl-card-cta{display:flex;align-items:center;justify-content:center;width:100%;min-height:44px;padding:12px 9px;border:1px solid #ddd5ca;border-radius:3px;background:#f8f5f0;color:var(--lcl-ink);font-size:12px;font-weight:600;margin-top:auto}.lcl-card-cta:hover{background:#eee7dc}.lcl-small{font-size:11px;line-height:1.6;color:var(--lcl-muted);margin:10px 0}.lcl-pagination{display:flex;align-items:center;justify-content:center;gap:24px;margin:34px 0 0;font-size:13px}.lcl-pagination button{background:transparent;border:1px solid var(--lcl-line);padding:12px 17px;min-height:44px;border-radius:4px;color:var(--lcl-ink)}.lcl-pagination button:disabled{opacity:.35;cursor:default}.lcl-image-missing{font-size:12px;color:var(--lcl-muted);text-align:center;line-height:1.5;padding:20px}.lcl-dialog{--lcl-ink:#292725;--lcl-muted:#706c65;--lcl-line:#ddd7ce;position:fixed;inset:0;width:min(1160px,calc(100vw - 48px));height:min(900px,calc(100dvh - 48px));max-width:none;max-height:none;padding:0;border:0;border-radius:9px;background:#faf8f4;color:var(--lcl-ink);font-family:var(--font-body--family,Arial,sans-serif);margin:auto;overflow:hidden;box-shadow:0 20px 90px #0004}.lcl-dialog[open]{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr)}.lcl-dialog::backdrop{background:rgba(25,23,20,.62);backdrop-filter:blur(3px)}html:has(.lcl-dialog[open]){overflow:hidden}.lcl-dialog-header{display:flex;gap:20px;align-items:center;justify-content:space-between;padding:20px 25px;border-bottom:1px solid var(--lcl-line);min-width:0}.lcl-dialog-header h2{font-size:20px;line-height:1.35;font-weight:500;margin:0;letter-spacing:-.02em;min-width:0;overflow-wrap:anywhere}.lcl-close{border:1px solid var(--lcl-line);background:#fff;color:var(--lcl-ink);border-radius:4px;min-width:44px;min-height:44px;padding:10px 13px;font-size:12px;flex-shrink:0}.lcl-dialog-notice{font-size:11px;line-height:1.6;margin:0;padding:12px 25px;color:#6d6254;background:#eee7dc}.lcl-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:30px;padding:25px;overflow:auto;min-height:0;align-items:start;overscroll-behavior:contain}.lcl-detail-visual{position:sticky;top:0;min-width:0}.lcl-detail-image{display:flex;align-items:center;justify-content:center;aspect-ratio:1;background:#fff;border:1px solid #e9e3d9;border-radius:6px;overflow:hidden}.lcl-detail-image img{width:100%;height:100%;object-fit:contain;display:block;padding:15px}.lcl-photo-label{font-size:11px;color:var(--lcl-muted);line-height:1.5;text-align:center;margin:12px 0}.lcl-detail-panel{min-width:0;padding-bottom:12px}.lcl-detail-meta{font-size:12px;color:var(--lcl-muted);margin:0 0 20px;letter-spacing:.02em}.lcl-choices{padding:0;margin:0 0 23px;border:0;min-width:0}.lcl-choices legend{font-size:13px;font-weight:600;margin:0 0 11px;padding:0}.lcl-color-buttons{display:flex;flex-wrap:wrap;gap:7px}.lcl-color-choice{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--lcl-line);border-radius:4px;padding:9px 11px;min-height:43px;color:var(--lcl-ink);font-size:12px;text-align:left;max-width:100%;overflow-wrap:anywhere}.lcl-color-choice[aria-pressed=true]{border-color:#332d24;box-shadow:inset 0 0 0 1px #332d24}.lcl-size-buttons{display:flex;gap:7px;flex-wrap:wrap}.lcl-size{border:1px solid var(--lcl-line);border-radius:4px;background:#fff;color:var(--lcl-ink);padding:10px 13px;min-height:43px;min-width:44px;font-size:12px}.lcl-size[aria-pressed=true]{background:#292725;border-color:#292725;color:#fff}.lcl-size--unavailable:not([aria-pressed=true]){color:#8d8579;background:#f2eee7}.lcl-fact{border-top:1px solid var(--lcl-line);padding-top:15px;margin-top:15px}.lcl-fact h4{font-size:12px;font-weight:600;margin:0 0 7px;font-family:inherit;letter-spacing:normal}.lcl-fact p{font-size:13px;line-height:1.6;margin:0;overflow-wrap:anywhere}.lcl-stock{font-size:12px;line-height:1.6;margin:18px 0 8px}.lcl-regions{font-size:12px;line-height:1.6}.lcl-regions summary{cursor:pointer;padding:6px 0;min-height:30px}.lcl-regions ul{margin:6px 0;padding-left:20px}.lcl-variant-id{font-size:10px;color:#82796c;margin:10px 0}.lcl-model-info{margin-top:22px}.lcl-detail-loading{grid-column:1/-1;padding:30px;font-size:14px;line-height:1.6}.lcl-source-warning{background:#eee7dc;color:#71624f;border-radius:3px;padding:12px;font-size:12px;line-height:1.6}
@media(max-width:1099px){.lcl-audiences{grid-template-columns:repeat(3,minmax(0,1fr))}.lcl-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.lcl-dialog{width:calc(100vw - 28px);height:calc(100dvh - 28px)}.lcl-detail{gap:22px;padding:22px}.lcl-filters{grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)}.lcl-reset{grid-column:2;justify-self:end;padding:2px 0;margin:0;min-height:30px}.lcl-filters{gap:12px}}
@media(max-width:749px){.lcl-catalog{padding:25px 16px 38px}.lcl-header h1{font-size:36px}.lcl-intro{font-size:14px;line-height:1.6}.lcl-notice{font-size:11px;padding:10px 12px;margin:18px 0}.lcl-eyebrow{font-size:10px;margin-bottom:10px}.lcl-audiences{gap:7px}.lcl-audience{padding:11px 10px;min-height:52px;font-size:12px;gap:5px;flex-wrap:wrap}.lcl-audience-count{font-size:10px}.lcl-filters{grid-template-columns:minmax(0,1fr);margin:20px 0 15px;gap:12px}.lcl-reset{grid-column:auto;justify-self:start}.lcl-filter{font-size:11px}.lcl-filter input,.lcl-filter select{font-size:14px}.lcl-result-line{display:block;padding:15px 0}.lcl-results{font-size:12px}.lcl-partial{margin-top:6px}.lcl-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 11px}.lcl-card-image{padding:7px}.lcl-card-copy{padding:11px}.lcl-card h3{font-size:12px;line-height:1.45;margin-bottom:11px}.lcl-brand{font-size:9px;letter-spacing:.04em}.lcl-swatch{width:17px;height:17px}.lcl-card-colors{gap:5px;margin-bottom:7px}.lcl-card-sizes{font-size:10px}.lcl-more{font-size:9px}.lcl-card-cta{font-size:11px;padding:10px 7px}.lcl-pagination{gap:14px;font-size:12px}.lcl-pagination button{padding:11px 13px}.lcl-dialog{inset:0;width:100%;height:100dvh;margin:0;border-radius:0}.lcl-dialog-header{gap:12px;padding:14px 16px}.lcl-dialog-header h2{font-size:16px}.lcl-close{font-size:0;width:44px;padding:8px}.lcl-close::after{content:'×';font-size:25px;line-height:1}.lcl-dialog-notice{padding:10px 16px;font-size:10px}.lcl-detail{grid-template-columns:minmax(0,1fr);padding:16px;gap:18px}.lcl-detail-visual{position:static}.lcl-detail-image{max-height:380px;aspect-ratio:1.15}.lcl-detail-meta{margin-bottom:17px}.lcl-photo-label{font-size:10px}.lcl-color-choice{font-size:11px;padding:9px;min-height:44px}.lcl-size{min-height:44px}.lcl-detail-panel .lcl-swatch{width:19px;height:19px}.lcl-fact p{font-size:12px}}
@media(prefers-reduced-motion:reduce){.lcl-card-image img{transition:none}}
.lcl-catalog{max-width:1600px;padding-top:clamp(35px,5vw,74px);--lcl-paper:#f8f6f2;--lcl-wash:#ebe4da}.lcl-header{max-width:990px;margin-bottom:26px}.lcl-header h1{font-size:clamp(38px,4.8vw,66px);max-width:800px}.lcl-intro{max-width:840px;font-size:16px}.lcl-notice{border:1px solid #ded5c8;border-radius:8px;background:#efe9e0;padding:14px 18px;max-width:none;margin-bottom:30px}.lcl-discovery{padding:24px;border:1px solid #e4ddd3;border-radius:12px;background:#fdfbf8}.lcl-groups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px;margin-bottom:16px}.lcl-group{display:flex;gap:8px;justify-content:space-between;align-items:center;min-width:0;min-height:57px;padding:12px 14px;border:1px solid #dcd4c8;border-radius:6px;background:#fff;color:#302c27;text-align:left;font-size:13px;line-height:1.3}.lcl-group-name{overflow-wrap:anywhere}.lcl-group-count{font-size:11px;font-variant-numeric:tabular-nums;color:#756b5e}.lcl-group[aria-pressed=true]{background:#443c32;color:#fff;border-color:#443c32}.lcl-group[aria-pressed=true] .lcl-group-count{color:#e3d9c9}.lcl-audiences{display:flex;flex-wrap:wrap;gap:7px;margin:0;padding-top:6px}.lcl-audience{display:inline-flex;min-height:38px;padding:8px 13px;font-size:12px;border-radius:30px;justify-content:center;background:transparent}.lcl-audience[aria-pressed=true]{background:#e9e1d5;color:#433a2e;border-color:#d8cbb8}.lcl-filters{grid-template-columns:minmax(170px,1.1fr) minmax(190px,1.3fr) minmax(120px,.8fr) minmax(100px,.6fr);gap:13px;margin-bottom:0}.lcl-filter input,.lcl-filter select{border-radius:5px;font-size:13px}.lcl-reset{grid-column:1/-1;justify-self:start;min-height:32px;font-size:11px;padding:7px 0;margin:0}.lcl-result-line{border:0;padding:24px 0 19px}.lcl-results{font-size:13px;color:#5a5147}.lcl-grid{gap:24px 20px}.lcl-card{border-radius:10px;border-color:#e3dcd1;box-shadow:0 3px 12px #4f3e2510;transition:border-color .2s ease,box-shadow .2s ease}.lcl-card:hover{border-color:#bdad95;box-shadow:0 5px 20px #4f3e2518}.lcl-card-image{aspect-ratio:1;padding:16px;background:#f5f2ed}.lcl-card-copy{padding:17px}.lcl-card h3{font-size:14px;line-height:1.5}.lcl-category-name{font-size:11px;color:#7d684e;margin:0 0 8px;line-height:1.4}.lcl-brand{margin-bottom:6px;font-size:10px}.lcl-card-cta{border-radius:5px;background:#f4efe7;border-color:#dfd4c4;font-weight:500}.lcl-card-cta:hover{background:#e9dfd1}.lcl-card-colors{margin-top:auto;padding-top:2px}.lcl-card-sizes{margin-top:2px}.lcl-dialog{border-radius:12px}.lcl-dialog-header{background:#faf8f4}.lcl-dialog-notice{background:#eee7dc}.lcl-detail-panel{padding-bottom:20px}.lx-category--compact .lxc-collection-heading{padding-top:30px}.lx-category--compact .lxc-grid{border-top:1px solid #ded7cd;padding-top:26px}.lx-category--compact .lxc-collection-heading h2{font-size:clamp(28px,3vw,42px)}
@media(max-width:1099px){.lcl-groups{grid-template-columns:repeat(3,minmax(0,1fr))}.lcl-filters{grid-template-columns:repeat(2,minmax(0,1fr))}.lcl-reset{grid-column:1/-1;justify-self:start}.lcl-discovery{padding:20px}.lcl-grid{gap:20px 15px}}
@media(max-width:749px){.lcl-catalog{padding:30px 16px 38px}.lcl-header h1{font-size:39px;line-height:1.06;margin-bottom:15px}.lcl-intro{font-size:14px;line-height:1.65}.lcl-header{margin-bottom:20px}.lcl-notice{font-size:11px;line-height:1.65;padding:12px 14px;margin:0 0 23px}.lcl-discovery{padding:15px 12px;border-radius:9px}.lcl-audience-label{font-size:12px}.lcl-groups{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-bottom:13px}.lcl-group{font-size:12px;min-height:49px;padding:11px 10px;gap:5px}.lcl-group-count{font-size:10px}.lcl-audiences{gap:6px}.lcl-audience{font-size:11px;min-height:38px;padding:9px 11px}.lcl-filters{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 8px;margin-top:18px}.lcl-filter--search{grid-column:1/-1}.lcl-filter:has([data-lcl-types]){grid-column:1/-1}.lcl-filter input,.lcl-filter select{font-size:16px;min-height:47px;padding:10px}.lcl-filter span{font-size:11px}.lcl-reset{grid-column:1/-1;margin-top:1px;min-height:35px}.lcl-grid{gap:16px 10px}.lcl-card{border-radius:8px}.lcl-card-copy{padding:12px 10px}.lcl-card h3{font-size:12px;line-height:1.5;margin-bottom:12px}.lcl-card-image{padding:9px}.lcl-category-name{font-size:10px;margin-bottom:5px}.lcl-card-cta{font-size:11px;padding:11px 6px;min-height:45px}.lcl-result-line{padding:20px 0 16px}.lcl-dialog{border-radius:0}.lcl-detail-image{max-height:360px;min-height:220px}.lcl-dialog-header h2{font-size:15px}.lcl-detail-panel{padding-bottom:25px}}
@media(prefers-reduced-motion:reduce){.lcl-card{transition:none}}

.lcl-membership-note{margin:13px 0 0;font-size:11px;line-height:1.55;color:#74695b}.lcl-description{border-top:1px solid var(--lcl-line);margin-top:17px;padding-top:5px}.lcl-description summary{font-size:13px;font-weight:500;cursor:pointer;padding:13px 0;min-height:44px}.lcl-description-text{white-space:pre-line;font-size:12px;line-height:1.75;overflow-wrap:anywhere}.lcl-option-reference{margin:12px 0 17px}.lcl-option-reference h4{font-family:inherit;font-size:12px;font-weight:500;margin:0 0 7px}.lcl-option-reference p{font-size:11px;line-height:1.65;margin:0;overflow-wrap:anywhere}

.lcl-mobile-group{display:none}@media(max-width:749px){.lcl-mobile-group{display:grid;gap:7px;font-size:12px;font-weight:500;margin-bottom:14px}.lcl-mobile-group select{width:100%;min-width:0;min-height:49px;background:#fff;color:#302c27;border:1px solid #d7cbb9;border-radius:5px;padding:10px;font-size:16px}.lcl-groups{display:none}.lcl-discovery>.lcl-audience-label{display:none}}

.lcl-shop-price{background:#f0e9de;border:1px solid #dfd4c2;padding:15px 16px;border-radius:7px;margin:0 0 23px}.lcl-price-label{font-size:11px;color:#6d6050;margin:0 0 6px}.lcl-retail-price{font-size:24px;line-height:1.3;color:#30291f;margin:0 0 8px;font-weight:600}.lcl-price-pending{font-size:13px;line-height:1.6;margin:0;color:#574b3b}.lcl-shop-product-link{font-size:12px;color:#51432f;text-underline-offset:3px;line-height:1.6}.lcl-shop-price .lcl-small{font-size:10px;margin:9px 0 0;color:#756958}.lcl-material-select{display:block;width:100%;max-width:100%;min-width:0;border:1px solid #cfc3b2;border-radius:5px;min-height:48px;padding:11px;background:#fff;color:#342c22;font:inherit;font-size:13px}.lcl-material-live{font-size:11px;line-height:1.6;color:#6c5b42;margin:8px 0}.lcl-material-live:empty{display:none}.lcl-dialog select:focus-visible{outline:2px solid #63584a;outline-offset:3px}@media(max-width:749px){.lcl-material-select{font-size:16px}.lcl-shop-price{padding:13px}.lcl-retail-price{font-size:22px}}

.lcl-shop-offer-label{display:grid;gap:7px;font-size:12px;margin:12px 0}.lcl-shop-offer-select{display:block;min-width:0;max-width:100%;width:100%;min-height:46px;padding:10px;border:1px solid #c8bba8;border-radius:5px;background:#fff;color:#342c22;font:inherit;font-size:12px}@media(max-width:749px){.lcl-shop-offer-select{font-size:16px}}

.lx-review-badge{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font-size:11px;line-height:1.5;color:#75644e;margin:9px 0 12px}.lx-review-badge[hidden]{display:none!important}.lx-review-stars{flex-shrink:0;display:inline-block}.lcl-shop-price .lx-review-badge{font-size:11px;margin-bottom:0}

.lcl-active-filters{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:12px 0 0;font-size:12px}.lcl-active-filters[hidden]{display:none}.lcl-active-label{color:#625a50}.lcl-filter-chip{padding:5px 9px;background:#e9e3d9;border-radius:999px;color:#38332d;overflow-wrap:anywhere}.lcl-global-search{margin:0 0 20px}.lcl-global-search[hidden]{display:none}


/* Original self-design cover images, kept separate from catalogue variants. */
.lcl-header--with-cover{max-width:none;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:center;gap:clamp(24px,4vw,56px)}
.lcl-header-copy{min-width:0}
.lcl-cover-images{display:grid;grid-template-columns:1.35fr 1fr;grid-template-rows:1fr 1fr;gap:14px;aspect-ratio:1.1;min-width:0}
.lcl-cover-image{background:#eeeae3;position:relative;display:flex;overflow:hidden;align-items:center;justify-content:center;min-width:0;min-height:0;border-radius:4px;color:inherit;text-decoration:none}
.lcl-cover-image--1{grid-row:span 2}
.lcl-cover-image img{width:100%;height:100%;object-fit:contain;display:block;padding:14px}
.lcl-cover-image span{position:absolute;left:16px;right:16px;bottom:12px;font-size:11px;line-height:1.4;color:#49453f;background:rgba(250,248,244,.94);padding:5px 7px;border-radius:2px;overflow-wrap:anywhere}
.lcl-cover-image:focus-visible{outline:2px solid #63584a;outline-offset:4px}
@media(max-width:900px){.lcl-header--with-cover{grid-template-columns:minmax(0,1fr);gap:24px}.lcl-cover-images{aspect-ratio:1.45;gap:10px;max-width:640px;width:100%}.lcl-cover-image img{padding:9px}.lcl-cover-image span{font-size:9px;left:8px;right:8px;bottom:8px;padding:3px 5px}}

.lcl-subcategories{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 0}.lcl-subcategory{min-height:44px;border:1px solid #d8cdbd;border-radius:999px;background:#fff;color:#403629;padding:9px 14px;font:inherit;font-size:13px;line-height:1.35;max-width:100%;overflow-wrap:anywhere}.lcl-subcategory--back{background:#eee6da}.lcl-filter--sort{grid-column:1/-1;max-width:330px}.lcl-detail-thumbnails{display:flex;gap:9px;overflow-x:auto;overscroll-behavior-inline:contain;padding:10px 2px 5px;scrollbar-width:thin}.lcl-detail-thumbnail{flex:0 0 76px;width:76px;height:80px;border:1px solid #d8cdbd;border-radius:7px;background:#fff;padding:4px}.lcl-detail-thumbnail[aria-pressed=true]{border-color:#3c3225;box-shadow:inset 0 0 0 1px #3c3225}.lcl-detail-thumbnail img{width:100%;height:100%;object-fit:contain;display:block}.lcl-card h3{font-size:16px}.lcl-filter span{font-size:13px}.lcl-size{font-size:14px}.lcl-color-choice{font-size:14px}@media(max-width:749px){.lcl-subcategories{flex-wrap:nowrap;overflow-x:auto;padding-bottom:7px;scrollbar-width:thin}.lcl-subcategory{flex:0 0 auto;max-width:85%;font-size:13px}.lcl-filter--sort{grid-column:1/-1;max-width:none}.lcl-card h3{font-size:14px}.lcl-detail-thumbnail{flex-basis:64px;width:64px;height:68px}.lcl-size,.lcl-color-choice{font-size:14px}}
