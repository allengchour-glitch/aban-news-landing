{%- comment -%}
  LuxeStyle 26.10.2026: Video-Zeile (TikTok / YouTube).
  Daten auf der Startseite: Shop-Metafeld luxe.videos (Typ json), Liste von
  {plattform, titel, url, vorschau}, neueste zuerst.
  Gepflegt wird es von automation/videos_zeile.mjs (Trockenlauf Vorgabe, LIVE=1 schreibt).
  Produktseiten lesen ausschliesslich product.metafields.luxe.video_url (Typ url), falls vorhanden.
  Die globale Shop-Liste wird dort bewusst nicht gelesen oder an das Snippet weitergegeben.
  Ist keine gültige Karte da, gibt der Abschnitt NICHTS aus. Rücknahme: Abschnitt aus templates/index.json und
  templates/product.json entfernen (oder im Theme-Editor löschen).
{%- endcomment -%}

{%- liquid
  assign lx_liste = null
  assign lx_globale_liste_erlaubt = false
  assign lx_produkt_video = null

  if request.page_type == 'index' or template.name == 'index'
    assign lx_liste = shop.metafields.luxe.videos.value
    assign lx_globale_liste_erlaubt = true
  endif

  if product != blank
    assign lx_produkt_video = product.metafields.luxe.video_url.value
  endif
-%}
{%- if lx_liste.size > 0 or lx_produkt_video != blank -%}
  <div class="lx-videos-abschnitt" {{ section.shopify_attributes }}>
    {%- render 'luxe-videos-zeile',
      liste: lx_liste,
      erstes_url: lx_produkt_video,
      globale_liste_erlaubt: lx_globale_liste_erlaubt,
      ueberschrift: section.settings.heading,
      maximal: section.settings.max_items,
      abstand_oben: section.settings.padding_top,
      abstand_unten: section.settings.padding_bottom,
      schluessel: section.id
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "LuxeStyle Videos",
  "tag": "section",
  "class": "section-luxe-videos",
  "enabled_on": {
    "templates": ["index", "product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Auf der Startseite zeigt dieser Abschnitt die globale Liste aus luxe.videos. Auf Produktseiten erscheint ausschliesslich das explizit am Produkt hinterlegte Metafeld luxe.video_url; globale Videos werden dort nie ergänzt. Ist keine passende Quelle vorhanden, erscheint nichts."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Videos"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximale Anzahl",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "LuxeStyle Videos",
      "category": "Medien"
    }
  ]
}
{% endschema %}
