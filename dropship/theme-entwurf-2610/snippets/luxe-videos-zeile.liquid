{%- doc -%}
  LuxeStyle 26.10.2026: Video-Zeile mit waagrecht scrollbaren Karten im Hochformat 9:16
  (4 sichtbar auf dem Desktop, 1,3 auf dem Handy; scroll-snap). Gibt NICHTS aus (nicht einmal CSS),
  solange keine einzige gültige Karte entsteht, also kein leerer Kasten bei leerem Metafeld.

  @param {array} [liste] - Einträge {plattform, titel, url, vorschau}, neueste zuerst (aus shop.metafields.luxe.videos)
  @param {string} [erstes_url] - Video, das zuerst stehen soll (z. B. product.metafields.luxe.video_url)
  @param {string} [ueberschrift] - Titel der Zeile
  @param {number} [maximal] - höchstens so viele Karten (4 bis 12)
  @param {number} [abstand_oben] - Abstand oberhalb der Zeile in px (nur wenn die Zeile erscheint)
  @param {number} [abstand_unten] - Abstand unterhalb der Zeile in px (nur wenn die Zeile erscheint)
  @param {string} [schluessel] - eindeutige Kennung (Abschnitts-ID) für das Beschriftungs-Attribut

  @example
  {% render 'luxe-videos-zeile', liste: shop.metafields.luxe.videos.value, ueberschrift: 'Videos', maximal: 8, schluessel: section.id %}
{%- enddoc -%}

{%- liquid
  assign lx_max = maximal | default: 8 | plus: 0
  if lx_max < 1
    assign lx_max = 8
  endif
  assign lx_anzahl = 0
  assign lx_erste = erstes_url | strip
  assign lx_gesehen = '|'

  capture lx_karten
    # 1) das Video dieses Produkts zuerst; Titel/Vorschau aus der Liste, wenn dieselbe Adresse dort steht
    if lx_erste != blank
      assign lx_e_titel = null
      assign lx_e_bild = null
      for lx_v in liste
        if lx_v.url == lx_erste and lx_e_titel == blank
          assign lx_e_titel = lx_v.titel
          assign lx_e_bild = lx_v.vorschau
        endif
      endfor
      assign lx_e_titel = lx_e_titel | default: 'Video zu diesem Artikel'
      capture lx_eine
        render 'luxe-video-karte', url: lx_erste, titel: lx_e_titel, vorschau: lx_e_bild
      endcapture
      assign lx_eine_roh = lx_eine | strip
      if lx_eine_roh != blank
        echo lx_eine_roh
        assign lx_anzahl = lx_anzahl | plus: 1
        assign lx_gesehen = lx_gesehen | append: lx_erste | append: '|'
      endif
    endif

    # 2) die Liste, ohne Dubletten und ohne das schon gezeigte Video
    for lx_v in liste
      if lx_anzahl >= lx_max
        break
      endif
      assign lx_marke = '|' | append: lx_v.url | append: '|'
      if lx_gesehen contains lx_marke
        continue
      endif
      capture lx_karte
        render 'luxe-video-karte', url: lx_v.url, titel: lx_v.titel, vorschau: lx_v.vorschau
      endcapture
      assign lx_karte_roh = lx_karte | strip
      if lx_karte_roh != blank
        echo lx_karte_roh
        assign lx_anzahl = lx_anzahl | plus: 1
        assign lx_gesehen = lx_gesehen | append: lx_v.url | append: '|'
      endif
    endfor
  endcapture
-%}
{%- if lx_anzahl > 0 -%}
  <div
    class="lx-vid"
    data-lx-videos
    style="padding-block: {{ abstand_oben | default: 0 | plus: 0 }}px {{ abstand_unten | default: 0 | plus: 0 }}px;"
  >
    <style>
      .lx-vid {
        --lx-vid-gap: 12px;
        max-width: min(var(--page-width, 1400px), 100%);
        margin: 0 auto;
        padding-inline: var(--page-margin, 1rem);
        position: relative;
      }
      .lx-vid__kopf { margin: 0 0 12px; }
      .lx-vid__kopf h2 { margin: 0; }
      .lx-vid__spur {
        display: flex;
        gap: var(--lx-vid-gap);
        margin: 0;
        padding: 0 0 8px;
        list-style: none;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
      }
      .lx-vid__item {
        flex: 0 0 calc((100% - 3 * var(--lx-vid-gap)) / 4);
        min-width: 0;
        scroll-snap-align: start;
      }
      .lx-vid__karte {
        position: relative;
        display: block;
        aspect-ratio: 9 / 16;
        overflow: hidden;
        border-radius: 14px;
        background: linear-gradient(160deg, #2b2620, #14110e);
        color: #fff;
        text-decoration: none;
      }
      .lx-vid__bild {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s ease;
      }
      .lx-vid__karte::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, .74) 0%, rgba(0, 0, 0, 0) 52%);
        pointer-events: none;
      }
      .lx-vid__karte:hover .lx-vid__bild,
      .lx-vid__karte:focus-visible .lx-vid__bild { transform: scale(1.04); }
      .lx-vid__karte:focus-visible { outline: 3px solid var(--color-foreground, #111); outline-offset: 2px; }
      .lx-vid__plattform {
        position: absolute;
        z-index: 2;
        top: 10px;
        left: 10px;
        padding: 3px 9px;
        border-radius: 999px;
        background: rgba(0, 0, 0, .62);
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      .lx-vid__play {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        width: 48px;
        height: 48px;
        margin: -24px 0 0 -24px;
        line-height: 0;
      }
      .lx-vid__titel {
        position: absolute;
        z-index: 2;
        left: 12px;
        right: 12px;
        bottom: 12px;
        font-size: 14px;
        line-height: 1.35;
        font-weight: 600;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .lx-vid__pfeil {
        position: absolute;
        z-index: 3;
        top: calc(50% + 14px);
        width: 40px;
        height: 40px;
        margin-top: -20px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: var(--color-background, #fff);
        color: var(--color-foreground, #111);
        box-shadow: 0 2px 10px rgba(0, 0, 0, .25);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        display: flex;
      }
      .lx-vid__pfeil[hidden] { display: none; }
      .lx-vid__pfeil--zurueck { left: calc(var(--page-margin, 1rem) - 8px); }
      .lx-vid__pfeil--weiter { right: calc(var(--page-margin, 1rem) - 8px); }
      @media (hover: none) { .lx-vid__pfeil { display: none; } }
      @media (max-width: 749px) {
        .lx-vid__item { flex-basis: calc((100% - var(--lx-vid-gap)) / 1.3); }
        .lx-vid__titel { font-size: 13px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .lx-vid__bild { transition: none; }
        .lx-vid__karte:hover .lx-vid__bild { transform: none; }
      }
    </style>
    <div class="lx-vid__kopf">
      <h2 class="h3" id="lx-vid-titel-{{ schluessel }}">{{ ueberschrift | default: 'Videos' | escape }}</h2>
    </div>
    <ul class="lx-vid__spur" role="list" aria-labelledby="lx-vid-titel-{{ schluessel }}">
      {{- lx_karten -}}
    </ul>
    <button type="button" class="lx-vid__pfeil lx-vid__pfeil--zurueck" aria-label="Zurück blättern" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button type="button" class="lx-vid__pfeil lx-vid__pfeil--weiter" aria-label="Weiter blättern" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <script>
      (function () {
        var wurzeln = document.querySelectorAll('.lx-vid[data-lx-videos]:not([data-lx-init])');
        for (var i = 0; i < wurzeln.length; i++) {
          (function (w) {
            w.setAttribute('data-lx-init', '1');
            var spur = w.querySelector('.lx-vid__spur');
            var knoepfe = w.querySelectorAll('.lx-vid__pfeil');
            if (!spur || knoepfe.length < 2) return;
            var ruhig = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            function aktualisieren() {
              var rest = spur.scrollWidth - spur.clientWidth - 2;
              knoepfe[0].hidden = spur.scrollLeft <= 2;
              knoepfe[1].hidden = spur.scrollLeft >= rest;
            }
            function blaettern(richtung) {
              spur.scrollBy({ left: richtung * spur.clientWidth * 0.9, behavior: ruhig ? 'auto' : 'smooth' });
            }
            knoepfe[0].addEventListener('click', function () { blaettern(-1); });
            knoepfe[1].addEventListener('click', function () { blaettern(1); });
            spur.addEventListener('scroll', aktualisieren, { passive: true });
            window.addEventListener('resize', aktualisieren);
            aktualisieren();
          })(wurzeln[i]);
        }
      })();
    </script>
  </div>
{%- endif -%}
