dia.com/kf/A0de68c09f2fd40fb852d275a442e0840k.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/A461d08c947ec4f08b21c428b67cc8731p.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/A461d08c947ec4f08b21c428b67cc8731p.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/A461d08c947ec4f08b21c428b67cc8731p.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/A461d08c947ec4f08b21c428b67cc8731p.jpg"}]},{"uuid":"28ae4b08-1abb-4af7-9033-8aba0534e0d0","reviewer_name":"Jamie Pagac","reviewer_initial":"J","title":"","body_html":"<p>Nice watch, just as described, small, but since it's 36 mm I thought it would look less non-pulsive, but it turned out great. It doesn't disappear on the wrist.</p>","verified_buyer":false,"location":"","video_external_ids":[],"media_platform_hosted_video_infos":[],"cf_answers":[],"rating":"5","created_at":"2026-03-05 00:00:00 UTC","pictures_urls":[{"original":"https://ae-pic-a1.aliexpress-media.com/kf/Af44e95affed3428eab5fc93d819654deL.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/Af44e95affed3428eab5fc93d819654deL.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/Af44e95affed3428eab5fc93d819654deL.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/Af44e95affed3428eab5fc93d819654deL.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/A049e6ee1b1854447a48744e87e4c3a73S.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/A049e6ee1b1854447a48744e87e4c3a73S.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/A049e6ee1b1854447a48744e87e4c3a73S.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/A049e6ee1b1854447a48744e87e4c3a73S.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/Aeecdddcf6ab8490ab1916d91233ab395d.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/Aeecdddcf6ab8490ab1916d91233ab395d.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/Aeecdddcf6ab8490ab1916d91233ab395d.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/Aeecdddcf6ab8490ab1916d91233ab395d.jpg"}]},{"uuid":"ea341ad9-4f12-4c1f-bc38-e82a3b0f21cf","reviewer_name":"Joan Mann","reviewer_initial":"J","title":"","body_html":"<p>Very good value for money, and I was able to easily remove the stem to take out the dial and install a logo. The whole thing works well. There are no issues with the date wheel, which rotates easily.</p>","verified_buyer":false,"location":"","video_external_ids":[],"media_platform_hosted_video_infos":[],"cf_answers":[],"rating":"5","created_at":"2026-03-04 00:00:00 UTC","pictures_urls":[{"original":"https://ae-pic-a1.aliexpress-media.com/kf/Ad66558c6a94b4d54ab5bab43a405b0b9C.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/Ad66558c6a94b4d54ab5bab43a405b0b9C.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/Ad66558c6a94b4d54ab5bab43a405b0b9C.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/Ad66558c6a94b4d54ab5bab43a405b0b9C.jpg"}]}],"review_summary_text":"Based on 15 reviews","ai_summary_text":"","sort_key":"created_at","multi_language_sorting_enabled":false,"metafield_updated_at":"2026-05-28T15:16:12Z","reviews":[{"uuid":"e67223e2-298a-46bf-90b2-2c9b1e03e3d1","title":"","rating":5,"body_html":"<p>Absolute home run. This 36mm 316l stainless piece features a stunning sunray blue dial, sapphire glass, a crisp screw-down crown, and a beautiful polished center executive bracelet with a milled butterfly clasp. Out of the box, it comfortably fits my 9\" wrist with zero pins removed—i just shifted 3 links to the long side for a perfect balance. \n<br /> \n<br /> ​ The factory sunon sp28 provides a beautiful mechanical sweep seconds, so i am leaving it in for now. However, the dial feet position confirms this platform is 100% compatible with a miyota 2350. Having already executed this exact drop-in swap on my white version, i can verify it is a seamless mechanical upgrade path. My only minute qc observation is a microscopically misaligned date bubble, but it is so slight that no one else would ever notice. High-tier value for watch builders!</p>","body":"Absolute home run. This 36mm 316l stainless piece features a stunning sunray blue dial, sapphire glass, a crisp screw-down crown, and a beautiful polished center executive bracelet with a milled butterfly clasp. Out of the box, it comfortably fits my 9\" wrist with zero pins removed—i just shifted 3 links to the long side for a perfect balance. \n \n ​ The factory sunon sp28 provides a beautiful mechanical sweep seconds, so i am leaving it in for now. However, the dial feet position confirms this platform is 100% compatible with a miyota 2350. Having already executed this exact drop-in swap on my white version, i can verify it is a seamless mechanical upgrade path. My only minute qc observation is a microscopically misaligned date bubble, but it is so slight that no one else would ever notice. High-tier value for watch builders!","verified_buyer":false,"created_at":"2026-05-27T00:00:00.000Z","reviewer_name":"Royce Hills","reviewer_initial":"R","is_anonymous_reviewer":false,"cf_answers":[],"reply_content":null,"pictures_urls":[{"original":"https://ae-pic-a1.aliexpress-media.com/kf/A8915b18705bf44a19b7c2807fa3ee9cdi.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/A8915b18705bf44a19b7c2807fa3ee9cdi.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/A8915b18705bf44a19b7c2807fa3ee9cdi.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/A8915b18705bf44a19b7c2807fa3ee9cdi.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/Adf08619ce1e04e1d86fe737b211fd05b6.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/Adf08619ce1e04e1d86fe737b211fd05b6.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/Adf08619ce1e04e1d86fe737b211fd05b6.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/Adf08619ce1e04e1d86fe737b211fd05b6.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/A4217de0cc1524a76a7d885403144d9082.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/A4217de0cc1524a76a7d885403144d9082.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/A4217de0cc1524a76a7d885403144d9082.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/A4217de0cc1524a76a7d885403144d9082.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/A1c43df0f23064056b54c9cf636895999J.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/A1c43df0f23064056b54c9cf636895999J.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/A1c43df0f23064056b54c9cf636895999J.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/A1c43df0f23064056b54c9cf636895999J.jpg"},{"original":"https://ae-pic-a1.aliexpress-media.com/kf/Aa9b14ffc870f4118b4c3735ecd55225eD.jpg","small":"https://ae-pic-a1.aliexpress-media.com/kf/Aa9b14ffc870f4118b4c3735ecd55225eD.jpg","compact":"https://ae-pic-a1.aliexpress-media.com/kf/Aa9b14ffc870f4118b4c3735ecd55225eD.jpg","huge":"https://ae-pic-a1.aliexpress-media.com/kf/Aa9b14ffc870f4118b4c3735ecd55225eD.jpg"}],"video_external_ids":[],"thumb_up":0,"thumb_down":0,"location_country":"","location_country_code":"","location":"","source":null,"product_title":"Klassische Herrenuhren Edelstahl · Saphirglas, 50m wasserdicht","encoded_product_id":"D74b8OkN","encoded_shop_id":"rDGl38ly","is_shopify_lite":false,"product_url":"/products/edelstahl-uhr-herren-klassisch","product_url_with_utm":"https://luxestyle.ch/products/edelstahl-uhr-herren-klassisch?jdgm_referral_location=widget&ref=judge.me&utm_campaign=judgeme-review-site&utm_medium=referral&utm_source=judgeme","product_in_store":true,"product_variant_title":"","profile_img_idx":0,"avatar_image_url":null,"gravatar_hash":null,"media_platform_hosted_video_infos":[],"country_code_show_flag":null,"pinned":null,"in_a_group":false,"can_pin":true,"shop_reply_name":"LuxeStyle CH","transparency_badges":["review_collected_from_another_provider"],"language":null,"is_for_product_from_group":false,"product_variant_image_url":"https://cdn.shopify.com/s/files/1/0943/6856/3585/files/S3fd1754a28234ac4b0838d54ea43c29cx.webp?v=177981174