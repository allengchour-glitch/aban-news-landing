{%- comment -%}
  LuxeStyle Scroll-Geschichte 2.0 (15.11.2026). Neue Datei, ändert nichts Bestehendes.
  Angeheftete Bühne (sticky) mit einem stummen Video je Kapitel. Beim Scrollen zoomt und schwenkt der Hintergrund, das nächste
  Kapitel schiebt sich als Vorhang von unten herein, darüber Text mit Parallaxe und je Kapitel eine Kaufkarte.
  Wahrheit (fail closed): ein Kapitel erscheint nur, wenn Produkt aktiv, im Onlineshop sichtbar und die eingestellte Ausführung
  kaufbar ist, Poster und Videos von cdn.shopify.com stammen und sein Ablaufdatum («bis») nicht vorbei ist.
  Preis und Titel kommen live aus dem Shop. Weniger als zwei Kapitel: nichts.
  Stil: {% stylesheet %} unten (Shopify lädt ihn im <head>), nicht als <style> im <body>.
  Rücknahme: Abschnitt aus der Vorlage entfernen. Doku: scratchpad/story1511/BERICHT.md.
{%- endcomment -%}
{%- liquid
  assign fr = false
  if request.locale.iso_code == 'fr'
    assign fr = true
  endif
  assign cdn = 'https://cdn.shopify.com/'
  assign heute = 'now' | date: '%Y%m%d' | plus: 0
  assign zahl = 0
  assign okliste = '|'
  assign gruende = ''
  for block in section.blocks
    assign p = block.settings.produkt
    assign ok = true
    if p == blank or p.available == false
      assign ok = false
      assign gruende = gruende | append: ' ' | append: block.id | append: ':produkt'
    endif
    assign vid = block.settings.variante | plus: 0
    assign v = nil
    if ok
      for x in p.variants
        if x.id == vid
          assign v = x
        endif
      endfor
      if v == nil or v.available == false
        assign ok = false
        assign gruende = gruende | append: ' ' | append: block.id | append: ':ausfuehrung'
      endif
    endif
    assign pq = block.settings.poster_quer | default: ''
    assign ph = block.settings.poster_hoch | default: ''
    unless pq contains cdn and ph contains cdn
      assign ok = false
      assign gruende = gruende | append: ' ' | append: block.id | append: ':poster'
    endunless
    assign bis = block.settings.bis | default: '' | remove: '-' | remove: '.' | strip | plus: 0
    if bis > 0 and heute > bis
      assign ok = false
      assign gruende = gruende | append: ' ' | append: block.id | append: ':abgelaufen'
    endif
    if ok
      assign zahl = zahl | plus: 1
      assign okliste = okliste | append: block.id | append: '|'
    endif
  endfor
  assign sid = section.id | replace: '_', '-'
-%}
{%- if zahl < 2 -%}
  <!-- lx-story: aus ({{ zahl }} Kapitel;{{ gruende }}) -->
  <script>(function(){var p=document.querySelector('.lx-story-platzhalter');if(p&&p.parentNode)p.parentNode.removeChild(p)})();</script>
{%- else -%}
<script src="{{ 'lx-story.js' | asset_url }}" defer></script>
<section class="lx-story" id="lx-story-{{ sid }}" data-lx-story data-platz="{{ section.settings.platz | escape }}" aria-labelledby="lx-story-titel-{{ sid }}">
  <a class="lx-story__skip" href="#lx-story-ende-{{ sid }}">{% if fr %}Passer l’histoire{% else %}Geschichte überspringen{% endif %}</a>
  <h2 class="lx-story__titel" id="lx-story-titel-{{ sid }}">{% if fr %}{{ section.settings.titel_fr | escape }}{% else %}{{ section.settings.titel | escape }}{% endif %}</h2>
  <div class="lx-story__buehne">
    <div class="lx-story__medien" aria-hidden="true">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign nadel = '|' | append: block.id | append: '|' -%}
        {%- if okliste contains nadel -%}
          {%- liquid
            assign pq = block.settings.poster_quer
            assign ph = block.settings.poster_hoch
            assign vq = block.settings.video_quer | default: ''
            assign vh = block.settings.video_hoch | default: ''
            unless vq contains cdn and vh contains cdn
              assign vq = ''
              assign vh = ''
            endunless
          -%}
          <div class="lx-story__ebene" data-i="{{ n }}"{% if n == 0 %} data-aktiv data-sicht{% endif %} style="--lx-fq:{{ block.settings.fokus_quer | default: '50% 50%' | escape }};--lx-fh:{{ block.settings.fokus_hoch | default: '50% 30%' | escape }}">
            <picture>
              {%- if n == 0 -%}
              <source media="(max-width: 749px)" srcset="{{ ph | escape }}" type="image/webp">
              <img class="lx-story__poster" src="{{ pq | escape }}" alt="" width="1440" height="1080" loading="lazy" decoding="async">
              {%- else -%}
              <source media="(max-width: 749px)" data-srcset="{{ ph | escape }}" type="image/webp">
              <img class="lx-story__poster" data-src="{{ pq | escape }}" alt="" width="1440" height="1080" decoding="async">
              {%- endif -%}
            </picture>
            {%- if vq != '' -%}
            <video class="lx-story__video" muted playsinline loop preload="none" disablepictureinpicture disableremoteplayback tabindex="-1" data-vq="{{ vq | escape }}" data-vh="{{ vh | escape }}"></video>
            {%- endif -%}
          </div>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="lx-story__schleier" aria-hidden="true"></div>
  </div>
  <div class="lx-story__steuer">
    <div class="lx-story__fortschritt" aria-hidden="true"><span></span></div>
    <nav class="lx-story__punkte" aria-label="{% if fr %}Chapitres{% else %}Kapitel{% endif %}">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign nadel = '|' | append: block.id | append: '|' -%}
        {%- if okliste contains nadel -%}
          {%- if fr -%}{%- assign wort = block.settings.wort_fr | default: block.settings.wort -%}{%- else -%}{%- assign wort = block.settings.wort -%}{%- endif -%}
          <a href="#lx-story-{{ sid }}-k{{ n }}" data-i="{{ n }}"{% if n == 0 %} aria-current="step"{% endif %}><span>{{ n | plus: 1 }}. {{ wort | escape }}</span></a>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <button type="button" class="lx-story__pause" aria-pressed="false" data-an="{% if fr %}Arrêter le mouvement{% else %}Bewegung anhalten{% endif %}" data-aus="{% if fr %}Reprendre le mouvement{% else %}Bewegung fortsetzen{% endif %}" hidden><svg class="lx-story__pause-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="lx-story__i-pause" d="M8 5v14M16 5v14"/><path class="lx-story__i-play" d="M7 5l12 7-12 7z"/></svg><span class="lx-story__pause-text">{% if fr %}Arrêter le mouvement{% else %}Bewegung anhalten{% endif %}</span></button>
  </div>
  {%- assign n = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign nadel = '|' | append: block.id | append: '|' -%}
    {%- if okliste contains nadel -%}
    {%- liquid
      assign p = block.settings.produkt
      assign vid = block.settings.variante | plus: 0
      assign v = nil
      for x in p.variants
        if x.id == vid
          assign v = x
        endif
      endfor
      assign pq = block.settings.poster_quer
      assign ph = block.settings.poster_hoch
      if fr
        assign wort = block.settings.wort_fr | default: block.settings.wort
        assign zeile = block.settings.zeile_fr | default: block.settings.zeile
      else
        assign wort = block.settings.wort
        assign zeile = block.settings.zeile
      endif
      assign bild = v.featured_image | default: p.featured_image
      assign letzte = zahl | minus: 1
    -%}
    <div class="lx-story__kapitel" id="lx-story-{{ sid }}-k{{ n }}" data-i="{{ n }}"{% if n == letzte %} data-letztes{% endif %} {{ block.shopify_attributes }}>
      <picture class="lx-story__still" aria-hidden="true">
        <source media="(max-width: 749px)" srcset="{{ ph | escape }}" type="image/webp">
        <img src="{{ pq | escape }}" alt="" width="1440" height="1080" loading="lazy" decoding="async">
      </picture>
      <div class="lx-story__text">
        <p class="lx-story__nr"><span>{{ n | plus: 1 | prepend: '0' | slice: -2, 2 }}</span> / {{ zahl | prepend: '0' | slice: -2, 2 }}</p>
        <h3 class="lx-story__wort">{{ wort | escape }}</h3>
        <p class="lx-story__zeile">{{ zeile | escape }}</p>
      </div>
      <a class="lx-story__karte" href="{{ v.url }}" data-produkt="{{ p.handle | escape }}" data-variante="{{ v.id }}">
        <span class="lx-story__karte-bild">{%- if bild != blank -%}{{ bild | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '96px', alt: '' }}{%- endif -%}</span>
        <span class="lx-story__karte-text">
          <span class="lx-story__karte-titel">{{ p.title | escape }}</span>
          {%- if block.settings.variante_zeigen != false and v.title != 'Default Title' -%}<span class="lx-story__karte-var">{{ v.title | escape }}</span>{%- endif -%}
          <span class="lx-story__karte-preis">{{ v.price | money_with_currency }}</span>
          <span class="lx-story__karte-cta">{% if fr %}Voir le produit{% else %}Produkt ansehen{% endif %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span>
        </span>
      </a>
    </div>
    {%- assign n = n | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  <span class="lx-story__ende" id="lx-story-ende-{{ sid }}" tabindex="-1"></span>
</section>
<script>(function(){var s=document.currentScript,w=s&&s.closest('.shopify-section');if(!w)return;{%- if section.settings.platz == 'nach_hero' and template.name == 'index' -%}var p=document.querySelector('.lx-story-platzhalter'),h=document.querySelector('.lx-home .lx-hero');if(p&&p.parentNode){p.parentNode.replaceChild(w,p)}else if(h&&h.parentNode&&h.nextSibling!==w){h.parentNode.insertBefore(w,h.nextSibling)}w.setAttribute('data-lx-story-platz','nach-hero');{%- else -%}w.setAttribute('data-lx-story-platz','eigener');{%- endif -%}})();</script>
{%- endif -%}

{% stylesheet %}
.lx-story{--lx-story-kopf:88px;--lx-oben:var(--lx-story-kopf);--lx-bg:#110e0b;--lx-creme:#faf7f2;position:relative;isolation:isolate;background:var(--lx-bg);color:var(--lx-creme);font-family:var(--lx-sans,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);margin:0;overflow:clip}
@media (hover:none) and (pointer:coarse){.lx-story{--lx-story-kopf:59px}}
.lx-story .lx-story__titel{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.lx-story .lx-story__skip{position:absolute;left:16px;top:100px;z-index:6;transform:translateY(-300%);background:var(--lx-creme);color:#292722;padding:12px 18px;border-radius:999px;font-size:14px;text-decoration:underline}
.lx-story .lx-story__skip:focus{transform:none}
.lx-story .lx-story__ende{display:block;height:0;outline:0}
.lx-story.lx-story :focus-visible{outline:3px solid #f2d6a2;outline-offset:4px}
.lx-story .lx-story__buehne{position:sticky;top:0;height:100vh;height:100svh;margin-bottom:-100vh;margin-bottom:-100svh;overflow:hidden;z-index:0;background:var(--lx-bg)}
.lx-story .lx-story__medien{position:absolute;right:0;top:0;height:calc(100% - var(--lx-oben));transform:translate3d(0,var(--lx-oben),0);width:min(100%,calc((100vh - 88px) * 4 / 3));width:min(100%,calc((100svh - 88px) * 4 / 3));overflow:hidden;background:var(--lx-bg)}
.lx-story .lx-story__ebene{position:absolute;inset:0;overflow:hidden;visibility:hidden;box-shadow:0 -46px 90px rgba(0,0,0,.6);will-change:transform}
.lx-story .lx-story__ebene[data-sicht]{visibility:visible}
.lx-story .lx-story__ebene picture{display:block;position:absolute;inset:0}
.lx-story .lx-story__ebene img,.lx-story .lx-story__ebene video{position:absolute;left:0;top:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:var(--lx-fq,50% 50%);transform:scale(1.23);transform-origin:50% 50%;will-change:transform;background:var(--lx-bg)}
.lx-story .lx-story__ebene video{opacity:0;transition:opacity .5s ease}
.lx-story .lx-story__ebene video[data-spielt]{opacity:1}
.lx-story .lx-story__medien::after{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,var(--lx-bg) 0%,rgba(17,14,11,.62) 13%,rgba(17,14,11,0) 32%)}
.lx-story .lx-story__schleier{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(14,11,8,.55) 0%,rgba(14,11,8,.38) 30%,rgba(14,11,8,0) 52%),linear-gradient(0deg,rgba(14,11,8,.5) 0%,rgba(14,11,8,0) 28%)}
.lx-story .lx-story__steuer{position:sticky;top:0;height:100vh;height:100svh;margin-bottom:-100vh;margin-bottom:-100svh;z-index:3;pointer-events:none}
.lx-story .lx-story__punkte,.lx-story .lx-story__fortschritt{transition:opacity .4s ease,visibility 0s linear 0s}
.lx-story[data-ende] .lx-story__punkte,.lx-story[data-ende] .lx-story__fortschritt{opacity:0;visibility:hidden;transition:opacity .4s ease,visibility 0s linear .4s}
.lx-story .lx-story__fortschritt{position:absolute;left:0;right:0;top:0;height:2px;transform:translate3d(0,var(--lx-oben),0);background:rgba(250,247,242,.14)}
.lx-story .lx-story__fortschritt span{display:block;height:100%;width:100%;background:#d8c6a6;transform:scaleX(0);transform-origin:0 50%;will-change:transform}
.lx-story .lx-story__punkte{position:absolute;right:clamp(14px,2.4vw,40px);top:50%;transform:translate3d(0,calc(-50% + var(--lx-oben) / 2),0);display:flex;flex-direction:column;gap:6px;pointer-events:auto}
.lx-story .lx-story__punkte a{display:flex;align-items:center;justify-content:flex-end;gap:12px;min-width:44px;min-height:32px;color:var(--lx-creme);text-decoration:none}
.lx-story .lx-story__punkte a span{font-size:12px;letter-spacing:.06em;opacity:0;transform:translateX(6px);transition:opacity .3s,transform .3s;white-space:nowrap;padding:4px 10px;border-radius:999px;background:rgba(17,14,11,.72)}
.lx-story .lx-story__punkte a::after{content:'';flex:0 0 auto;width:8px;height:8px;border-radius:50%;border:1px solid rgba(250,247,242,.9);background:rgba(17,14,11,.35);box-shadow:0 0 0 1px rgba(17,14,11,.35);transition:transform .3s,background .3s}
.lx-story .lx-story__punkte a[aria-current]::after{background:var(--lx-creme);transform:scale(1.5)}
.lx-story .lx-story__punkte a[aria-current] span,.lx-story .lx-story__punkte a:hover span,.lx-story .lx-story__punkte a:focus-visible span{opacity:1;transform:none}
.lx-story .lx-story__pause{position:absolute;right:clamp(16px,2.4vw,40px);top:0;transform:translate3d(0,calc(var(--lx-oben) + 18px),0);display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px 8px 12px;border-radius:999px;border:1px solid rgba(250,247,242,.4);background:rgba(17,14,11,.6);color:var(--lx-creme);font-size:13px;line-height:1;cursor:pointer;pointer-events:auto;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.lx-story .lx-story__pause:hover{background:rgba(17,14,11,.85)}
.lx-story .lx-story__pause-icon{width:18px;height:18px;flex:0 0 18px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.lx-story .lx-story__i-play{display:none;fill:currentColor;stroke:none}
.lx-story .lx-story__pause[aria-pressed="true"] .lx-story__i-play{display:inline}
.lx-story .lx-story__pause[aria-pressed="true"] .lx-story__i-pause{display:none}
.lx-story .lx-story__punkte a,.lx-story .lx-story__pause{scroll-margin-top:110px;scroll-margin-bottom:110px}
.lx-story .lx-story__kapitel{position:relative;z-index:1;min-height:135vh;min-height:135svh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:clamp(28px,6vh,64px);padding:calc(88px + 22vh) clamp(22px,5.5vw,96px) 22vh;pointer-events:none}
.lx-story .lx-story__kapitel[data-i="0"]{padding-top:calc(88px + 30vh)}
.lx-story .lx-story__kapitel[data-letztes]{min-height:115vh;min-height:115svh;padding-bottom:8vh}
.lx-story .lx-story__still{display:none}
.lx-story .lx-story__text{max-width:min(600px,42vw);will-change:transform,opacity}
.lx-story .lx-story__nr{margin:0 0 14px;font-size:12px;line-height:1.4;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:#e3d3b6}
.lx-story .lx-story__nr span{color:var(--lx-creme)}
.lx-story .lx-story__wort{margin:0;font-family:var(--lx-serif,'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif);font-weight:400;font-size:clamp(60px,7.8vw,132px);line-height:.95;letter-spacing:-.035em;color:var(--lx-creme);text-shadow:0 2px 30px rgba(0,0,0,.35);transform-origin:0 100%;will-change:transform}
.lx-story .lx-story__zeile{margin:18px 0 0;max-width:30ch;font-size:clamp(17px,1.35vw,21px);line-height:1.5;color:#f1e9dd;text-shadow:0 1px 12px rgba(0,0,0,.5)}
.lx-story .lx-story__karte{pointer-events:auto;display:flex;align-items:center;gap:16px;width:min(400px,100%);padding:12px 18px 12px 12px;border-radius:18px;background:rgba(250,247,242,.97);color:#292722;text-decoration:none;box-shadow:0 22px 60px rgba(0,0,0,.38);transition:box-shadow .25s ease,background .25s ease;will-change:transform}
.lx-story .lx-story__karte:hover{background:#fff;box-shadow:0 26px 70px rgba(0,0,0,.48)}
.lx-story .lx-story__karte-bild{flex:0 0 96px;width:96px;height:96px;border-radius:12px;overflow:hidden;background:#efe9df}
.lx-story .lx-story__karte-bild img{width:100%;height:100%;max-width:none;object-fit:cover}
.lx-story .lx-story__karte-text{display:flex;flex-direction:column;min-width:0;gap:2px}
.lx-story .lx-story__karte-titel{font-size:15px;line-height:1.35;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.lx-story .lx-story__karte-var{font-size:12px;line-height:1.4;color:#5f574d}
.lx-story .lx-story__karte-preis{margin-top:4px;font-size:16px;font-weight:600;color:#292722}
.lx-story .lx-story__karte-cta{display:inline-flex;align-items:center;gap:6px;margin-top:4px;font-size:13px;text-decoration:underline;text-underline-offset:3px;color:#4b4339}
.lx-story .lx-story__karte-cta svg{width:16px;height:16px;stroke:currentColor;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:749px){
.lx-story{--lx-story-kopf:59px}
.lx-story .lx-story__medien{left:0;width:100%;height:min(calc(100vw * 4 / 3),calc(100% - var(--lx-oben) - 150px))}
.lx-story .lx-story__medien::after{display:none}
.lx-story .lx-story__ebene img,.lx-story .lx-story__ebene video{object-position:var(--lx-fh,50% 30%)}
.lx-story .lx-story__ebene::after{content:'';position:absolute;left:0;right:0;bottom:0;height:34%;background:linear-gradient(180deg,rgba(17,14,11,0) 0%,rgba(17,14,11,.72) 62%,var(--lx-bg) 100%);pointer-events:none}
.lx-story .lx-story__schleier{background:linear-gradient(180deg,rgba(14,11,8,.3) 0%,rgba(14,11,8,0) 18%)}
.lx-story .lx-story__kapitel{min-height:125vh;min-height:125svh;justify-content:flex-end;padding:calc(59px + 100vw) 16px calc(25vh + 8px);gap:14px}
.lx-story .lx-story__kapitel[data-i="0"]{padding-top:calc(59px + 100vw)}
.lx-story .lx-story__kapitel[data-letztes]{min-height:110vh;min-height:110svh;padding-bottom:calc(16vh + 8px)}
.lx-story .lx-story__text{max-width:none;width:100%;padding:0 4px}
.lx-story .lx-story__nr{margin-bottom:8px}
.lx-story .lx-story__wort{font-size:clamp(44px,13vw,60px);text-shadow:0 2px 18px rgba(0,0,0,.6)}
.lx-story .lx-story__zeile{font-size:16px;margin-top:8px;text-shadow:0 1px 10px rgba(0,0,0,.75)}
.lx-story .lx-story__karte{width:100%;gap:12px;padding:8px 14px 8px 8px;border-radius:14px}
.lx-story .lx-story__karte-bild{flex-basis:64px;width:64px;height:64px;border-radius:10px}
.lx-story .lx-story__karte-titel{font-size:14px;-webkit-line-clamp:1}
.lx-story .lx-story__karte-preis{margin-top:2px;font-size:15px}
.lx-story .lx-story__karte-cta{margin-top:2px}
.lx-story .lx-story__punkte{top:0;right:6px;transform:translate3d(0,calc(var(--lx-oben) + 14px),0);gap:0}
.lx-story .lx-story__punkte a{min-height:28px;min-width:40px}
.lx-story .lx-story__punkte a span{display:none}
.lx-story .lx-story__pause{left:10px;right:auto;bottom:auto;top:0;transform:translate3d(0,calc(var(--lx-oben) + 10px),0);min-height:40px;width:40px;padding:0;justify-content:center;gap:0}
.lx-story .lx-story__pause-text{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.lx-story .lx-story__punkte a,.lx-story .lx-story__pause{scroll-margin-top:80px;scroll-margin-bottom:110px}
}
@media (prefers-reduced-motion:reduce){
.lx-story .lx-story__buehne,.lx-story .lx-story__steuer{display:none}
.lx-story .lx-story__kapitel,.lx-story .lx-story__kapitel[data-i="0"],.lx-story .lx-story__kapitel[data-letztes]{min-height:0;display:grid;padding:0 0 48px;gap:20px;pointer-events:auto}
.lx-story .lx-story__still{display:block;position:relative;grid-row:1;grid-column:1}
.lx-story .lx-story__still img{display:block;width:100%;height:auto;max-width:none;aspect-ratio:4/3;object-fit:cover}
.lx-story .lx-story__text{grid-row:1;grid-column:1;align-self:end;max-width:none;margin:0;padding:24px clamp(18px,4vw,64px) 28px;transform:none!important;opacity:1!important;background:linear-gradient(180deg,rgba(17,14,11,0),rgba(17,14,11,.86) 45%)}
.lx-story .lx-story__wort{transform:none!important}
.lx-story .lx-story__karte{margin:0 clamp(16px,4vw,64px);transform:none!important}
.lx-story .lx-story__wort{font-size:clamp(48px,7vw,96px)}
}
@media (prefers-reduced-motion:reduce) and (max-width:749px){
.lx-story .lx-story__still img{aspect-ratio:3/4}
.lx-story .lx-story__text{border-radius:0}
.lx-story .lx-story__karte{width:auto}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Scroll-Geschichte",
  "tag": "div",
  "class": "lx-story-abschnitt",
  "settings": [
    { "type": "select", "id": "platz", "label": "Platz", "default": "nach_hero", "options": [ { "value": "nach_hero", "label": "Direkt nach dem Hero" }, { "value": "eigener", "label": "An eigener Stelle" } ] },
    { "type": "text", "id": "titel", "label": "Unsichtbarer Titel (Bildschirmleser)", "default": "Sechs Kapitel aus unserem Sortiment" },
    { "type": "text", "id": "titel_fr", "label": "Titel französisch", "default": "Six chapitres de notre sélection" }
  ],
  "blocks": [
    {
      "type": "kapitel",
      "name": "Kapitel",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "wort", "label": "Grosses Wort" },
        { "type": "text", "id": "zeile", "label": "Kurze Zeile (keine Preise, Rabatte, Lieferzeiten, Wirkversprechen)" },
        { "type": "text", "id": "wort_fr", "label": "Wort französisch" },
        { "type": "text", "id": "zeile_fr", "label": "Zeile französisch" },
        { "type": "product", "id": "produkt", "label": "Produkt" },
        { "type": "text", "id": "variante", "label": "Ausführung (Varianten-ID, muss kaufbar sein)" },
        { "type": "checkbox", "id": "variante_zeigen", "label": "Ausführung in der Karte nennen", "default": true },
        { "type": "text", "id": "bis", "label": "Sichtbar bis (JJJJ-MM-TT, leer = immer)" },
        { "type": "text", "id": "video_quer", "label": "Video quer (cdn.shopify.com)" },
        { "type": "text", "id": "video_hoch", "label": "Video hoch (cdn.shopify.com)" },
        { "type": "text", "id": "poster_quer", "label": "Poster quer WebP (cdn.shopify.com)" },
        { "type": "text", "id": "poster_hoch", "label": "Poster hoch WebP (cdn.shopify.com)" },
        { "type": "text", "id": "fokus_quer", "label": "Bildausschnitt quer (object-position)", "default": "50% 50%" },
        { "type": "text", "id": "fokus_hoch", "label": "Bildausschnitt hoch (object-position)", "default": "50% 30%" }
      ]
    }
  ],
  "presets": [ { "name": "Scroll-Geschichte" } ]
}
{% endschema %}
