{{ 'luxe-clothing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luxe-product-reviews.js' | asset_url }}" defer></script>
<script src="{{ 'luxe-clothing.js' | asset_url }}" defer></script>
<section class="lcl-catalog" data-luxe-clothing aria-labelledby="LuxeClothingTitle-{{ section.id }}">
  {%- capture cover_images -%}{%- render 'luxe-selfdesign-cover' -%}{%- endcapture -%}
  {%- assign cover_images = cover_images | strip -%}
  <header class="lcl-header{% if cover_images != blank %} lcl-header--with-cover{% endif %}">
    <div class="lcl-header-copy">
      <p class="lcl-eyebrow">{{ 'luxe_clothing.eyebrow' | t }}</p>
      <h1 id="LuxeClothingTitle-{{ section.id }}">{{ 'luxe_clothing.heading' | t }}</h1>
      <p class="lcl-intro">{{ 'luxe_clothing.intro' | t }}</p>
    </div>
    {{ cover_images }}
  </header>
  <p class="lcl-notice">{{ 'luxe_clothing.notice' | t }}</p>
  <div class="lcl-discovery">
    <p class="lcl-audience-label" id="LuxeClothingGroups-{{ section.id }}">{{ 'luxe_clothing.category_label' | t }}</p>
    <label class="lcl-mobile-group"><span>{{ 'luxe_clothing.category_label' | t }}</span><select data-lcl-group-select><option value="all">{{ 'luxe_clothing.all_categories' | t }}</option></select></label>
    <nav class="lcl-groups" data-lcl-groups aria-labelledby="LuxeClothingGroups-{{ section.id }}"></nav>
    <div class="lcl-audiences" role="group" aria-label="{{ 'luxe_clothing.special_selection' | t }}">
      <button type="button" class="lcl-audience" data-lcl-audience="all" aria-pressed="true"><span>{{ 'luxe_clothing.all' | t }}</span></button>
      <button type="button" class="lcl-audience" data-lcl-category-shortcut="202" aria-pressed="false" disabled><span>{{ 'luxe_clothing.sticker_shortcut' | t }}</span></button>
      <button type="button" class="lcl-audience" data-lcl-audience="baby" aria-pressed="false"><span>{{ 'luxe_clothing.baby' | t }}</span></button>
      <button type="button" class="lcl-audience" data-lcl-audience="unisex" aria-pressed="false"><span>{{ 'luxe_clothing.unisex' | t }}</span></button>
    </div>
    <nav class="lcl-subcategories" data-lcl-subcategories aria-label="{{ 'luxe_clothing.type' | t }}" hidden></nav>
    <p class="lcl-unisex-hint" data-lcl-unisex-hint hidden>{{ 'luxe_clothing.unisex_hint' | t }}</p>
    <div class="lcl-filters">
      <label class="lcl-filter lcl-filter--search"><span>{{ 'luxe_clothing.search' | t }}</span><input type="search" data-lcl-search placeholder="{{ 'luxe_clothing.search_placeholder' | t }}" autocomplete="off"></label>
      <label class="lcl-filter"><span>{{ 'luxe_clothing.type' | t }}</span><select data-lcl-types><option value="">{{ 'luxe_clothing.all_types' | t }}</option></select></label>
      <label class="lcl-filter"><span>{{ 'luxe_clothing.color' | t }}</span><select data-lcl-color-filter><option value="">{{ 'luxe_clothing.all_colors' | t }}</option></select></label>
      <label class="lcl-filter"><span>{{ 'luxe_clothing.size' | t }}</span><select data-lcl-size-filter><option value="">{{ 'luxe_clothing.all_sizes' | t }}</option></select></label>
      <label class="lcl-filter lcl-filter--sort"><span>{{ 'luxe_clothing.sort_label' | t }}</span><select data-lcl-sort><option value="catalog">{{ 'luxe_clothing.sort_catalog' | t }}</option><option value="name_asc">{{ 'luxe_clothing.sort_name_asc' | t }}</option><option value="name_desc">{{ 'luxe_clothing.sort_name_desc' | t }}</option><option value="variants_desc">{{ 'luxe_clothing.sort_variants' | t }}</option></select></label>
      <button type="button" class="lcl-reset" data-lcl-reset>{{ 'luxe_clothing.reset' | t }}</button>
    </div>
    <div class="lcl-active-filters" data-lcl-active-filters hidden></div>
    <p class="lcl-membership-note">{{ 'luxe_clothing.membership_note' | t }}</p>
  </div>
  <div class="lcl-result-line"><p class="lcl-results" data-lcl-results tabindex="-1" aria-live="polite"></p><p class="lcl-partial" data-lcl-partial hidden>{{ 'luxe_clothing.partial' | t }}</p></div>
  <p class="lcl-message" data-lcl-message role="status">{{ 'luxe_clothing.loading' | t }}</p>
  <button type="button" class="lcl-button lcl-global-search" data-lcl-global-search hidden>{{ 'luxe_clothing.global_search' | t }}</button>
  <button type="button" class="lcl-button" data-lcl-retry hidden>{{ 'luxe_clothing.retry' | t }}</button>
  <div class="lcl-grid" data-lcl-grid aria-busy="false"></div>
  <div class="lcl-pagination" data-lcl-pagination hidden>
    <button type="button" data-lcl-previous>{{ 'luxe_clothing.previous' | t }}</button>
    <span data-lcl-page aria-live="polite"></span>
    <button type="button" data-lcl-next>{{ 'luxe_clothing.next' | t }}</button>
  </div>
  <noscript><p>{{ 'luxe_clothing.no_javascript' | t }}</p></noscript>
  <dialog class="lcl-dialog" data-lcl-dialog aria-labelledby="LuxeClothingDetailTitle-{{ section.id }}">
    <header class="lcl-dialog-header"><h2 id="LuxeClothingDetailTitle-{{ section.id }}" data-lcl-detail-title></h2><button type="button" class="lcl-close" data-lcl-close aria-label="{{ 'luxe_clothing.close' | t }}">{{ 'luxe_clothing.close' | t }}</button></header>
    <p class="lcl-dialog-notice">{{ 'luxe_clothing.notice' | t }}</p>
    <div class="lcl-detail" data-lcl-detail></div>
  </dialog>
  <script type="application/json" data-lcl-config>
  {
    "locale": {{ request.locale.iso_code | json }},
    "presentationAsset": {{ 'luxe-clothing-reference-gallery.json' | asset_url | json }},
