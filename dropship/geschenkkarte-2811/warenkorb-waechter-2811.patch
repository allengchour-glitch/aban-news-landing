diff --git a/automation/warenkorb_gutschein_snapshot_test.py b/automation/warenkorb_gutschein_snapshot_test.py
new file mode 100644
--- /dev/null
+++ b/automation/warenkorb_gutschein_snapshot_test.py
@@ -0,0 +1,75 @@
+"""Offline-Regression anhand des verifizierten Storefront-Themes 214565814663 vom 28.11.2026."""
+import hashlib
+from pathlib import Path
+
+import bw_warenkorb_hinweis_2711 as bw
+import theme_attrappe as ta
+import warenkorb_einig as einig
+import warenkorb_gratisversand as versand
+
+
+def digest(raw):
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def prueflauf(raw):
+    theme = "gid://shopify/OnlineStoreTheme/214565814663"
+    # Der Test übt nur den Hinweis und den Aufseher aus. Tarif und Produktstichprobe
+    # sind hier Attrappen und treffen keine Aussage zum aktuellen Shopify-Tarif.
+    with ta.ersetzt((versand, "live_theme", lambda: theme), (versand, "theme_datei", lambda _: ("MAIN", raw)),
+                    (versand, "tarif", lambda: (versand.VERSAND, versand.SCHWELLE_TECHNIK)),
+                    (versand, "chlager_pruefen", lambda *_: [])):
+        rc, zeile, _ = ta.lauf(versand.pruefen)
+        return rc, ta.aufseher(zeile, ta.reiz("warenkorb_gratisversand.py"))
+
+
+def test_snapshot():
+    basis = (Path(__file__).resolve().parents[1] / "theme_backup/snippets__cart-summary.liquid.vor-bw-hinweis-2711").read_text()
+    with ta.ohne_netz():
+        live = bw.einfuegen(basis)
+        assert digest(live) == "fbad4dc6c91607c567467286af44c142f6154d3c4e0fd4a4e1bdd6e2eb83f969"
+        assert prueflauf(live) == (1, "MELDEN")
+        assert versand.einfuegen_plan(live)[0] is None
+        assert versand.block_ersetzen(live)[0] is None
+        assert bw.entfernen(live) == basis
+
+        # Der Vorschau-Export behielt die kürzeren historischen Kommentare des Shops bei.
+        # Alle ausführbaren Liquid-Zeilen stammen aus der gemeinsamen Generatorvorlage.
+        start, ende = versand.block_finden(basis)
+        kommentare = iter(versand._KOMMENTAR.findall(basis[start:ende]))
+        block = versand._KOMMENTAR.sub(lambda _: next(kommentare), versand.BLOCK)
+        assert next(kommentare, None) is None
+        ohne_aktion = basis[:start] + block + basis[ende:]
+        vorschau = bw.einfuegen(ohne_aktion)
+        assert digest(vorschau) == "c08ae7795f054c32ef7d7678a3c8e0bb882c0666bc560acb991f72c724c32954"
+        for quelle in (ohne_aktion, vorschau):
+            assert prueflauf(quelle) == (0, "STILL")
+            assert versand.block_ersetzen(quelle) == (None, "schon Soll")
+            assert versand.einfuegen_plan(quelle)[0] is None
+        assert bw.entfernen(vorschau) == ohne_aktion
+        assert bw.einfuegen(vorschau) == vorschau
+
+        unbekannt = vorschau.replace("lux_bw_an -%}", "lux_bw_an and andere_aktion -%}")
+        assert prueflauf(unbekannt) == (1, "MELDEN")
+        assert versand.block_ersetzen(unbekannt)[0] is None
+        try:
+            bw.entfernen(unbekannt)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("Unbekannte Kampagne würde entfernt")
+
+        for quelle in (live, vorschau, unbekannt):
+            # Der zweite Wächter bietet bei fehlender eigener Marke eine Reparatur an.
+            # Sein echter Planer muss fremde Kampagnen sowie alle weiteren Theme-Dateien erhalten.
+            ohne_zweitmarke = quelle.replace(einig.MARKE, "umbenannter Kommentar")
+            assert einig.MARKE not in ohne_zweitmarke
+            muster = {"layout/theme.liquid": einig.MARKE, "templates/cart.json": einig.MARKE,
+                      versand.DATEI: ohne_zweitmarke}
+            assert einig.plane_aus(muster)[0] == {}
+            assert versand.block_ersetzen(ohne_zweitmarke)[0] is None
+
+
+if __name__ == "__main__":
+    test_snapshot()
+    print("Warenkorb-Snapshot bestanden: Live- und Vorschau-SHA, beide Wächter, unbekannte Aktion und Wiederholung.")
