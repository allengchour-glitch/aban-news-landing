{% liquid
  assign lx_standard_home = false
  if template.name == 'index' and template.suffix == blank
    assign lx_standard_home = true
  endif
%}
<script src="{{ 'luxe-product-reviews.js' | asset_url }}" defer></script>
{% assign lx_locale_root = routes.root_url | append: '/' | replace: '//', '/' %}
{% assign lx_design_url = lx_locale_root | append: 'collections/selbst-gestalten-1?view=luxe-gestalten' %}
{% assign lx_beauty_scene = 'https://cdn.shopify.com/s/files/1/0943/6856/3585/files/luxestyle-kategorie-beauty-f7c9d32db796-20261101.png?v=1793569453' %}
{% assign lx_sport_scene = 'https://cdn.shopify.com/s/files/1/0943/6856/3585/files/luxestyle-kategorie-sport-7fe1761f704f-20261101.png?v=1793569453' %}

{% style %}
  /* One still campaign image. The modifier also outranks the older hero asset rules. */
  .lx-home .lx-background-hero.lx-campaign-hero {
    min-block-size: clamp(600px, 73svh, 820px);
    background: var(--lx-ink);
    color: var(--lx-cream);
  }
  .lx-home .lx-campaign-hero__media {
    --lx-campaign-object-position: var(--lx-campaign-focus, 50% 40%);
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .lx-home .lx-campaign-hero__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--lx-campaign-object-position);
  }
  .lx-home .lx-background-hero.lx-campaign-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(18 15 11 / .84) 0%, rgb(18 15 11 / .67) 31%, rgb(18 15 11 / .17) 63%, rgb(18 15 11 / .025) 100%);
  }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy {
    position: relative;
    z-index: 2;
    inline-size: min(76%, 960px);
    min-inline-size: 0;
    min-block-size: inherit;
    justify-content: center;
    padding: clamp(40px, 5.5vw, 88px);
    background: transparent;
    color: var(--lx-cream);
  }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow {
    color: var(--lx-cream);
    font-size: 11px;
    letter-spacing: .19em;
  }
  .lx-home .lx-background-hero.lx-campaign-hero h1 {
    max-inline-size: 100%;
    margin: 24px 0;
    color: var(--lx-cream);
    font-size: clamp(64px, 7.4vw, 116px);
    line-height: 1;
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .lx-home .lx-background-hero.lx-campaign-hero h1 em { color: #e9d7ba; }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description {
    max-inline-size: 38ch;
    color: var(--lx-cream);
    font-size: 16px;
    line-height: 1.65;
  }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-actions { margin-block-start: 30px; gap: 14px 22px; }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-button {
    min-block-size: 54px;
    padding: 16px 22px;
    border-color: var(--lx-cream);
    border-radius: 12px;
    background: var(--lx-cream);
    color: var(--lx-ink) !important;
    font-size: 13px;
  }
  .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { color: var(--lx-cream); font-size: 13px; }
  .lx-home .lx-background-hero.lx-campaign-hero a:focus-visible {
    outline: 3px solid var(--lx-cream);
    outline-offset: 5px;
    box-shadow: 0 0 0 7px var(--lx-ink);
  }
  @media (min-width: 761px) and (max-width: 1050px) {
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy { inline-size: 86%; padding: 48px; }
    .lx-home .lx-background-hero.lx-campaign-hero h1 { font-size: clamp(58px, 7.2vw, 76px); }
  }
  @media (max-width: 760px) {
    .lx-home .lx-background-hero.lx-campaign-hero { min-block-size: clamp(490px, calc(100svh - 330px), 600px); }
    .lx-home .lx-campaign-hero__media { --lx-campaign-object-position: var(--lx-campaign-mobile-x, 65%) 40%; }
    .lx-home .lx-background-hero.lx-campaign-hero::before {
      background: linear-gradient(180deg, rgb(18 15 11 / .02) 0%, rgb(18 15 11 / .08) 25%, rgb(18 15 11 / .42) 44%, rgb(18 15 11 / .9) 70%, rgb(18 15 11 / .98) 100%);
    }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy {
      inline-size: 100%;
      justify-content: flex-end;
      padding: 180px 24px 28px;
    }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow { font-size: 9px; letter-spacing: .16em; }
    .lx-home .lx-background-hero.lx-campaign-hero h1 { margin: 14px 0 16px; font-size: clamp(35px, 10vw, 54px); letter-spacing: -.04em; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description { font-size: 14px; line-height: 1.6; max-inline-size: 37ch; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-actions { gap: 10px 14px; margin-block-start: 22px; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-button { min-block-size: 50px; padding: 14px 16px; gap: 16px; font-size: 12px; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { min-block-size: 48px; gap: 8px; font-size: 12px; }
  }
  @media (max-width: 359px) {
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy { padding-inline: 18px; }
    .lx-home .lx-background-hero.lx-campaign-hero h1 { font-size: 33px; }
  }
  @media (forced-colors: active) {
    .lx-home .lx-background-hero.lx-campaign-hero { background: Canvas; color: CanvasText; }
    .lx-home .lx-background-hero.lx-campaign-hero::before { display: none; }
    .lx-home .lx-campaign-hero__media { display: none; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-copy,
    .lx-home .lx-background-hero.lx-campaign-hero h1,
    .lx-home .lx-background-hero.lx-campaign-hero h1 em,
    .lx-home .lx-background-hero.lx-campaign-hero .lx-eyebrow,
    .lx-home .lx-background-hero.lx-campaign-hero .lx-hero-description,
    .lx-home .lx-background-hero.lx-campaign-hero .lx-text-link { color: CanvasText; }
    .lx-home .lx-background-hero.lx-campaign-hero .lx-button { background: ButtonFace; border-color: ButtonText; color: ButtonText !important; }
  }

  .lx-home .lx-scroll-root {
    display: block;
    min-inline-size: 0;
    padding-block-start: 20px;
  }
  .lx-home .lx-scroll-root .lx-scroll-hero { margin-block-start: 0; }
  .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero {
    display: flex;
    isolation: isolate;
  }
  .lx-home .lx-scroll-hero .lx-campaign-hero__media { pointer-events: none; }
  .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero .lx-hero-copy {
    inline-size: min(59%, 790px);
    padding-inline: clamp(28px, 4.8vw, 76px);
  }
  .lx-home .lx-scroll-hero__video {
    position: absolute; inset: 0; inline-size: 100%; block-size: 100%;
    object-fit: cover; object-position: var(--lx-campaign-object-position); opacity: 0; background: var(--lx-ink);
  }
  .lx-home .lx-scroll-root[data-has-frame] .lx-scroll-hero__video { opacity: 1; }
  .lx-home .lx-campaign-hero__media picture { display: contents; }
  @media (prefers-reduced-motion: no-preference) {
    .lx-home .lx-scroll-root[data-has-frame] .lx-scroll-hero__video { transition: opacity .35s ease; }
  }
  .lx-home .lx-scroll-hero__controls {
    position: absolute; z-index: 4; inset-block-start: 18px; inset-inline-start: 18px;
    display: block;
    max-inline-size: calc(100% - 36px); padding: 8px 12px;
    border: 1px solid var(--lx-line); border-radius: 14px;
    background: var(--lx-cream); color: var(--lx-ink); font-size: 12px; line-height: 1.4;
  }
  .lx-home .lx-scroll-hero__controls[hidden] { display: none; }
  .lx-home .lx-scroll-hero__controls:not([hidden]):not(:focus-within) {
    inline-size: 1px; block-size: 1px; padding: 0; border: 0;
    overflow: hidden; clip-path: inset(50%); pointer-events: none;
  }
  .lx-home .lx-scroll-hero__controls button {
    min-block-size: 44px; min-inline-size: 44px;
    padding: 8px 12px; border: 1px solid var(--lx-ink); border-radius: 8px;
    color: var(--lx-ink); background: var(--lx-cream);
  }
  @media (min-width: 761px) {
    .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero .lx-hero-copy { padding-block-start: 140px; padding-block-end: 60px; }
    .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero h1 { font-size: clamp(52px, 5.1vw, 84px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lx-home .lx-scroll-hero__controls button { transition: transform 120ms cubic-bezier(.16, 1, .3, 1); }
    .lx-home .lx-scroll-hero__controls button:active { transform: scale(.97); }
  }
  @media (max-width: 760px) {
    .lx-home .lx-scroll-root { padding-block-start: 16px; }
    .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero {
      min-block-size: clamp(440px, calc(100svh - 240px), 560px);
    }
    .lx-home .lx-background-hero.lx-campaign-hero.lx-scroll-hero .lx-hero-copy {
      inline-size: 100%;
      justify-content: flex-end;
      padding: 96px 24px 32px;
    }
    .lx-home .lx-scroll-hero__controls { inset-block-start: 12px; inset-inline-start: 12px; max-inline-size: calc(100% - 24px); }
  }
  @media (prefers-reduced-motion: reduce), (forced-colors: active) {
    .lx-home .lx-scroll-hero__video { display: none; }
    .lx-home .lx-scroll-hero__controls { display: none; }
  }
  @media (min-width: 761px) {
    #lx-worlds.lx-worlds--photo-grid .lx-category-tile::after {
      background: linear-gradient(180deg, transparent 41%, rgb(41 39 34 / 16%) 52%, rgb(41 39 34 / 66%) 69%, var(--lx-ink) 100%);
    }
    #lx-worlds.lx-worlds--photo-grid .lx-category-name {
      text-shadow: 0 1px 6px rgb(24 21 18 / 65%);
    }
  }
  @media (max-width: 760px) {
    #lx-worlds .lx-section-heading > p { display: none; }
  }
  .lx-home .lx-product-spotlight .lx-more-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .lx-home .lx-product-spotlight .lx-more-image { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .lx-home .lx-product-spotlight .lx-more-image img {
    position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: contain;
  }
  .lx-home .lx-product-spotlight .lx-more-open { margin-block-start: auto; }
  @media (max-width: 340px) {
    .lx-home .lx-product-spotlight .lx-more-grid { grid-template-columns: minmax(0, 1fr); }
  }
{% endstyle %}
{% comment %}LCP 23.11.2026: Auf dem Handy blendet clip-path die unteren 15 % des Videos aus (dort deckt der Verlauf zu 94 bis 98 %). So ist das Video nie grösser als das Kampagnenbild und löst es nicht als LCP-Element ab, auch wenn der Hero unten über den Bildschirmrand reicht (z. B. 360 px breite Handys). Layout und Bildausschnitt des Videos bleiben gleich. Rückbau: diesen Block entfernen.{% endcomment %}
<style>@media (max-width: 760px){.lx-home .lx-scroll-root .lx-scroll-hero__video{clip-path:inset(0 0 15% 0)}}</style>
<div class="lx-home lx-browse-home" id="lx-top">
  {% unless lx_standard_home %}
  <a class="lx-skip" href="#lx-content">{{ 'luxe_home.zum_inhalt_f0521' | t }}</a>
  <div class="lx-announcement">{{ 'luxe_home.gratisversand_in_der_schweiz_ab__9a8a6' | t }} <a href="{{ lx_locale_root }}pages/versand-lieferung">{{ 'luxe_home.versandinfos_87cfe' | t }} <span aria-hidden="true"><svg class="lx-arrow" viewbox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a></div>
  <header class="lx-header">
    <button class="lx-icon-button lx-mobile-menu" type="button" data-open="lx-menu" aria-label="{{ 'luxe_home.men_ffnen_ac3b2' | t | escape }}" aria-haspopup="dialog"><svg viewbox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
    <a href="{{ lx_locale_root }}" class="lx-wordmark" aria-label="{{ 'luxe_home.luxestyle_startseite_184ed' | t | escape }}">{{ 'luxe_home.luxestyle_9ae01' | t }}<span>{{ 'luxe_home.ch_20daa' | t }}</span></a>
    <nav class="lx-nav" aria-label="{{ 'luxe_home.hauptnavigation_e8fc6' | t | escape }}">
      <a class="lx-design-nav" href="{{ lx_design_url }}">{{ 'luxe_home.design.title' | t }}</a>
      <a href="{{ lx_locale_root }}collections/damen-mode">{{ 'luxe_home.mode_5e23e' | t }}</a><a href="{{ lx_locale_root }}collections/wohnen-dekoration">{{ 'luxe_home.wohnen_49bf1' | t }}</a><a href="{{ lx_locale_root }}collections/geschenke-unter-50-franken">{{ 'luxe_home.geschenkideen_6ad8d' | t }}</a><a href="{{ lx_locale_root }}pages/alle-kategorien">{{ 'luxe_home.alle_kategorien_5ed9a' | t }}</a>
    </nav>
    <div class="lx-tools">
      <button class="lx-icon-button" type="button" data-open="lx-search" aria-label="{{ 'luxe_home.suche_ffnen_28121' | t | escape }}" aria-haspopup="dialog"><svg viewbox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
      <a class="lx-icon-button lx-account" href="https://account.luxestyle.com.co" aria-label="{{ 'luxe_home.kundenkonto_15592' | t | escape }}"><svg viewbox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.5" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></a>
      <a class="lx-icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'luxe_home.warenkorb_d6de3' | t | escape }}"><svg viewbox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></a>
    </div>
  </header>
  {% endunless %}
  {% if lx_standard_home %}<div id="lx-content">{% else %}<main id="lx-content">{% endif %}
    {% comment %}The background film is loaded by the player when the hero is in view.{% endcomment %}
    {% liquid
      assign lx_campaign_image = section.settings.hero_campaign_image
      assign lx_campaign_video = section.settings.hero_scroll_video
      assign lx_campaign_mobile_still = nil
      assign lx_scroll_source = nil
      assign lx_scroll_mobile_source = nil
      assign lx_scroll_url = nil
      assign lx_scroll_mobile_url = nil
      if section.settings.hero_scroll_enabled and lx_campaign_image != blank and lx_campaign_video != blank
        for lx_source in lx_campaign_video.sources
          if lx_source.format == 'mp4' and lx_source.width <= 1920
            if lx_scroll_source == blank or lx_source.width > lx_scroll_source.width
              assign lx_scroll_source = lx_source
            endif
            if lx_source.width <= 1280
              if lx_scroll_mobile_source == blank or lx_source.width > lx_scroll_mobile_source.width
                assign lx_scroll_mobile_source = lx_source
              endif
            endif
          endif
        endfor
      endif
      if section.settings.hero_scroll_enabled and lx_campaign_image != blank
        assign lx_scroll_url = section.settings.hero_scroll_desktop_url | default: lx_scroll_source.url
        assign lx_scroll_mobile_url = section.settings.hero_scroll_mobile_url | default: lx_scroll_mobile_source.url
        if section.settings.hero_scroll_mobile_url != blank
          assign lx_campaign_mobile_still = section.settings.hero_campaign_mobile_image
        endif
        assign lx_scroll_width = lx_scroll_source.width
        assign lx_scroll_height = lx_scroll_source.height
        if section.settings.hero_scroll_desktop_url != blank
          assign lx_scroll_width = 1920
          assign lx_scroll_height = 2160
        endif
      endif
    %}
    {% if lx_scroll_url != blank %}
      <script type="module" src="{{ 'luxe-scroll-hero.js' | asset_url }}"></script>
      <luxe-scroll-hero class="lx-scroll-root" tabindex="-1"
        data-hold-label="{{ 'luxe_home.hero.pause' | t | escape }}"
        data-resume-label="{{ 'luxe_home.hero.play' | t | escape }}">
    {% endif %}
    <section{% if lx_scroll_url != blank %} data-scroll-stage{% endif %} class="lx-hero lx-background-hero{% if lx_campaign_image != blank %} lx-campaign-hero{% endif %}{% if lx_scroll_url != blank %} lx-scroll-hero{% endif %}" aria-labelledby="lx-hero-title"{% if lx_campaign_image != blank %} style="--lx-campaign-focus: {{ lx_campaign_image.presentation.focal_point | default: '50% 40%' }}; --lx-campaign-mobile-x: {{ section.settings.hero_campaign_mobile_focus | default: 65 }}%;"{% endif %}>
      {% if lx_campaign_image != blank %}
        <div class="lx-campaign-hero__media" aria-hidden="true">
          {%- comment -%}23.11.2026 (Besitzer «titelbild lädt immernoch langsam»): Auf dem Handy zeigt das Standbild das erste Bild des Handy-Videos, damit beim Videostart keine andere Szene einspringt. Gleiche Medienabfrage wie «mobile» in luxe-scroll-hero.js, nur ohne «reduzierte Bewegung» (dort läuft kein Video, also bleibt der scharfe Torbogen). Rückbau: Sicherungen in dropship/titelbild-handy-2311 zurückspielen.{%- endcomment -%}
          {%- if lx_campaign_mobile_still != blank -%}<picture><source media="(max-width: 760px) and (prefers-reduced-motion: no-preference), (max-width: 1000px) and (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference)" srcset="{{ lx_campaign_mobile_still | image_url: width: lx_campaign_mobile_still.width }} {{ lx_campaign_mobile_still.width }}w" sizes="100vw" width="{{ lx_campaign_mobile_still.width }}" height="{{ lx_campaign_mobile_still.height }}">{%- endif -%}
          {{ lx_campaign_image | image_url: width: 3504 | image_tag: widths: '540, 750, 960, 1200, 1600', sizes: '(min-width: 1600px) calc(100vw - 96px), (min-width: 1051px) 94vw, (min-width: 761px) 1230px, 960px', loading: 'eager', fetchpriority: 'high', decoding: 'async', alt: '', style: 'object-position: var(--lx-campaign-object-position);' }}{%- if lx_campaign_mobile_still != blank -%}</picture>{%- endif %}
          {% if lx_scroll_url != blank %}
            <video class="lx-scroll-hero__video" data-scroll-video
              data-src="{{ lx_scroll_url | escape }}"
              {% if lx_scroll_mobile_url != blank %}data-src-mobile="{{ lx_scroll_mobile_url | escape }}"{% endif %}
              width="{{ lx_scroll_width }}" height="{{ lx_scroll_height }}"
              {% if lx_campaign_mobile_still == blank %}poster="{{ lx_campaign_image | image_url: width: 1600 }}"{% endif %}
              muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>
          {% endif %}
        </div>
      {% else %}
      <div class="lx-background-hero-media" data-hero-media>
        <img src="https://cdn.shopify.com/s/files/1/0943/6856/3585/files/luxe-hero-wand-0811-poster.jpg?v=1794177208" width="1296" height="1800" loading="eager" fetchpriority="high" alt="{{ 'luxe_home.hero.video_description' | t | escape }}">
        <video muted playsinline loop preload="none" data-hero-video data-src="https://cdn.shopify.com/s/files/1/0943/6856/3585/files/luxe-hero-wand-0811.mp4?v=1794177202" poster="https://cdn.shopify.com/s/files/1/0943/6856/3585/files/luxe-hero-wand-0811-poster.jpg?v=1794177208" aria-hidden="true" tabindex="-1"></video>
        <button type="button" class="lx-hero-video-control" data-hero-toggle data-play-label="{{ 'luxe_home.hero.play' | t | escape }}" data-pause-label="{{ 'luxe_home.hero.pause' | t | escape }}" hidden>{{ 'luxe_home.hero.play' | t }}</button>
      </div>
      {% endif %}
      {% if lx_scroll_url != blank %}
        <div class="lx-scroll-hero__controls" data-scroll-controls hidden>
          <button type="button" data-scroll-hold>{{ 'luxe_home.hero.play' | t }}</button>
        </div>
      {% endif %}
      <div class="lx-hero-copy">
        <p class="lx-eyebrow">{{ 'luxe_home.sch_nes_f_r_deinen_alltag_14a23' | t }}</p>
        <h1 id="lx-hero-title">{{ 'luxe_home.hero.heading_first' | t }}<br><em>{{ 'luxe_home.hero.heading_second' | t }}</em></h1>
        <p class="lx-hero-description">{{ 'luxe_home.hero.description' | t }}</p>
        <div class="lx-hero-actions">
          <a class="lx-button" href="{{ pages['alle-kategorien'].url }}">{{ 'luxe_home.hero.categories' | t }} <span aria-hidden="true"><svg class="lx-arrow" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a>
          <a class="lx-text-link" href="{{ lx_design_url }}">{{ 'luxe_home.design.title' | t }} <svg class="lx-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a>
        </div>
      </div>
    </section>
    {% if lx_scroll_url != blank %}</luxe-scroll-hero>
    <script>
      /* 23.11.2026 (Besitzer «titelbild lädt immernoch langsam»): Das Titelvideo startet, sobald das Standbild geladen ist,
         statt auf luxe-scroll-hero.js zu warten (Modul, läuft erst nach dem ganzen Dokument; Handy gemessen ~4 s, Video spielte nach 7,4-8,6 s).
         Dieselben Bedingungen wie canPlay() und dieselbe Handy-Abfrage wie im Modul, zusätzlich nur, wenn der Hero im Bild ist.
         Ist das Modul schon da, tut der Starter nichts; danach übernimmt das Modul (gleiche Adresse, kein Neuladen).
         Fehler vor dem Modul: Quelle wieder weg, das Modul versucht es selbst. Kommt das Modul 10 s nach dem Start nicht, wird pausiert.
         Rückbau: Sicherungen in dropship/titelbild-handy-2311 zurückspielen. */
      (function () {
        var s = document.currentScript, root = s && s.previousElementSibling;
        if (!root || root.localName !== 'luxe-scroll-hero' || !window.matchMedia || !window.IntersectionObserver) return;
        var v = root.querySelector('[data-scroll-video]'), img = root.querySelector('.lx-campaign-hero__media img');
        if (!v || !v.dataset.src || !img) return;
        var n = navigator.connection;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(forced-colors: active)').matches ||
            (n && (n.saveData || /^(slow-)?2g$/.test(n.effectiveType || ''))) ||
            (isFinite(navigator.deviceMemory) && navigator.deviceMemory <= 2)) return;
        var modul = function () { return !!(window.customElements && customElements.get('luxe-scroll-hero')); };
        var los = function () {
          if (v.hasAttribute('src') || document.hidden || modul()) return;
