    "lux_faq": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"max-width:820px;margin:0 auto;font-size:15px;line-height:1.6;color:#333\"><h2 style=\"font-size:20px;margin:0 0 6px\">Häufige Fragen zu {{ collection.title }}</h2><p style=\"color:#666;margin:0 0 8px\">Alles rund um {{ collection.title }} bei LuxeStyle – kuratierte Auswahl, faire Preise, Lieferdatum beim Artikel und in der Kasse.</p><details style=\"border-top:1px solid #ececec;padding:11px 0\"><summary style=\"cursor:pointer;font-weight:600;list-style:none\">🚚 Wie lange dauert der Versand in die Schweiz?</summary><p style=\"margin:8px 0 0;color:#555\">Ab Schweizer Lager meist 2–3 Werktage, im Direktversand 10–20 Werktage; das genaue Datum steht beim Artikel und in der Kasse — immer mit Sendungsverfolgung. Gratis-Versand ab CHF 50 nach Rabatt, sonst CHF 7.00.</p></details><details style=\"border-top:1px solid #ececec;padding:11px 0\"><summary style=\"cursor:pointer;font-weight:600;list-style:none\">💳 Welche Zahlungsmethoden gibt es?</summary><p style=\"margin:8px 0 0;color:#555\">TWINT, Visa, Mastercard und weitere – sicher und SSL-verschlüsselt.</p></details><details style=\"border-top:1px solid #ececec;padding:11px 0\"><summary style=\"cursor:pointer;font-weight:600;list-style:none\">↩️ Wie funktioniert die Rückgabe?</summary><p style=\"margin:8px 0 0;color:#555\">Wir gewähren ein freiwilliges 30-Tage-Rückgaberecht. Eine kurze Nachricht an info@luxestyle.ch genügt.</p></details><details style=\"border-top:1px solid #ececec;padding:11px 0\"><summary style=\"cursor:pointer;font-weight:600;list-style:none\">📏 Wie finde ich die richtige Grösse?</summary><p style=\"margin:8px 0 0;color:#555\">Bei Mode- und Schuh-Artikeln findest du eine cm-Grössentabelle direkt auf der jeweiligen Produktseite.</p></details><details style=\"border-top:1px solid #ececec;padding:11px 0\"><summary style=\"cursor:pointer;font-weight:600;list-style:none\">🇨🇭 Warum bei LuxeStyle kaufen?</summary><p style=\"margin:8px 0 0;color:#555\">Schweizer Online-Shop mit kuratierter Auswahl, fairen Preisen, sicherer Zahlung und persönlichem Support auf Deutsch.</p></details></div>",
        "section_width": "page-width",
        "padding-block-start": 28,
        "padding-block-end": 28
      }
    },
    "lux_breadcrumb": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign p_title = ''\n  assign p_url = ''\n  for link in linklists.main-menu.links\n    for sub in link.links\n      if sub.url == collection.url and p_title == ''\n        assign p_title = link.title\n        assign p_url = link.url\n      endif\n      for sub2 in sub.links\n        if sub2.url == collection.url and p_title == ''\n          assign p_title = sub.title\n          assign p_url = sub.url\n        endif\n      endfor\n    endfor\n  endfor\n-%}\n<nav aria-label=\"Breadcrumb\" style=\"max-width:var(--page-width,1200px);margin:0 auto;padding:.4rem 1.5rem 0;font-size:.95rem;font-weight:600;line-height:1.4;color:#3d2f18;display:flex;flex-wrap:wrap;gap:.3rem;align-items:center;\">\n  <a href=\"{{ routes.root_url }}\" style=\"color:#6b4f1d;font-weight:700;text-decoration:none;\">Home</a>\n  {%- if p_title != blank %}<span aria-hidden=\"true\">&rsaquo;</span>\n  <a href=\"{{ p_url }}\" style=\"color:#6b4f1d;font-weight:700;text-decoration:none;\">{{ p_title | strip }}</a>{% endif -%}\n  <span aria-hidden=\"true\">&rsaquo;</span>\n  <span aria-current=\"page\" style=\"color:#1f1a12;font-weight:700;\">{{ collection.title }}</span>\n</nav>\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[\n{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"{{ shop.url }}{{ routes.root_url }}\"}{%- if p_title != blank %},\n{\"@type\":\"ListItem\",\"position\":2,\"name\":{{ p_title | strip | json }},\"item\":\"{{ shop.url }}{{ p_url }}\"},\n{\"@type\":\"ListItem\",\"position\":3,\"name\":{{ collection.title | json }},\"item\":\"{{ shop.url }}{{ collection.url }}\"}{% else %},\n{\"@type\":\"ListItem\",\"position\":2,\"name\":{{ collection.title | json }},\"item\":\"{{ shop.url }}{{ collection.url }}\"}{% endif -%}\n]}\n</script>\n",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "lux_subchips": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign chips = ''\n  for link in linklists.main-menu.links\n    if link.url == collection.url and link.links.size > 1\n      assign chips = link.links\n    endif\n    for sub in link.links\n      if sub.url == collection.url and link.links.size > 1\n        assign chips = link.links\n      endif\n    endfor\n  endfor\n-%}\n{%- if chips != '' and chips.size > 1 -%}\n{%- assign lx_max = 7 -%}\n{%- assign lx_n = chips.size -%}\n<nav class=\"lx-tabs\" aria-label=\"Unterkategorien\">\n<style>\n.lx-tabs{max-width:min(var(--page-width,1200px),100%);width:100%;min-width:0;margin:0 auto;padding:.5rem 1.5rem .2rem;box-sizing:border-box}\n.lx-tabs__zeile{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem 1.7rem;border-bottom:1px solid #cdbd9f;padding:0 0 .1rem;margin:0;list-style:none}\n.lx-tabs a,.lx-tabs summary{font-size:.9rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;text-decoration:none;color:#2f2414;padding:.45rem 0;border-bottom:2px solid transparent;transition:color .35s ease,border-color .35s ease;display:inline-block}\n.lx-tabs a:hover{color:#1f1a12;border-bottom-color:#cdbd9f}\n.lx-tabs a[aria-current=\"page\"]{color:#1f1a12;font-weight:800;border-bottom-color:#8b7355;border-bottom-width:3px}\n.lx-tabs summary{list-style:none;cursor:pointer;color:#6b4f1d;font-weight:700}\n.lx-tabs summary::-webkit-details-marker{display:none}\n.lx-tabs summary::after{content:' ▾'}\n.lx-tabs details[open] summary::after{content:' ▴'}\n.lx-tabs__alle{list-style:none;margin:.35rem 0 .2rem;padding:.9rem 0 .5rem;columns:13.5rem;column-gap:2rem;border-bottom:1px solid #e8e1d4}\n.lx-tabs__alle li{break-inside:avoid}\n.lx-tabs__alle a{letter-spacing:.04em;text-transform:none;font-size:.88rem;display:block;padding:.3rem 0}\n@media(max-width:749px){.lx-tabs__zeile{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;gap:1.3rem}.lx-tabs__zeile>li{flex:0 0 auto}}\n</style>\n<ul class=\"lx-tabs__zeile\">\n  {%- assign lx_seen = '|' -%}{%- assign lx_shown = 0 -%}\n  {%- for ch in chips -%}\n    {%- assign lx_key = '|' | append: ch.url | append: '|' -%}\n    {%- unless lx_seen contains lx_key -%}\n      {%- assign lx_seen = lx_seen | append: ch.url | append: '|' -%}\n      {%- assign lx_shown = lx_shown | plus: 1 -%}\n      {%- if lx_shown <= lx_max or ch.url == collection.url -%}\n        <li><a href=\"{{ ch.url }}\"{% if ch.url == collection.url %} aria-current=\"page\"{% endif %}>{{ ch.title }}</a></li>\n      {%- endif -%}\n    {%- endunless -%}\n  {%- endfor -%}\n  {%- assign lx_n = lx_shown -%}\n</ul>\n{%- if lx_n > lx_max -%}\n<details class=\"lx-tabs__details\" style=\"margin:0\"><summary style=\"margin:.2rem 0 0;display:inline-block\">Alle {{ lx_n }} Kategorien</summary>\n<ul class=\"lx-tabs__alle\">\n  {%- assign lx_seen2 = '|' -%}\n  {%- for ch in chips -%}{%- assign lx_key2 = '|' | append: ch.url | append: '|' -%}{%- unless lx_seen2 contains lx_key2 -%}{%- assign lx_seen2 = lx_seen2 | append: ch.url | append: '|' -%}<li><a href=\"{{ ch.url }}\"{% if ch.url == collection.url %} aria-current=\"page\"{% endif %}>{{ ch.title }}</a></li>{%- endunless -%}{%- endfor -%}\n</ul></details>\n{%- endif -%}\n</nav>\n{%- endif -%}\n{%- liquid\n  assign lx_uf = collection.metafields.lux.unterfilter.value\n  assign lx_kopf = collection\n  if lx_uf == blank\n    assign lx_el = collection.metafields.lux.eltern.value\n    if lx_el != blank\n      assign lx_uf = lx_el.metafields.lux.unterfilter.value\n      assign lx_kopf = lx_el\n    endif\n  endif\n-%}\n{%- if lx_uf != blank and lx_uf.size > 0 -%}\n<nav class=\"lx-uf\" aria-label=\"Unterfilter {{ lx_kopf.title | escape }}\">\n<style>.lx-uf{max-width:min(var(--page-width,1200px),100%);width:100%;min-width:0;margin:0 auto;padding:.35rem 1.5rem .2rem;box-sizing:border-box}.lx-uf__zeile{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}.lx-uf__label{font-size:.9rem;font-weight:700;color:#3d2f18;white-space:nowrap}.lx-uf a{white-space:nowrap;font-size:.92rem;font-weight:600;padding:.4rem .95rem;border-radius:999px;text-decoration:none;border:1px solid #bfae8c;background:#fff;color:#2f2414;transition:background .35s ease,border-color .35s ease,color .35s ease}.lx-uf a:hover{border-color:#8b7355;color:#1f1a12}.lx-uf a[aria-current=\"page\"]{background:#8b7355;border-color:#8b7355;color:#fff;font-weight:600}@media(max-width:749px){.lx-uf__zeile{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:.3rem}.lx-uf__zeile::-webkit-scrollbar{display:none}}</style>\n  <div class=\"lx-uf__zeile\">\n    <span class=\"lx-uf__label\">{{ lx_kopf.title | escape }}:</span>\n    <a href=\"{{ lx_kopf.url }}\"{% if lx_kopf.id == collection.id %} aria-current=\"page\"{% endif %}>Alle</a>\n    {%- for f in lx_uf -%}<a href=\"{{ f.url }}\"{% if f.id == collection.id %} aria-current=\"page\"{% endif %}>{{ f.title | escape }}</a>{%- endfor -%}\n  </div>\n</nav>\n{%- endif -%}\n{%- comment -%}\n  Filterzeile (30.08.2026): native Tag-Filterung — auf Kollektionen ueber 5000\n  Produkten schaltet Shopify die Facetten hart ab (Plattform-Limit); Tags kennen kein Limit. Tag-Liste GEMESSEN\n  (productsCount je Tag) — neue Tags nur mit Zahl dahinter ergaenzen.\n{%- endcomment -%}\n{%- liquid\n  assign welt = ''\n  assign menuetitel = ''\n  for link in linklists.main-menu.links\n    if link.url == collection.url\n      assign welt = link.title\n    endif\n    for sub in link.links\n      if sub.url == collection.url and welt == ''\n        assign welt = link.title\n      endif\n      for sub2 in sub.links\n        if sub2.url == collection.url and welt == ''\n          assign welt = link.title\n        endif\n      endfor\n    endfor\n  endfor\n  for ch in chips\n    assign menuetitel = menuetitel | append: '|' | append: ch.title | downcase\n  endfor\n  comment\n    Welt-Whitelist (05.09.2026, Audit kategorie-navigation): «Jacken» auf Wohnen fuehrte zu 1 Hundejacke,\n    «Ringe» auf Elektronik zu Smartwatches mit «Monitoring» — collection.all_tags kennt keine Stueckzahl.\n    Je Welt nur die Tags, die dort etwas bedeuten; ohne erkannte Welt gilt die volle Liste.\n  endcomment\n  case welt\n    when 'Damen'\n      assign erlaubt = 'neu,damen,kleid,jacke,pullover,hemd,schuhe,sneaker,stiefel,guertel,taschen,rucksack,schmuck,uhren,sport,geschenk,ch-lager'\n    when 'Herren'\n      assign erlaubt = 'neu,herren,jacke,pullover,hemd,schuhe,sneaker,stiefel,guertel,taschen,rucksack,uhren,sport,geschenk,ch-lager'\n    when 'Schuhe'\n      assign erlaubt = 'neu,damen,herren,kinder,sneaker,stiefel,sport,ch-lager'\n    when 'Schmuck & Uhren'\n      assign erlaubt = 'neu,damen,herren,halskette,armband,ring,uhren,geschenk,ch-lager'\n    when 'Beauty & Parfüm'\n      assign erlaubt = 'neu,damen,herren,beauty,hautpflege,naegel,geschenk,ch-lager'\n    when 'Wohnen & Garten'\n      assign erlaubt = 'neu,wohnen,kueche,aufbewahrung,kissen,werkzeug,geschenk,ch-lager'\n    when 'Küche'\n      assign erlaubt = 'neu,kueche,aufbewahrung,gadget,elektronik,geschenk,ch-lager'\n    when 'Geschirr'\n      assign erlaubt = 'neu,kueche,geschenk,ch-lager'\n    when 'Technik & Gaming'\n      assign erlaubt = 'neu,elektronik,gadget,ladegeraet,gaming,auto,uhren,geschenk,ch-lager'\n    when 'Kinder & Haustier'\n      assign erlaubt = 'neu,kinder,baby,spielzeug,haustier,schuhe,geschenk,ch-lager'\n    when 'Sport & Party'\n      assign erlaubt = 'neu,sport,kostuem,halloween,damen,herren,kinder,geschenk,ch-lager'\n    when 'Herbst & Übergang'\n      assign erlaubt = 'neu,damen,herren,kinder,jacke,pullover,stiefel,ch-lager'\n    else\n      assign erlaubt = ''\n  endcase\n-%}\n{%- assign filterpaare = 'neu|✨ Neu,damen|Damen,herren|Herren,kinder|Kinder,baby|Baby,kleid|Kleider,jacke|Jacken,pullover|Pullover,hemd|Hemden,schuhe|Schuhe,sneaker|Sneaker,stiefel|Stiefel,guertel|Gürtel,taschen|Taschen,rucksack|Rucksäcke,schmuck|Schmuck,halskette|Halsketten,armband|Armbänder,ring|Ringe,uhren|Uhren,beauty|Beauty,hautpflege|Hautpflege,naegel|Nägel,elektronik|Elektronik,gadget|Gadgets,ladegeraet|Laden & Strom,gaming|Gaming,kueche|Küche,wohnen|Wohnen,aufbewahrung|Aufbewahrung,kissen|Kissen,werkzeug|Werkzeug,auto|Auto,haustier|Haustier,spielzeug|Spielzeug,sport|Sport,kostuem|Kostüme,halloween|🎃 Halloween,geschenk|Geschenkidee,ch-lager|⚡ Ab CH-Lager' | split: ',' -%}\n{%- capture fchips -%}\n  {%- for paar in filterpaare -%}\n    {%- assign teile = paar | split: '|' -%}\n    {%- assign t = teile[0] -%}\n    {%- assign tl = teile[1] | downcase | remove: '✨ ' | remove: '🎃 ' | remove: '⚡ ' -%}\n    {%- assign tl_pipe = '|' | append: tl -%}\n    {%- assign ok = true -%}\n    {%- if erlaubt != '' -%}{%- assign erl = erlaubt | split: ',' -%}{%- unless erl contains t -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}\n    {%- if menuetitel contains tl_pipe -%}{%- assign ok = false -%}{%- endif -%}\n    {%- if ok and collection.all_tags contains t -%}\n      {%- assign akt = false -%}\n      {%- if current_tags contains t -%}{%- assign akt = true -%}{%- endif -%}\n      {%- comment -%} Mehrfach-Filter (31.08.): native Tag-URLs koennen tag1+tag2 —\n        aktiver Chip entfernt NUR sich selbst, inaktiver haengt sich an die aktiven an. {%- endcomment -%}\n      {%- if akt -%}\n        {%- capture rest -%}{%- for ct in current_tags -%}{%- if ct != t -%}+{{ ct }}{%- endif -%}{%- endfor -%}{%- endcapture -%}\n        {%- assign rest = rest | remove_first: '+' -%}\n        {%- if rest == '' -%}{%- assign ziel = collection.url -%}{%- else -%}{%- assign ziel = collection.url | append: '/' | append: rest -%}{%- endif -%}\n      {%- else -%}\n        {%- capture plus -%}{%- for ct in current_tags -%}{{ ct }}+{%- endfor -%}{{ t }}{%- endcapture -%}\n        {%- assign ziel = collection.url | append: '/' | append: plus -%}\n      {%- endif -%}\n      <a href=\"{{ ziel }}\" rel=\"nofollow\" style=\"white-space:nowrap;font-size:.92rem;padding:.38rem .9rem;border-radius:999px;text-decoration:none;border:1px solid {% if akt %}#2f5a3b{% else %}#9db5a3{% endif %};{% if akt %}background:#2f5a3b;color:#fff;font-weight:700;{% else %}background:#f7faf7;color:#1f3a27;font-weight:600;{% endif %}\">{{ teile[1] }}{% if akt %} ✕{% endif %}</a>\n    {%- endif -%}\n  {%- endfor -%}\n{%- endcapture -%}\n{%- if fchips contains '<a' -%}\n<div class=\"lx-chiprow\" style=\"width:100%;max-width:min(var(--page-width,1200px),100vw);min-width:0;box-sizing:border-box;margin:0 auto;padding:.15rem 1.5rem .3rem;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;\">\n  <div class=\"lx-chipflex\" style=\"display:flex;gap:.45rem;width:max-content;align-items:center;padding-bottom:.3rem;\">\n    <span style=\"font-size:.9rem;font-weight:700;color:#3d2f18;white-space:nowrap;\">Filtern:</span>\n    {{ fchips }}\n  </div>\n</div>\n{%- endif -%}\n<style>@media (min-width:750px){.lx-chiprow{overflow:visible!important}.lx-chipflex{flex-wrap:wrap!important;width:auto!important;row-gap:.45rem!important}}</style>\n",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "lux_usp_coll": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.lx-usp{width:100%;box-sizing:border-box;max-width:var(--page-width,1200px);margin:0 auto;padding:.5rem 1.5rem}.lx-usp__reihe{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:.7rem 1.2rem;padding:.8rem 0;border-top:1px solid #ece4d6;border-bottom:1px solid #ece4d6;font-size:13px;letter-spacing:.03em;color:#2c2c2c;line-height:1.4}.lx-usp__eintrag{display:flex;align-items:center;gap:.6rem}.lx-usp__eintrag svg{flex:0 0 auto;color:#8b7355}.lx-usp__eintrag strong{font-weight:600;color:#2c2c2c}@media(max-width:749px){.lx-usp{padding:.25rem 1rem}.lx-usp__reihe{display:flex;overflow-x:auto;gap:1.4rem;padding:.55rem 0;font-size:12.5px;scrollbar-width:none;-webkit-overflow-scrolling:touch}.lx-usp__reihe::-webkit-scrollbar{display:none}.lx-usp__eintrag{flex:0 0 auto;white-space:nowrap;gap:.4rem}.lx-usp__eintrag svg{width:16px;height:16px}}</style><div class=\"lx-usp\"><div class=\"lx-usp__reihe\"><span class=\"lx-usp__eintrag\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\"/><path d=\"M15 18H9\"/><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14\"/><circle cx=\"17\" cy=\"18\" r=\"2\"/><circle cx=\"7\" cy=\"18\" r=\"2\"/></svg><span><strong>Gratis-Versand</strong> in der Schweiz ab CHF 50 nach Rabatt</span></span><span class=\"lx-usp__eintrag\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/><path d=\"M3 3v5h5\"/></svg><span><strong>30 Tage</strong> Rückgabe</span></span><span class=\"lx-usp__eintrag\"><svg viewBox=\"0 0 32 32\" width=\"20\" height=\"20\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" rx=\"4\" fill=\"#d52b1e\"/><path fill=\"#fff\" d=\"M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z\"/></svg><span><strong>Schweizer Shop</strong></span></span><span class=\"lx-usp__eintrag\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg><span><strong>Sichere Zahlung</strong> · TWINT</span></span><span class=\"lx-usp__eintrag\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"/><path d=\"M12 8v13\"/><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"/><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"/></svg><span><strong>–10 %</strong> mit WELCOME10</span></span></div></div>",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "luxe_review_assets": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<script src=\"{{ 'luxe-product-reviews.js' | asset_url }}\" defer></script>\n<style>.lx-review-badge{display:flex;align-items:center;flex-wrap:wrap;gap:5px 8px;margin:8px 0;color:inherit;font-size:12px;line-height:1.5;overflow-wrap:anywhere}.lx-review-badge[hidden]{display:none!important}.lx-review-badge .lx-review-stars{display:block;width:90px;height:18px;flex:0 0 90px}</style>",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "lux_hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- comment -%} Kopfbild fuer jede Sammlung (02.11.2026): Titel und Beschreibung vor einem Streifen aus den ersten Produktfotos der Sammlung (Reihenfolge: gut bewertete zuerst, dann Bestseller). Fuer Schuhe liegt ein von Hand gewaehltes Bild in assets/kategorie-banner-<handle>.jpg. {%- endcomment -%}\n{%- assign lx_banner_liste = 'schuhe' | split: ',' -%}\n{%- assign lx_n = 0 -%}\n{%- capture lx_bilder -%}\n  {%- if lx_banner_liste contains collection.handle -%}\n    <img src=\"{{ 'kategorie-banner-' | append: collection.handle | append: '.jpg' | asset_url }}\" alt=\"\" class=\"lx-hero__eins\" loading=\"eager\" fetchpriority=\"high\" width=\"2000\" height=\"640\">\n  {%- else -%}\n    {%- for p in collection.products limit: 12 -%}\n      {%- if lx_n < 4 and p.featured_image != blank and p.featured_image.width >= 500 -%}\n        {%- assign lx_n = lx_n | plus: 1 -%}\n        <img src=\"{{ p.featured_image | image_url: width: 640 }}\" alt=\"\" loading=\"{% if lx_n <= 2 %}eager{% else %}lazy{% endif %}\" width=\"640\" height=\"640\">\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endcapture -%}\n<style>\n.lx-hero{position:relative;overflow:hidden;isolation:isolate;background:#2c2118;color:#fff;min-height:230px;display:flex;align-items:center}\n.lx-hero__bilder{position:absolute;inset:0;display:grid;grid-template-columns:repeat(4,1fr);z-index:-2}\n.lx-hero__bilder img{width:100%;height:100%;object-fit:cover;display:block}\n.lx-hero__bilder img.lx-hero__eins{grid-column:1/-1}\n.lx-hero::before{content:\"\";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(24,17,10,.88) 0%,rgba(24,17,10,.66) 50%,rgba(24,17,10,.34) 100%)}\n.lx-hero__text{width:100%;max-width:var(--page-width,1200px);margin:0 auto;padding:2.4rem 1.5rem 2.2rem;box-sizing:border-box}\n.lx-hero h1{margin:0 0 .6rem;color:#fff!important;font-size:clamp(2.2rem,5.5vw,3.5rem);line-height:1.08;font-weight:700;letter-spacing:-.01em;text-shadow:0 2px 14px rgba(0,0,0,.45)}\n.lx-hero__beschr,.lx-hero__beschr p{color:#f4ede0!important;margin:.4rem 0 0;max-width:62rem;text-shadow:0 1px 8px rgba(0,0,0,.5)}\n.lx-hero__beschr a{color:#fff!important;text-decoration:underline}\n@media(max-width:749px){.lx-hero__bilder{grid-template-columns:repeat(2,1fr)}.lx-hero__bilder img:nth-child(n+3):not(.lx-hero__eins){display:none}.lx-hero__text{padding:1.8rem 1rem 1.6rem}}\n</style>\n<div class=\"lx-hero\">\n  <div class=\"lx-hero__bilder\" aria-hidden=\"true\">{{ lx_bilder }}</div>\n  <div class=\"lx-hero__text\">\n    <h1>{{ collection.title }}</h1>\n    {%- if collection.description != blank -%}<div class=\"lx-hero__beschr rte\">{{ collection.description }}</div>{%- endif -%}\n  </div>\n</div>\n",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "lux_breadcrumb",
    "lux_subchips",
    "lux_usp_coll",
    "lux_hero",
    "luxe_review_assets",
    "main",
    "lux_faq"
  ]
}