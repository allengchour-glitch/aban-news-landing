v=document.createElement('video');v.muted=true;v.defaultMuted=true;v.setAttribute('muted','');v.playsInline=true;v.setAttribute('playsinline','');v.loop=true;v.preload='metadata';v.setAttribute('aria-hidden','true');v.setAttribute('tabindex','-1');v.disablePictureInPicture=true;
