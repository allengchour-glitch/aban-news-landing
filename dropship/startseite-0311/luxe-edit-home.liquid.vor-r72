        <details><summary>{{ 'luxe_home.help.question_design' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'luxe_home.help.answer_design' | t }}</p><a href="{{ lx_design_url }}">{{ 'luxe_home.choices.browse' | t }}</a></div></details>
        <details><summary>{{ 'luxe_home.help.question_delivery' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'luxe_home.help.answer_delivery' | t }}</p><nav aria-label="{{ 'luxe_home.help.policies' | t | escape }}"><a href="{{ pages['versand-lieferung'].url }}">{{ 'luxe_home.versand_lieferung_25e74' | t }}</a><a href="{{ pages['rueckgabe'].url }}">{{ 'luxe_home.r_ckgabe_62237' | t }}</a></nav></div></details>
      </div>
    </section>
