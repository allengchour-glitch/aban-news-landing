    <a href="#lx-top" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z"/></svg><span>{{ 'luxe_home.mobile.start' | t }}</span></a>
    <a href="{{ pages['alle-kategorien'].url }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>{{ 'luxe_home.mobile.categories' | t }}</span></a>
    <button type="button" data-open="lx-search" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>{{ 'luxe_home.mobile.search' | t }}</span></button>
    <a href="{{ pages['merkliste'].url }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z"/></svg><span>{{ 'luxe_home.mobile.wishlist' | t }}</span></a>
    <a href="{{ routes.cart_url }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span>{{ 'luxe_home.mobile.cart' | t }}</span></a>
  </nav>
  <script>
    (() => {
      const root = document.currentScript.closest('.lx-home');
      if (!root) return;
      let frame;
      let observer;
      const update = () => {
        const height = frame && getComputedStyle(frame).display !== 'none' ? frame.getBoundingClientRect().height : 0;
        root.style.setProperty('--lx-preview-inset', `${Math.max(0, Math.ceil(height))}px`);
        {% if lx_standard_home %}document.body.style.setProperty('--lx-standard-preview-inset', `${Math.max(0, Math.ceil(height))}px`);{% endif %}
      };
      const connect = () => {
        const found = document.getElementById('PBarNextFrameWrapper');
        if (!found || frame === found) return;
        frame = found;
        observer?.disconnect();
        new ResizeObserver(update).observe(frame);
        update();
      };
      observer = new MutationObserver(connect);
      observer.observe(document.body, {childList: true, subtree: true});
      window.addEventListener('resize', update, {passive: true});
      connect();
    })();
  </script>
</div>

{% schema %}
{
  "name": "LuxeStyle – Editorial",
  "settings": [
    {
      "type": "product_list",
      "id": "more_products",
      "label": "Weitere Produkte",
      "limit": 8
    }
  ],
  "presets": [
    {
      "name": "LuxeStyle – Editorial"
    }
  ]
}
{% endschema %}


