              ]
            },
            "lux_sizeguide": {
              "type": "custom-liquid",
              "name": "Grössen-Guide-Link",
              "settings": {
                "custom_liquid": "{%- comment -%} LUX-GROESSE-MAX (13.10.2026, Kauf-Strecke Klasse 6): grösste Zahl-Grösse des Produkts. Herrenschuh bis 43 → kein\n«eine Nummer grösser» (die gibt es nicht), sondern der Link auf Herrenschuhe ab der nächsten Grösse (Filter per WebFetch geprüft:\nfilter.v.option.grösse=44 → 1'635 statt 1'823). Wächter: automation/sonderanfertigung_wache.py (herren_bis_43). {%- endcomment -%}\n{%- assign zeige = false -%}\n{%- assign lx_gmax = 0 -%}\n{%- for option in product.options_with_values -%}\n{%- assign on = option.name | downcase -%}\n{%- if on contains 'grösse' or on contains 'groesse' or on contains 'size' -%}{%- assign zeige = true -%}\n{%- for gv in option.values -%}{%- assign lx_gs = gv.name | default: gv | append: '' -%}{%- assign lx_gn = lx_gs | plus: 0 -%}{%- if lx_gn > lx_gmax and lx_gn < 60 -%}{%- assign lx_gmax = lx_gn -%}{%- endif -%}{%- endfor -%}\n{%- endif -%}\n{%- endfor -%}\n{%- assign lx_herrschuh = false -%}\n{%- if product.type == 'Herrenschuhe' -%}{%- assign lx_herrschuh = true -%}{%- elsif product.title contains 'Herren' and product.type contains 'chuh' -%}{%- assign lx_herrschuh = true -%}{%- endif -%}\n{%- assign lx_bis43 = false -%}\n{%- if lx_herrschuh and lx_gmax >= 30 and lx_gmax <= 43 -%}{%- assign lx_bis43 = true -%}{%- assign lx_gnext = lx_gmax | plus: 1 -%}{%- endif -%}\n{%- comment -%}19.10.2026 (Spähtrupp KW-3): der Bügeltransfer ist eine Folie, kein Kleidungsstück — keine Kleider-Masstabellen.{%- endcomment -%}\n{%- if product.tags contains 'buegeltransfer' -%}{%- assign zeige = false -%}{%- endif -%}\n{%- if zeige -%}\n{%- assign guide = pages['groessentabelle'].content -%}\n{%- comment -%}13.10.2026 (Prüfer B1/B2): Editor-Ware hat kein 30-Tage-Rückgaberecht (Ersatz bei Druckfehlern); Herrenschuh bis 43 kennt keine «Nummer grösser».{%- endcomment -%}\n{%- if product.description contains 'lspod-designer' -%}{%- assign guide = guide | remove: ' Und falls es doch nicht passt, hast du 30 Tage Rückgaberecht.' -%}{%- endif -%}\n{%- if lx_bis43 -%}{%- assign guide = guide | replace: ', im Zweifel eine Nummer grösser wählen.', '.' -%}{%- endif -%}\n<div id=\"lux-sizeguide\" style=\"margin:6px 0 2px;font-size:.92rem;line-height:1.45\">\n{%- if lx_bis43 -%}\n<div style=\"margin:0 0 6px;padding:8px 10px;background:#fff7e6;border-left:3px solid #e0a300;border-radius:4px;\">📏 <strong>Erhältlich bis Grösse {{ lx_gmax }}</strong>{% if product.tags contains 'cj-real' %} · asiatisch konfektioniert, fällt eher kleiner aus{% endif %} – grösser? <a href=\"{{ routes.collections_url }}/herren-schuhe?filter.v.option.gr%C3%B6sse={{ lx_gnext }}\" style=\"text-decoration:underline\">Herrenschuhe ab {{ lx_gnext }} →</a></div>\n{%- elsif product.tags contains 'cj-real' -%}\n<div style=\"margin:0 0 6px;padding:8px 10px;background:#fff7e6;border-left:3px solid #e0a300;border-radius:4px;\">📏 <strong>Diese Ware ist asiatisch konfektioniert und fällt eher kleiner aus.</strong> Im Zweifel eine Nummer grösser wählen — und 30 Tage Rückgaberecht, falls es doch nicht passt.</div>\n{%- endif -%}\n{%- if guide != blank -%}\n<details style=\"border:1px solid #ececec;border-radius:6px;padding:8px 10px;\">\n<summary style=\"cursor:pointer;font-weight:600;\">📐 Mass-Tabellen ansehen (cm)</summary>\n<div class=\"lux-sizeguide-inhalt\" style=\"overflow-x:auto;margin-top:8px;font-size:.88rem;\">{{ guide }}</div>\n</details>\n<style>#lux-sizeguide .lux-sizeguide-inhalt table{width:100%;border-collapse:collapse}#lux-sizeguide .lux-sizeguide-inhalt th,#lux-sizeguide .lux-sizeguide-inhalt td{border:1px solid #e6e6e6;padding:4px 6px;text-align:left;white-space:nowrap}#lux-sizeguide .lux-sizeguide-inhalt h1{display:none}</style>\n{%- else -%}\n📏 <a href=\"/pages/groessentabelle\" style=\"text-decoration:underline\">Grössen-Guide mit Mass-Tabellen</a>\n{%- endif -%}\n</div>\n{%- endif -%}"
              }
            },
            "lux_spezifikationen": {
              "type": "custom-liquid",
              "name": "Spezifikationen",
              "settings": {
                "custom_liquid": "{%- assign g = product.metafields['mm-google-shopping'] -%}\n{%- assign v = product.selected_or_first_available_variant -%}\n{%- assign vend = product.vendor | downcase -%}\n{%- assign zeilen = 0 -%}\n{%- comment -%} Faktenlisten aus dem Beschreibungstext (siehe lux_beschreibung) einsammeln {%- endcomment -%}\n{%- assign d = product.description -%}\n{%- assign listen = '' -%}\n{%- if d contains '<h4>Details</h4>' -%}\n  {%- assign listen = d | split: '<h4>Details</h4>' | last | split: '</ul>' | first -%}\n{%- endif -%}\n{%- assign klassen = 'ls-produktdetails,ls-feed-details,gmc-details' | split: ',' -%}\n{%- for cls in klassen -%}\n  {%- assign marker = '<div class=\"' | append: cls | append: '\">' -%}\n  {%- if d contains marker -%}\n    {%- assign inner = d | split: marker | last | split: '</div>' | first -%}\n    {%- assign listen = listen | append: inner -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign optnames = '' -%}\n{%- for option in product.options_with_values -%}{%- assign on = option.name | downcase -%}{%- assign optnames = optnames | append: '|' | append: on -%}{%- endfor -%}\n{%- assign hat_marke = false -%}{%- assign hat_material = false -%}{%- assign hat_gewicht = false -%}{%- assign gesehen = '|' -%}\n{%- capture detailrows -%}\n{%- if listen != '' -%}\n  {%- assign items = listen | split: '<li>' -%}\n  {%- for it in items -%}\n    {%- if it contains '</strong>' -%}\n      {%- assign key = it | split: '</strong>' | first | strip_html | remove: ':' | strip -%}\n      {%- assign val = it | split: '</strong>' | last | split: '</li>' | first | strip_html | strip -%}\n      {%- assign kdc = key | downcase -%}\n      {%- comment -%} 05.09.2026: Schluessel normalisieren, damit «Grössen/Grösse», «Muster/Design», «Farben/Farbe» nur EINMAL erscheinen (Audit produktseite). {%- endcomment -%}\n      {%- assign kn = kdc | replace: 'größe', 'grösse' | replace: 'grössen', 'grösse' | replace: 'farben', 'farbe' | replace: 'design', 'muster' | replace: 'materialien', 'material' | strip -%}\n      {%- assign kn_pipe = '|' | append: kn | append: '|' -%}\n      {%- if gesehen contains kn_pipe -%}{%- assign val = '' -%}{%- else -%}{%- assign gesehen = gesehen | append: kn_pipe -%}{%- endif -%}\n      {%- if val != '' and key != '' and kdc != 'versand' and kdc != 'lieferzeit' and kdc != 'lieferung' -%}\n        {%- unless optnames contains kdc -%}\n          {%- if kdc == 'marke' -%}{%- assign hat_marke = true -%}{%- endif -%}\n          {%- if kdc == 'material' -%}{%- assign hat_material = true -%}{%- endif -%}\n          {%- if kdc == 'gewicht' -%}{%- assign hat_gewicht = true -%}{%- endif -%}\n          <tr><th>{{ key }}</th><td>{{ val }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}\n        {%- endunless -%}\n      {%- endif -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endif -%}\n{%- endcapture -%}\n{%- capture rows -%}\n{%- if product.type != blank -%}<tr><th>Kategorie</th><td>{{ product.type }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- unless hat_marke or vend == blank or vend contains 'luxestyle' or vend contains 'cj' or vend contains 'fortura' or vend contains 'bigbuy' or vend contains 'aban' -%}<tr><th>Marke</th><td>{{ product.vendor }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endunless -%}\n{{ detailrows }}\n{%- for option in product.options_with_values -%}\n{%- if option.name != 'Title' -%}<tr><th>{{ option.name }}</th><td>{%- for val in option.values limit: 14 -%}{{ val }}{%- unless forloop.last %}, {% endunless -%}{%- endfor -%}{%- if option.values.size > 14 %} … (+{{ option.values.size | minus: 14 }} weitere){%- endif -%}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- endfor -%}\n{%- assign hat_groesse = false -%}{%- if optnames contains 'grösse' or optnames contains 'größe' or optnames contains 'size' or detailrows contains '<th>Grösse</th>' or detailrows contains '<th>Masse</th>' -%}{%- assign hat_groesse = true -%}{%- endif -%}\n{%- if hat_groesse == false and product.title contains ' cm' -%}{%- assign tcm = product.title | split: ' cm' | first | split: ' ' | last | strip -%}{%- assign tnum = tcm | plus: 0 -%}{%- if tnum > 0 -%}<tr><th>Masse</th><td>{{ tcm }} cm</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}{%- endif -%}\n{%- if g.material and hat_material == false -%}<tr><th>Material</th><td>{{ g.material.value }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- if v.weight > 0 and hat_gewicht == false -%}<tr><th>Gewicht</th><td>{{ v.weight | weight_with_unit: v.weight_unit }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- if g.condition -%}{%- if g.condition.value == 'new' -%}<tr><th>Zustand</th><td>Neu</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}{%- endif -%}\n{%- endcapture -%}\n{%- if zeilen > 0 -%}\n<div id=\"lux-spezi\" style=\"margin:20px 0 6px;\">\n<h3 style=\"font-size:1.05rem;font-weight:600;margin:0 0 8px;\">Spezifikationen &amp; Details</h3>\n<table style=\"width:100%;border-collapse:collapse;font-size:.92rem;line-height:1.5\">{{ rows }}</table>\n<style>#lux-spezi th{width:38%;min-width:110px;text-align:left;font-weight:500;color:#666;vertical-align:top}#lux-spezi th,#lux-spezi td{padding:7px 8px;border-bottom:1px solid #ececec}#lux-spezi tr:nth-child(odd){background:#fafafa}</style>\n</div>\n{%- endif -%}"
              }
            },
            "lux_beschreibung": {
              "type": "custom-liquid",
              "name": "Beschreibung (ohne Faktenlisten)",
              "settings": {
                "custom_liquid": "{%- comment -%}\n  luxBeschreibung (02.09.2026, Betreiber «Spezifikationen und Details in 1»): Die Importer schreiben\n  Faktenlisten in den Beschreibungstext — Fortura «<h4>Details</h4><ul>» (Marke/Farbe/Grösse/Masse/\n  Anlass/Lieferumfang), CJ «<div class=\"ls-produktdetails|ls-feed-details\"><h4>Produktdetails</h4>».\n  Sie werden hier zur LAUFZEIT aus dem Text genommen und im Block lux_spezifikationen als Zeilen\n  derselben Tabelle gezeigt. Die Produktdaten bleiben unverändert (kein Massen-Schreiber).\n{%- endcomment -%}\n{%- liquid\n  assign d = product.description\n  if d contains '<h4>Details</h4>'\n    assign rest = d | split: '<h4>Details</h4>' | last\n    assign ul = rest | split: '</ul>' | first\n    assign cut = '<h4>Details</h4>' | append: ul | append: '</ul>'\n    assign d = d | remove_first: cut\n  endif\n  if d contains '<h4>Warum bei LuxeStyle kaufen?</h4>'\n    assign rest = d | split: '<h4>Warum bei LuxeStyle kaufen?</h4>' | last\n    assign ul = rest | split: '</ul>' | first\n    assign cut = '<h4>Warum bei LuxeStyle kaufen?</h4>' | append: ul | append: '</ul>'\n    assign d = d | remove_first: cut\n  endif\n  comment\n    Versand-Kasten (02.09.2026): Die Importer stellen «<p class=\"ls-liefer\">📦 Lieferzeit …</p>» VOR den\n    Produkttext; der Block lux_delivery zeigt dieselbe Information bereits über der Beschreibung. Die\n    Kundin las also zweimal die Lieferzeit, bevor sie ein Wort über die Ware las. Zur Laufzeit entfernt.\n  endcomment\n  if d contains '<p class=\"ls-liefer\"'\n    assign rest = d | split: '<p class=\"ls-liefer\"' | last\n    assign inner = rest | split: '</p>' | first\n    assign cut = '<p class=\"ls-liefer\"' | append: inner | append: '</p>'\n    assign d = d | remove_first: cut\n  endif\n  comment\n    Trust-Kasten (02.09.2026): Die Importer haengen «🛡️ Sorglos shoppen: ✅ Geprüfte Qualität · …» plus\n    «Gratis-Versand ab CHF 50 · –10 % mit Code WELCOME10» an JEDEN Text (>10'000 aktive Produkte).\n    Der Block lux_trust zeigt dieselben Zusagen bereits ueber der Beschreibung, der Ankuendigungsbalken\n    den Code — und «Geprüfte Qualität» ist eine Ueberzusage (29.08.: geprueft werden ANGABEN, nicht die\n    Ware). Zur Laufzeit entfernt; der Importer schreibt seit 02.09. «Geprüfte Angaben» (fuer Feeds).\n  endcomment\n  if d contains '<div style=\"background:#f7faf7'\n    assign rest = d | split: '<div style=\"background:#f7faf7' | last\n    assign inner = rest | split: '</div>' | first\n    assign cut = '<div style=\"background:#f7faf7' | append: inner | append: '</div>'\n    assign d = d | remove_first: cut\n  endif\n  if d contains '<p>Gratis-Versand ab CHF 50 ·'\n    assign rest = d | split: '<p>Gratis-Versand ab CHF 50 ·' | last\n    assign inner = rest | split: '</p>' | first\n    assign cut = '<p>Gratis-Versand ab CHF 50 ·' | append: inner | append: '</p>'\n    assign d = d | remove_first: cut\n  endif\n  assign klassen = 'ls-produktdetails,ls-feed-details,gmc-details' | split: ','\n  for cls in klassen\n    assign marker = '<div class=\"' | append: cls | append: '\">'\n    if d contains marker\n      assign rest = d | split: marker | last\n      assign inner = rest | split: '</div>' | first\n      assign cut = marker | append: inner | append: '</div>'\n      assign d = d | remove_first: cut\n    endif\n  endfor\n-%}\n{%- comment -%}kosmetik-inci-bedingung{%- endcomment -%}\n{%- comment -%} 13.10.2026 (Kauf-Strecke Klasse 12c, Regel automation/data/versprechen_regel.json → kosmetik_beleg): Hautpflege, Make-up\nund Haarpflege zeigen «Geprüfte Angaben» nur, wenn der Text eine Inhaltsstoff-LISTE trägt (INCI · «Inhaltsstoffe:» · «Ingredients:» ·\n«Zutaten:»). Der Trust-Kasten der Importer ist oben schon entfernt; das hier fängt jede andere Form ab (Neuimport, Handtext). {%- endcomment -%}\n{%- if product.type == 'Hautpflege' or product.type == 'Make-up' or product.type == 'Haarpflege' -%}\n{%- unless d contains 'INCI' or d contains 'Inhaltsstoffe:' or d contains 'Ingredients:' or d contains 'Zutaten:' -%}\n{%- assign d = d | replace: '✅ Geprüfte Angaben · ', '' | replace: '✅ Geprüfte Angaben', '' | replace: 'Geprüfte Angaben · ', '' | replace: 'Geprüfte Angaben', '' -%}\n{%- endunless -%}\n{%- endif -%}\n<div class=\"rte lux-beschreibung\">{{ d }}</div>"
              }
            },
            "lux_anlass_hinweis": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{%- comment -%} LUX-ANLASS-HINWEIS (13.10.2026, Kauf-Strecke Klasse 3): Anlass-Ware OHNE Profil «CH-Lager» (Tag profil-ch-lager fehlt) zeigt in der Kasse ein Datum nach dem Anlass. Daten (Tag, Datum, Kipptag, Link) schreibt NUR automation/anlass_lieferzeit_wache.py in shop.metafields.luxe.anlass_hinweis (JSON, ausserhalb des Fensters gelöscht → kein Hinweis). Nie auf Ware mit profil-ch-lager, EU-Lager oder Druck auf Bestellung. {%- endcomment -%}\n{%- assign lx_ah = shop.metafields.luxe.anlass_hinweis.value -%}\n{%- if lx_ah and lx_ah.hinweise and lx_ah.hinweise.size > 0 -%}\n{%- assign lx_pt = closest.product.tags -%}\n{%- unless lx_pt contains 'profil-ch-lager' or lx_pt contains 'eu-lager' or lx_pt contains 'selbst-gestalten' or lx_pt contains 'printful_personalized_product' or lx_pt contains 'prodigi_personalized_product' -%}\n{%- assign lx_heute = 'now' | date: '%Y%m%d' | plus: 0 -%}\n{%- for lx_h in lx_ah.hinweise -%}\n{%- assign lx_hd = lx_h.datum | plus: 0 -%}{%- assign lx_hab = lx_h.ab | plus: 0 -%}{%- assign lx_hk = lx_h.kipptag | plus: 0 -%}{%- assign lx_hs = lx_h.schnell_bis | plus: 0 -%}\n{%- if lx_h.tag != blank and lx_pt contains lx_h.tag and lx_heute >= lx_hab and lx_heute <= lx_hd -%}\n<div class=\"lux-anlass-hinweis\" style=\"display:flex;align-items:flex-start;gap:.5rem;margin:.2rem 0 .6rem;padding:.6rem .8rem;background:#fff6e5;border:1px solid #f0d49b;border-radius:8px;font-size:.9rem;line-height:1.4;color:#6b4a0f;\">\n<span style=\"font-size:1.1rem;\" aria-hidden=\"true\">⏰</span>\n<span>{%- if lx_heute >= lx_hk -%}<strong>Kommt erst nach {{ lx_h.anlass }} ({{ lx_h.datum_text }}) an</strong> &ndash; Direktversand aus Asien.{%- else -%}<strong>Lieferung vor {{ lx_h.anlass }} ({{ lx_h.datum_text }}) nicht garantiert</strong> &ndash; Direktversand aus Asien.{%- endif -%}\n{%- if lx_h.link != blank and lx_heute <= lx_hs -%}<br><a href=\"{{ lx_h.link }}\" style=\"color:#6b4a0f;font-weight:600;text-decoration:underline;\">Rechtzeitig: {{ lx_h.anlass }} ab Schweizer Lager &rarr;</a> <span style=\"color:#8a6a2f;\">bestellt bis {{ lx_h.schnell_bis_text }}, bei dir vor {{ lx_h.anlass }}</span>{%- endif -%}\n</span>\n</div>\n{%- break -%}\n{%- endif -%}\n{%- endfor -%}\n{%- endunless -%}\n{%- endif -%}\n"
              }
            }
          },
          "block_order": [
            "lux_breadcrumb",
            "group_icgrde",
