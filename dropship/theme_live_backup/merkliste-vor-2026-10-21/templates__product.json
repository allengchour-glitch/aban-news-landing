center;\">\n  <a href=\"{{ routes.root_url }}\" style=\"color:#8a6d3b;text-decoration:none;\">Home</a>\n  {%- if bc_sub != blank %}<span aria-hidden=\"true\">&rsaquo;</span>\n  <a href=\"{{ bc_pu }}\" style=\"color:#8a6d3b;text-decoration:none;\">{{ bc_pt | strip }}</a>\n  <span aria-hidden=\"true\">&rsaquo;</span>\n  <a href=\"{{ bc_sub.url }}\" style=\"color:#8a6d3b;text-decoration:none;\">{{ bc_sub.title }}</a>\n  {%- elsif bc_dup_u != blank %}<span aria-hidden=\"true\">&rsaquo;</span>\n  <a href=\"{{ bc_dup_u }}\" style=\"color:#8a6d3b;text-decoration:none;\">{{ bc_dup_t | strip }}</a>\n  {%- elsif bc_one != blank %}<span aria-hidden=\"true\">&rsaquo;</span>\n  <a href=\"{{ bc_one.url }}\" style=\"color:#8a6d3b;text-decoration:none;\">{{ bc_one.title }}</a>{% endif -%}\n  <span aria-hidden=\"true\">&rsaquo;</span>\n  <span aria-current=\"page\" style=\"color:#999;\">{{ product.title | truncate: 42 }}</span>\n</nav>\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[\n{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"{{ shop.url }}{{ routes.root_url }}\"}\n{%- if bc_sub != blank -%}\n,{\"@type\":\"ListItem\",\"position\":2,\"name\":{{ bc_pt | strip | json }},\"item\":\"{{ shop.url }}{{ bc_pu }}\"}\n,{\"@type\":\"ListItem\",\"position\":3,\"name\":{{ bc_sub.title | json }},\"item\":\"{{ shop.url }}{{ bc_sub.url }}\"}\n,{\"@type\":\"ListItem\",\"position\":4,\"name\":{{ product.title | json }},\"item\":\"{{ shop.url }}{{ product.url }}\"}\n{%- elsif bc_dup_u != blank -%}\n,{\"@type\":\"ListItem\",\"position\":2,\"name\":{{ bc_dup_t | strip | json }},\"item\":\"{{ shop.url }}{{ bc_dup_u }}\"}\n,{\"@type\":\"ListItem\",\"position\":3,\"name\":{{ product.title | json }},\"item\":\"{{ shop.url }}{{ product.url }}\"}\n{%- elsif bc_one != blank -%}\n,{\"@type\":\"ListItem\",\"position\":2,\"name\":{{ bc_one.title | json }},\"item\":\"{{ shop.url }}{{ bc_one.url }}\"}\n,{\"@type\