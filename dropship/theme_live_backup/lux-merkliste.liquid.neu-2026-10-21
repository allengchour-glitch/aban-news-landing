<div class="lux-wishlist-wrap" style="max-width:1100px;margin:0 auto;padding:24px 16px;">
  <h1 style="margin:0 0 6px;font-size:26px;line-height:1.2;">Deine Merkliste</h1>
  <p style="margin:0 0 16px;font-size:13px;line-height:1.45;opacity:.75;">Gespeichert nur in diesem Browser auf diesem Gerät – nicht in einem Konto. Auf einem anderen Gerät oder nach dem Löschen der Browserdaten ist sie weg.</p>
  <style>.lux-wl-rm::before{content:'';position:absolute;inset:-4px;}.lux-wl-rm:focus-visible,#lux-wl-clear:focus-visible{outline:2px solid #1a1a1a;outline-offset:2px;}.lux-wl-btn{white-space:nowrap;}@media (max-width:359px){.lux-wl-btn{font-size:13px!important;padding:10px 4px!important;}}@media (max-width:640px){#lux-wl-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;}}</style>
  <div id="lux-wishlist">
    <div id="lux-wl-head" style="display:none;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap;">
      <strong id="lux-wl-count" role="status" style="font-size:16px;"></strong>
      <button type="button" id="lux-wl-clear" style="border:1px solid rgba(0,0,0,.2);background:#fff;border-radius:999px;padding:14px 18px;font-size:13px;cursor:pointer;">Alle entfernen</button>
    </div>
    <p id="lux-wl-note" role="status" style="display:none;margin:0 0 14px;padding:10px 12px;border-radius:8px;background:#f6f1e8;font-size:14px;"></p>
    <div id="lux-wl-empty" style="display:none;">
      <p style="margin:0 0 12px;">Deine Merkliste ist leer. Tippe oder klicke auf das ♡ bei einem Produkt, um es hier zu speichern.</p>
      <p style="margin:0;"><a href="/collections/neu-eingetroffen">Neuheiten ansehen</a> · <a href="/collections/hype-jetzt">Gerade im Trend</a></p>
    </div>
    <div id="lux-wl-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;"></div>
  </div>
</div>
<script>
/* Merkliste (Karten-Herz in theme.liquid schreibt die Handles nach localStorage «lux_wish»).
   18.10.2026: Handles werden geprüft (21.10.: Unicode erlaubt — es gibt Produkte mit Emoji im Handle —, nur Leer-/Steuer-/URL-Zeichen nicht), Titel nie als HTML eingesetzt, nicht mehr vorhandene Produkte
   fliegen mit Hinweis aus der Liste (vorher blieben sie stumm für immer drin), Ausverkauftes ist gekennzeichnet,
   «In den Warenkorb» für Ein-Varianten-Ware — NICHT für «Selbst gestalten»-Produkte (Tag selbst-gestalten): dort braucht
   es den Editor, der Weg führt über die Produktseite. */
(function(){
  var KEY='lux_wish', OK=/^[^\s\u0000-\u001f\u007f\/\\?#<>"'&%]{1,255}$/;
  var grid=document.getElementById('lux-wl-grid'), head=document.getElementById('lux-wl-head'),
      cnt=document.getElementById('lux-wl-count'), note=document.getElementById('lux-wl-note'),
      leer=document.getElementById('lux-wl-empty'), clr=document.getElementById('lux-wl-clear');
  function lesen(){var l;try{l=JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){l=[];}
    if(!Array.isArray(l))l=[]; var seen={}; return l.filter(function(h){if(typeof h!=='string'||!OK.test(h)||seen[h])return false;seen[h]=1;return true;});}
  function schreiben(l){try{localStorage.setItem(KEY,JSON.stringify(l));}catch(e){}try{window.dispatchEvent(new Event('lux-wish'));}catch(e){}}   /* 21.10.: Zähler im Kopf nachziehen */
  function ev(n){try{if(typeof window.clarity==='function')window.clarity('event',n);}catch(e){}}   /* nur Ereignisnamen */
  function korbMelden(){   /* Horizon-Kopf (cart-icon.js) und Schublade hören nur auf das Ereignis cart:update — ohne es bleibt die Zahl im Kopf auf 0 */
    fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(c){
      var evn=new Event('cart:update',{bubbles:true});evn.detail={resource:c,sourceId:'lux-merkliste',data:{itemCount:c.item_count}};document.dispatchEvent(evn);
    }).catch(function(){});
  }
  function el(tag,css,text){var e=document.createElement(tag);if(css)e.style.cssText=css;if(text!=null)e.textContent=text;return e;}
  function chf(c){return 'CHF '+(c/100).toFixed(2);}
  function zaehler(){var n=grid.children.length;cnt.textContent=n===1?'1 Artikel gemerkt':n+' Artikel gemerkt';
    head.style.display=n?'flex':'none';leer.style.display=n?'none':'block';}
  function karte(h,p){
    var frei=p.available!==false, d=el('div','border:1px solid rgba(0,0,0,.08);border-radius:12px;overflow:hidden;background:#fff;position:relative;display:flex;flex-direction:column;');
    d.setAttribute('data-h',h);
    var a=el('a','text-decoration:none;color:inherit;display:block;'); a.href=p.url;
    var img=(p.featured_image||'').replace(/^\/\//,'https://');
    if(img){var i=el('img','width:100%;aspect-ratio:1;object-fit:cover;'+(frei?'':'opacity:.45;'));i.alt='';i.loading='lazy';
      i.src=img+(img.indexOf('?')>-1?'&':'?')+'width=400';i.onerror=function(){this.onerror=null;this.src=img;};a.appendChild(i);}
    var t=el('div','padding:10px 12px;');t.appendChild(el('div','font-size:14px;line-height:1.35;',p.title||''));
    var pr=el('div','font-weight:600;margin-top:6px;',chf(p.price));
    if(p.compare_at_price&&p.compare_at_price>p.price){var s=el('span','font-weight:400;opacity:.55;text-decoration:line-through;margin-left:8px;',chf(p.compare_at_price));pr.appendChild(s);}
    t.appendChild(pr);
    if(!frei)t.appendChild(el('div','margin-top:6px;font-size:13px;color:#8a3b2e;','Aktuell ausverkauft'));
    a.appendChild(t);d.appendChild(a);
    var eigen=(p.tags||[]).some(function(x){return /selbst-gestalten|personalized|wunschdesign/i.test(x);});
    var v=p.variants||[], b;
    if(frei&&v.length===1&&v[0].available!==false&&!eigen){
      b=el('button','display:block;width:calc(100% - 24px);margin:auto 12px 12px;padding:10px;border:none;border-radius:8px;background:#1a1a1a;color:#fff;font-size:14px;cursor:pointer;','In den Warenkorb');
      b.type='button';
      var imKorb=false;
      b.addEventListener('click',function(){if(imKorb){location.href='/cart';return;}b.disabled=true;b.textContent='…';
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:v[0].id,quantity:1}]})})
          .then(function(r){if(!r.ok)throw 0;imKorb=true;b.disabled=false;b.textContent='✓ Im Warenkorb – ansehen';b.style.background='#2e6b3f';ev('merkliste_liste_warenkorb');korbMelden();})
          .catch(function(){b.disabled=false;b.textContent='Nicht möglich – Produktseite öffnen';b.onclick=function(){location.href=p.url;};});});
    }else{
      b=el('a','display:block;margin:auto 12px 12px;padding:10px;border:1px solid rgba(0,0,0,.2);border-radius:8px;text-align:center;text-decoration:none;color:inherit;font-size:14px;',
        frei?(eigen?'Gestalten':v.length>1?'Option wählen':'Ansehen'):'Ansehen');
      b.href=p.url;
    }
    b.className='lux-wl-btn';d.appendChild(b);
    var x=el('button','position:absolute;top:8px;right:8px;border:none;background:rgba(255,255,255,.92);border-radius:50%;width:36px;height:36px;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.15);','✕');
    x.type='button';x.className='lux-wl-rm';x.setAttribute('aria-label','Von der Merkliste entfernen');x.setAttribute('data-h',h);
    d.appendChild(x);return d;
  }
  var liste=lesen();
  ev(liste.length?'merkliste_seite_gefuellt':'merkliste_seite_leer');   /* 21.10.: Nutzung messbar, nur Ereignisname */
  if(!liste.length){zaehler();return;}
  Promise.all(liste.map(function(h){
    return fetch('/products/'+encodeURIComponent(h)+'.js').then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(p){return {h:h,p:p};}).catch(function(){return {h:h,p:null};});
  })).then(function(res){
    var weg=[];
    res.forEach(function(x){if(x.p)grid.appendChild(karte(x.h,x.p));else weg.push(x.h);});
    if(weg.length){
      var rest=lesen().filter(function(h){return weg.indexOf(h)<0;});schreiben(rest);
      note.textContent=weg.length===1?'1 Artikel gibt es nicht mehr und wurde aus deiner Merkliste entfernt.':weg.length+' Artikel gibt es nicht mehr und wurden aus deiner Merkliste entfernt.';
      note.style.display='block';
    }
    zaehler();
  });
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.lux-wl-rm');if(!b)return;
    var h=b.getAttribute('data-h'), k=b.parentElement, nx=k.nextElementSibling||k.previousElementSibling;
    ev('merkliste_liste_entfernt');schreiben(lesen().filter(function(x){return x!==h;}));
    k.remove();zaehler();
    var f=nx&&nx.querySelector('.lux-wl-rm');   /* Tastaturfokus nicht verlieren */
    if(f){f.focus();}else{leer.setAttribute('tabindex','-1');leer.focus();}
  });
  grid.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a');if(a)ev('merkliste_liste_produkt');});
  window.addEventListener('pageshow',function(e){if(e.persisted)location.reload();});   /* Zurück-Taste (bfcache): Liste neu lesen */
  window.addEventListener('storage',function(e){if(e.key===KEY||e.key===null)location.reload();});   /* anderer Tab hat die Liste geändert */
  var timer;
  clr.addEventListener('click',function(){
    if(clr.getAttribute('data-ask')!=='1'){clr.setAttribute('data-ask','1');clr.textContent='Wirklich alle entfernen?';
      timer=setTimeout(function(){clr.removeAttribute('data-ask');clr.textContent='Alle entfernen';},4000);return;}
    ev('merkliste_liste_leeren');clearTimeout(timer);clr.removeAttribute('data-ask');clr.textContent='Alle entfernen';
    schreiben([]);grid.innerHTML='';note.style.display='none';zaehler();leer.setAttribute('tabindex','-1');leer.focus();
  });
})();
</script>

