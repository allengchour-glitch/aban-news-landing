# Cloudflare Pages / Netlify-style headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; form-action 'self' https://abannews.beehiiv.com https://*.beehiiv.com https://buy.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Long-cache static assets
/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data JSON: einen Tag cachen
/data/*
  Cache-Control: public, max-age=86400

# HTML: kürzer cachen (Inhalt kann sich ändern)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Index
/
  Cache-Control: public, max-age=3600, must-revalidate
