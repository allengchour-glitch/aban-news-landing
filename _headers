# Cloudflare Pages / Netlify-style headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.paypal.com https://*.paypalobjects.com https://lmsqueezy.com https://static.cloudflareinsights.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.paypal.com https://api.coingecko.com https://lmsqueezy.com https://api.frankfurter.dev; frame-src https://*.paypal.com; form-action 'self' https://abannews.beehiiv.com https://*.beehiiv.com https://buy.stripe.com https://*.paypal.com https://*.lemonsqueezy.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Long-cache static assets
/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Öffentliche Selbstgestalten-Laufzeit. Shopify lädt den Editor als klassisches
# Cross-Origin-Script; Karten/Vorschaudaten werden per fetch gelesen.
/pod/v6/*
  ! Cross-Origin-Resource-Policy
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400, must-revalidate

# Der Dateiname trägt die Editor-Version. Nur diese unveränderliche JS-Datei darf
# ein Jahr ohne Revalidation im Cache bleiben; stabile Karten-Namen ausdrücklich nicht.
/pod/v6/lspod-designer-v6-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Data JSON: einen Tag cachen
/data/*
  Cache-Control: public, max-age=86400

# Markt-Daten ändern sich mehrmals täglich → kurz cachen (spätere Regel hat Vorrang)
/data/markets.json
  Cache-Control: public, max-age=300, must-revalidate

# HTML: kürzer cachen (Inhalt kann sich ändern)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Index
/
  Cache-Control: public, max-age=3600, must-revalidate

# Gemessener Büro-Projektstatus: kurz cachen, keine Konto- oder Kundendaten.
/buero-projektstatus.json
  Cache-Control: public, max-age=60, must-revalidate

/buero-ablaufstatus.json
  Cache-Control: public, max-age=60, must-revalidate

