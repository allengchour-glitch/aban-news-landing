    /* ls-tile-polish: rundere Kategorie-/Collection-Kacheln (wie freigegebenes Mockup), nur Radius = layout-sicher */
    .collection-card, .collection-card__content, .collection-card__image,
    .collection-card__media, .collection-card img {
      border-radius: 22px;
