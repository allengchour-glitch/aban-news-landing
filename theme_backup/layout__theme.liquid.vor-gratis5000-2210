    <script>
    (function(){
      var KEY="lx_cookie_consent_v1";
      var banner=document.getElementById("lx-cookie-banner");
      /* 14.08.2026 — dritte Schicht gegen den verdeckten Kauf-Knopf: die Kaufleiste real
         ausmessen statt 74 px zu raten, und den Banner darüber setzen. Trägt auch dort, wo
         :has() im Stylesheet fehlt (iOS < 15.4). Setzt NUR nach oben, nie nach unten. */
      /* 13.10.2026: nur anheben, wenn die Kaufleiste SICHTBAR ist (data-stuck="true") — vorher genügte ihre Existenz,
         und der Banner lag 90 px hoch über dem Hauptknopf. Ein MutationObserver auf data-stuck setzt die Höhe nach,
         wenn Horizon die Leiste ein- oder ausblendet (kein scroll-Listener). Telefon: Rand 0 statt 16 px. */
      var lxBeob=null;
      function lxBannerPlatzieren(){
        if(!banner) return;
        var leiste=document.querySelector(".sticky-add-to-cart__bar");
        var sichtbar=!!leiste&&leiste.dataset.stuck==="true";
        var h=sichtbar?Math.round(leiste.getBoundingClientRect().height):0;
        var rand=window.matchMedia("(max-width: 749px)").matches?0:16;
        banner.style.bottom=(h>0?h+(rand?16:6):rand)+"px";
        if(leiste&&!lxBeob&&window.MutationObserver){
          lxBeob=new MutationObserver(lxBannerPlatzieren);
          lxBeob.observe(leiste,{attributes:true,attributeFilter:["data-stuck"]});
        }
      }
