    <div id="lx-cookie-banner" style="display:none;position:fixed;left:16px;right:16px;max-width:560px;margin:0 auto;background:#faf7f2;color:#2c2c2c;padding:16px 20px;border:1px solid #d4b89680;border-radius:10px;box-shadow:0 8px 30px rgba(44,44,44,.18);z-index:99999;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">
