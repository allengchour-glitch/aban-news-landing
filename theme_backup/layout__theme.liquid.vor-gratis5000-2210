    /* ls-serif-headings: elegante Serif-Ueberschriften (Boutique/Premium, wie freigegebenes Mockup) — layout-sicher, reversibel */
    h1, h2, .h0, .h1, .h2,
    .hero__title, .banner__heading, .section-header__heading, .rich-text__heading {
      font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif !important;
      letter-spacing: 0 !important;
      font-weight: 700;
    }
