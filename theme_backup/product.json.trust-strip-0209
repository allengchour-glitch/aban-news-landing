                "custom_liquid": "{%- assign g = product.metafields['mm-google-shopping'] -%}\n{%- assign v = product.selected_or_first_available_variant -%}\n{%- assign vend = product.vendor | downcase -%}\n{%- assign zeilen = 0 -%}\n{%- comment -%} Faktenlisten aus dem Beschreibungstext (siehe lux_beschreibung) einsammeln {%- endcomment -%}\n{%- assign d = product.description -%}\n{%- assign listen = '' -%}\n{%- if d contains '<h4>Details</h4>' -%}\n  {%- assign listen = d | split: '<h4>Details</h4>' | last | split: '</ul>' | first -%}\n{%- endif -%}\n{%- assign klassen = 'ls-produktdetails,ls-feed-details,gmc-details' | split: ',' -%}\n{%- for cls in klassen -%}\n  {%- assign marker = '<div class=\"' | append: cls | append: '\">' -%}\n  {%- if d contains marker -%}\n    {%- assign inner = d | split: marker | last | split: '</div>' | first -%}\n    {%- assign listen = listen | append: inner -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign optnames = '' -%}\n{%- for option in product.options_with_values -%}{%- assign on = option.name | downcase -%}{%- assign optnames = optnames | append: '|' | append: on -%}{%- endfor -%}\n{%- assign hat_marke = false -%}{%- assign hat_material = false -%}\n{%- capture detailrows -%}\n{%- if listen != '' -%}\n  {%- assign items = listen | split: '<li>' -%}\n  {%- for it in items -%}\n    {%- if it contains '</strong>' -%}\n      {%- assign key = it | split: '</strong>' | first | strip_html | remove: ':' | strip -%}\n      {%- assign val = it | split: '</strong>' | last | split: '</li>' | first | strip_html | strip -%}\n      {%- assign kdc = key | downcase -%}\n      {%- if val != '' and key != '' and kdc != 'versand' and kdc != 'lieferzeit' and kdc != 'lieferung' -%}\n        {%- unless optnames contains kdc -%}\n          {%- if kdc == 'marke' -%}{%- assign hat_marke = true -%}{%- endif -%}\n          {%- if kdc == 'material' -%}{%- assign hat_material = true -%}{%- endif -%}\n          <tr><th>{{ key }}</th><td>{{ val }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}\n        {%- endunless -%}\n      {%- endif -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endif -%}\n{%- endcapture -%}\n{%- capture rows -%}\n{%- if product.type != blank -%}<tr><th>Kategorie</th><td>{{ product.type }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- unless hat_marke or vend == blank or vend contains 'luxestyle' or vend contains 'cj' or vend contains 'fortura' or vend contains 'bigbuy' or vend contains 'aban' -%}<tr><th>Marke</th><td>{{ product.vendor }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endunless -%}\n{{ detailrows }}\n{%- for option in product.options_with_values -%}\n{%- if option.name != 'Title' -%}<tr><th>{{ option.name }}</th><td>{%- for val in option.values limit: 14 -%}{{ val }}{%- unless forloop.last %}, {% endunless -%}{%- endfor -%}{%- if option.values.size > 14 %} … (+{{ option.values.size | minus: 14 }} weitere){%- endif -%}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- endfor -%}\n{%- assign hat_groesse = false -%}{%- if optnames contains 'grösse' or optnames contains 'größe' or optnames contains 'size' or detailrows contains '<th>Grösse</th>' or detailrows contains '<th>Masse</th>' -%}{%- assign hat_groesse = true -%}{%- endif -%}\n{%- if hat_groesse == false and product.title contains ' cm' -%}{%- assign tcm = product.title | split: ' cm' | first | split: ' ' | last | strip -%}{%- assign tnum = tcm | plus: 0 -%}{%- if tnum > 0 -%}<tr><th>Masse</th><td>{{ tcm }} cm</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}{%- endif -%}\n{%- if g.material and hat_material == false -%}<tr><th>Material</th><td>{{ g.material.value }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- if v.weight > 0 -%}<tr><th>Gewicht</th><td>{{ v.weight | weight_with_unit: v.weight_unit }}</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}\n{%- if g.condition -%}{%- if g.condition.value == 'new' -%}<tr><th>Zustand</th><td>Neu</td></tr>{%- assign zeilen = zeilen | plus: 1 -%}{%- endif -%}{%- endif -%}\n{%- endcapture -%}\n{%- if zeilen > 0 -%}\n<div id=\"lux-spezi\" style=\"margin:20px 0 6px;\">\n<h3 style=\"font-size:1.05rem;font-weight:600;margin:0 0 8px;\">Spezifikationen &amp; Details</h3>\n<table style=\"width:100%;border-collapse:collapse;font-size:.92rem;line-height:1.5\">{{ rows }}</table>\n<style>#lux-spezi th{width:38%;min-width:110px;text-align:left;font-weight:500;color:#666;vertical-align:top}#lux-spezi th,#lux-spezi td{padding:7px 8px;border-bottom:1px solid #ececec}#lux-spezi tr:nth-child(odd){background:#fafafa}</style>\n</div>\n{%- endif -%}"
