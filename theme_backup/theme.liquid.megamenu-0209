<script>
(function(){
  var SCHWELLE=4900; // CHF 49 in Rappen — 2026-08-31 LIVE GEMESSEN: der Automatik-Rabatt
  // «Gratis-Versand ab CHF 49» ist ACTIVE (der 65er EXPIRED). Vorher stand hier 5000 mit einem
  // Kommentar vom 09.08. — der 49er-Rabatt kam SPAETER; einem Korb mit CHF 49.90 sagte der
  // Balken «noch CHF 0.10», obwohl der Versand laengst gratis war (221 Produkte kosten genau
  // 49.00–49.90). Ein Kommentar ist ein Datum, kein Beweis — vor jeder Aenderung den Rabatt
  // LIVE abfragen. Alter Kommentar (09.08.): entsprach der TATSAECHLICH greifenden
  // Versandregel (im Profil sind 50 und 65 aktiv, Shopify nimmt die guenstigere). Mit 6500 zeigte
  // der Balken einem Kunden bei CHF 52 noch "13 Franken bis Gratis-Versand", obwohl er ihn schon hatte.
  function render(cart){
    document.querySelectorAll('.luxe-ship-bar').forEach(function(el){el.remove();});
    var anchors=document.querySelectorAll('cart-items-component, .cart-items, cart-drawer .drawer__content, #cart-drawer');
    if(!anchors.length||!cart||cart.item_count===0)return;
    var el=document.createElement('div');el.className='luxe-ship-bar';
    var ware=(cart.items_subtotal_price!=null?cart.items_subtotal_price:cart.total_price);
    // 2026-08-14: gegen den Warenwert VOR Rabatt rechnen. Der Automatik-Rabatt
    // '2+ Artikel -10%' senkte cart.total_price, sodass die Leiste bei CHF 55.00
    // Ware noch 'Noch CHF 0.50' anzeigte. Die Versandregel steht passend dazu auf
    // 45.00 = 50.00 x 0.9, damit ab CHF 50 Ware der Versand wirklich gratis ist.
    var rest=SCHWELLE-ware;
    if(rest<=0){el.innerHTML='🎉 <strong>Gratis-Versand gesichert!</strong>';}
    else{var chf=(rest/100).toFixed(2).replace('.', '.');
      el.innerHTML='🚚 Noch <strong>CHF '+chf+'</strong> bis zum Gratis-Versand'+
      '<div class="track"><div class="fill" style="width:'+Math.min(100,Math.round(ware/SCHWELLE*100))+'%"></div></div>';}
    anchors[0].parentNode.insertBefore(el,anchors[0]);
  }
