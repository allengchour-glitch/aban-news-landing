      <style id="ls-live-hero">
    /* LuxeStyle — Live-Hero (nur Startseiten-Hero #shopify-section-hero_jVaWmY).
       Dezenter Ken-Burns Slow-Zoom + sanfter Pan + fauler Licht-Sheen.
       Mobile-first, GPU-only (transform/opacity), respektiert prefers-reduced-motion.
       Eng gescopt aufs Hero → keine Nebenwirkung auf andere Sektionen. */
    @media (prefers-reduced-motion: no-preference) {
      #shopify-section-hero_jVaWmY .hero__media {
        animation: ls-kenburns 26s ease-in-out infinite alternate;
        transform-origin: 52% 46%;
        will-change: transform;
        backface-visibility: hidden;
      }
      @keyframes ls-kenburns {
        0%   { transform: scale(1)    translate3d(0, 0, 0); }
        100% { transform: scale(1.08) translate3d(-1.2%, -1%, 0); }
      }
      /* Fauler, wandernder Licht-Sheen — sehr niedrige Deckkraft, rein Position-Animation */
      #shopify-section-hero_jVaWmY .hero__media-grid::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(115deg, transparent 32%, rgba(255,255,255,0.10) 48%, rgba(255,255,255,0.02) 60%, transparent 72%);
        background-size: 220% 220%;
        mix-blend-mode: screen;
        opacity: 0.5;
        animation: ls-hero-sheen 15s ease-in-out infinite alternate;
      }
      @keyframes ls-hero-sheen {
        0%   { background-position: 0% 0%; }
        100% { background-position: 100% 100%; }
      }
      /* Premium-Gold-Aurora hinterm Hero-Banner — dezent, hinter dem Text, wie der Sheen (screen-blend, GPU-only) */
      #shopify-section-hero_jVaWmY .hero__media-grid::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(60% 55% at 22% 24%, rgba(214,184,120,0.22), transparent 66%),
          radial-gradient(58% 60% at 84% 78%, rgba(125,138,114,0.16), transparent 68%);
        mix-blend-mode: screen;
        opacity: 0.7;
        will-change: transform, opacity;
        animation: ls-hero-aurora 24s ease-in-out infinite alternate;
      }
      @keyframes ls-hero-aurora {
        0%   { transform: scale(1)    translate3d(0, 0, 0);       opacity: 0.55; }
        100% { transform: scale(1.12) translate3d(1.5%, -2%, 0);  opacity: 0.80; }
      }
    }
    /* ls-card-polish v2: KRÄFTIGER Premium-Schatten auf der AEUSSEREN Karte (nicht abgeschnitten, sichtbar) */
    .product-card, .collection-card {
      box-shadow: 0 14px 30px -12px rgba(38, 28, 12, 0.55) !important;
      border-radius: 16px;
    }
    @media (any-pointer: fine) {
      .product-card:hover, .collection-card:hover {
        box-shadow: 0 26px 48px -14px rgba(38, 28, 12, 0.62) !important;
      }
