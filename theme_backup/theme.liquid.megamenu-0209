    <script>
    (function(){
      var KEY="lx_cookie_consent_v1";
      var banner=document.getElementById("lx-cookie-banner");
      /* 14.08.2026 — dritte Schicht gegen den verdeckten Kauf-Knopf: die Kaufleiste real
         ausmessen statt 74 px zu raten, und den Banner darüber setzen. Trägt auch dort, wo
         :has() im Stylesheet fehlt (iOS < 15.4). Setzt NUR nach oben, nie nach unten. */
      function lxBannerPlatzieren(){
        if(!banner) return;
        var leiste=document.querySelector(".sticky-add-to-cart__bar");
        var h=leiste?Math.round(leiste.getBoundingClientRect().height):0;
        banner.style.bottom=(h>0?h+16:16)+"px";
      }
      if(!localStorage.getItem(KEY)){
        setTimeout(function(){lxBannerPlatzieren();banner.style.display="block"},800);
        /* Nachmessen, falls die Kaufleiste erst nach dem Banner in den DOM kommt. Bewusst KEIN
           scroll-Listener: ein getBoundingClientRect() pro Scroll-Ereignis erzwingt auf jeder
           der 31'398 Produktseiten ein Layout und ruckelt auf dem Telefon mehr, als es nützt. */
        setTimeout(lxBannerPlatzieren,2500);
        window.addEventListener("resize",lxBannerPlatzieren);
      }
      window.lxCookieAccept=function(){
        localStorage.setItem(KEY,JSON.stringify({choice:"all",date:new Date().toISOString()}));
        banner.style.display="none";
        window.dispatchEvent(new CustomEvent("lx-consent-granted"));
      };
      window.lxCookieDecline=function(){
        localStorage.setItem(KEY,JSON.stringify({choice:"necessary",date:new Date().toISOString()}));
        banner.style.display="none";
      };
      window.lxCookieReset=function(){
        localStorage.removeItem(KEY);
        location.reload();
      };
    })();
    </script>
