        "custom_liquid": "\n{% assign handles = \"viral-hits,topseller,damen-mode,premium-schmuck,elektronik-technik,kueche,schuhe,spass-elektronik,taschen,haushaltsgeraete,sonnenbrillen-alle,basteln-diy,fur-ihn,uhren,sub-haustier,sub-baby-kids,sport-outdoor,aufbewahrung-sub\" | split: \",\" %}\n<section style=\"padding:30px 0 26px;overflow:hidden;\">\n <div style=\"max-width:1200px;margin:0 auto;padding:0 1rem;display:flex;align-items:baseline;justify-content:space-between;gap:10px;\">\n  <h2 style=\"font-size:clamp(22px,3vw,30px);margin:0 0 14px;\">Entdecke LuxeStyle — quer durchs Sortiment</h2>\n  <a href=\"/collections\" style=\"font-size:14px;color:#a5814b;text-decoration:none;white-space:nowrap;\">Alle Kategorien →</a>\n </div>\n <div class=\"lux-mq\" style=\"overflow:hidden;position:relative;\">\n  <div class=\"lux-mq-track\" id=\"luxMqTrack\">\n   {% for h in handles %}{% assign coll = collections[h] %}{% for product in coll.products limit: 3 %}\n   <a href=\"{{ product.url }}\" class=\"lux-mq-card\" style=\"flex:0 0 190px;text-decoration:none;color:inherit;background:#fff;border:1px solid #eee6d8;border-radius:14px;overflow:hidden;\">\n    <div style=\"aspect-ratio:1/1;background:#f7f4ee;\">{% if product.featured_image %}<img src=\"{{ product.featured_image | image_url: width: 380 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;\">{% endif %}</div>\n    <div style=\"padding:10px 12px 12px;\">\n     <div style=\"font-size:13px;line-height:1.35;height:2.7em;overflow:hidden;\">{{ product.title | truncate: 44 }}</div>\n     <strong style=\"font-size:14.5px;\">{{ product.price | money }}</strong>\n    </div>\n   </a>\n   {% endfor %}{% endfor %}\n  </div>\n </div>\n</section>\n<style>\n.lux-mq-track{display:flex;gap:14px;width:max-content;padding:4px 1rem;animation:luxmq 70s linear infinite;}\n.lux-mq:hover .lux-mq-track, .lux-mq:active .lux-mq-track{animation-play-state:paused;}\n@keyframes luxmq{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n@media (prefers-reduced-motion: reduce){.lux-mq-track{animation:none;overflow-x:auto;}}\n</style>\n<script>\n(function(){var t=document.getElementById('luxMqTrack');if(!t)return;\n var cards=Array.prototype.slice.call(t.children);\n for(var i=cards.length-1;i>0;i--){var r=Math.floor(Math.random()*(i+1));t.appendChild(cards[r]);cards.splice(r,1);cards=Array.prototype.slice.call(t.children);}\n t.innerHTML+=t.innerHTML; \n})();\n</script>\n"
