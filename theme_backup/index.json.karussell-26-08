    "collection_list_hREdj9": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"catrot\" style=\"width:100%;max-width:1200px;margin:0 auto;padding:8px 1rem 4px;\">\n  <h2 style=\"font-size:clamp(22px,3.5vw,32px);margin:0 0 16px;\">Shop nach Kategorie</h2>\n  {% assign cats = \"damen-mode|Damen-Mode,fur-ihn|Herren-Mode,schuhe|Schuhe,premium-schmuck|Schmuck,uhren|Uhren,beauty-pflege|Beauty,parfum-duefte|Parfum,halloween|Halloween 🎃,sub-kueche|Küche,garten-balkon|Garten,beleuchtung-lampen|Beleuchtung,sub-haustier|Haustier,spielzeug|Spielzeug,fitness-training|Fitness,wohnen-dekoration|Wohnen,blitzversand-schweiz|🇨🇭 CH-Lager · 1–2 Tage,erste-august|Schweizer Editionen 🇨🇭\" | split: \",\" %}\n  <div class=\"catrot-grid\" style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:14px;\">\n    {% for c in cats %}\n      {% assign pair = c | split: \"|\" %}\n      {% assign h = pair[0] %}\n      {% assign label = pair[1] %}\n      {% assign coll = collections[h] %}\n      {% if coll != blank and coll.products_count > 0 %}\n        <a class=\"catrot-tile\" href=\"/collections/{{ h }}\" style=\"position:relative;display:block;border-radius:14px;overflow:hidden;aspect-ratio:1/1;box-shadow:0 6px 18px rgba(0,0,0,.10);text-decoration:none;background:#f3efe9;\">\n          <div class=\"catrot-imgs\" style=\"position:absolute;inset:0;\">\n            {% assign n = 0 %}\n            {% for p in coll.products limit: 4 %}\n              {% if p.featured_image %}\n                {% assign n = n | plus: 1 %}\n                <img src=\"{{ p.featured_image | image_url: width: 500 }}\" loading=\"lazy\" alt=\"{{ coll.title | escape }}\"\n                     class=\"catrot-img catrot-img-{{ n }}\"\n                     style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;animation:catfade 9s infinite;animation-delay:{{ forloop.index0 | times: 2 }}s;\">\n              {% endif %}\n            {% endfor %}\n          </div>\n          <div style=\"position:absolute;left:8px;top:8px;z-index:2;background:rgba(255,255,255,.92);border-radius:8px;padding:5px 10px;font-weight:600;font-size:15px;letter-spacing:.01em;color:#1a1a1a;\">{{ label }}</div>\n        </a>\n      {% endif %}\n    {% endfor %}\n  </div>\n</section>\n<style>\n  @keyframes catfade { 0%{opacity:0} 3%{opacity:1} 22%{opacity:1} 27%{opacity:0} 100%{opacity:0} }\n  /* Basis: erstes Bild immer sichtbar, damit nie eine Lücke entsteht */\n  .catrot-tile .catrot-img-1 { opacity:1; animation:none; }\n  .catrot-tile:hover .catrot-img { animation-play-state:paused; }\n  @media(max-width:749px){ .catrot-grid{ grid-template-columns:repeat(2,1fr) !important; } }\n</style>\n",
